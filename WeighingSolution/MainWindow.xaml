<Controls:MetroWindow
    x:Class="WeighingSolution.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
    xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:usc="clr-namespace:WeighingSolution.UserControls"
    Title="Weighbridge Solution"
    MinWidth="1024"
    MinHeight="730"
    d:DesignHeight="750"
    d:DesignWidth="1260"
    GlowBrush="Black"
    Icon="/Images/logo.png"
    ShowCloseButton="False"
    ShowIconOnTitleBar="False"
    SizeToContent="Manual"
    WindowState="Maximized"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">
    <Control.Resources>
        <converter:CompanysettingImageConverter x:Key="CompanysettingImageConverter" />
        <BitmapImage x:Key="DefaultImage" UriSource="/Images/logo.png" />
        <RoutedUICommand x:Key="CreateNewTransaction" Text="Create New Transaction" />
    </Control.Resources>
    <Control.CommandBindings>
        <CommandBinding Command="{StaticResource CreateNewTransaction}" Executed="btnCreateTransaction_Click" />
    </Control.CommandBindings>
    <Control.InputBindings>
        <KeyBinding Command="{StaticResource CreateNewTransaction}" Gesture="Control+N" />
    </Control.InputBindings>
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel
            Height="150"
            VerticalAlignment="Top"
            Background="{DynamicResource AccentColorBrush4}">
            <StackPanel HorizontalAlignment="Left" DockPanel.Dock="Top">
                <Grid Height="110" VerticalAlignment="Top">
                    <Grid.Background>
                        <ImageBrush ImageSource="/Images/bg.png" Stretch="UniformToFill" />
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Image
                        Name="imgLogo"
                        Grid.Row="0"
                        Grid.Column="0"
                        Height="85"
                        Margin="12,9,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Source="{Binding Logo, Converter={StaticResource CompanysettingImageConverter}, FallbackValue={StaticResource DefaultImage}}"
                        Stretch="Fill" />

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="350"
                        Margin="30,5,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Orientation="Vertical">
                        <TextBlock
                            Name="txtbCompanyName"
                            Margin="3,2,2,2"
                            FontSize="14"
                            FontWeight="Bold"
                            IsManipulationEnabled="True"
                            Text="{Binding CompanyName}" />
                        <TextBlock
                            Name="txtbAddress"
                            Margin="3,2,2,2"
                            HorizontalAlignment="Left"
                            Text="{Binding Address}"
                            TextWrapping="Wrap" />
                        <StackPanel
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Email}" Value="[Empty]">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Label
                                Name="lblEmail"
                                Padding="0"
                                Content="Email: "
                                FontSize="14"
                                FontWeight="Bold" />
                            <TextBlock
                                Name="txabEmail"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Bold"
                                Text="{Binding Email}" />
                        </StackPanel>




                    </StackPanel>
                </Grid>
            </StackPanel>
            <StackPanel
                Margin="0,-110,0,0"
                HorizontalAlignment="right"
                DockPanel.Dock="Top">
                <Grid>
                    <Grid Height="110" VerticalAlignment="Top">
                        <Grid.Background>
                            <ImageBrush ImageSource="/Images/bg2.png" Stretch="UniformToFill" />
                        </Grid.Background>
                    </Grid>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <StackPanel
                            Height="100"
                            Margin="0,7,2,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Name="btnamcexpire"
                                    Width="115"
                                    Height="80"
                                    Margin="10,10,10,10"
                                    VerticalAlignment="Top"
                                    BorderThickness="0"
                                    FontSize="18"
                                    Foreground="White"
                                    Style="{DynamicResource mouseoverstyle}"
                                    Visibility="Collapsed">
                                    <StackPanel>
                                        <Label x:Name="Amcdate" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="12">AMC Expire</TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button
                                    Name="btndashbord"
                                    Width="80"
                                    Height="80"
                                    Margin="10,10,10,10"
                                    VerticalAlignment="Top"
                                    BorderThickness="0"
                                    Click="btnDashbord_Click"
                                    FontSize="18"
                                    Foreground="White"
                                    Style="{DynamicResource mouseoverstyle}"
                                    Visibility="Collapsed">
                                    <StackPanel>
                                        <Image
                                            Width="40"
                                            Height="40"
                                            Source="/Images/dashboard.png" />
                                        <TextBlock FontSize="12">Dashbord</TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button
                                    Name="btnTransaction"
                                    Width="80"
                                    Height="80"
                                    Margin="10,10,10,10"
                                    VerticalAlignment="Top"
                                    BorderThickness="0"
                                    Click="btnTransaction_Click"
                                    FontSize="18"
                                    Foreground="White"
                                    Style="{DynamicResource mouseoverstyle}"
                                    Visibility="Collapsed">
                                    <StackPanel>
                                        <Image
                                            Width="40"
                                            Height="40"
                                            Source="/Images/dashboard.png" />
                                        <TextBlock FontSize="12">Transaction</TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button
                                    Name="btnDataSetup"
                                    Width="80"
                                    Height="80"
                                    Margin="10,10,10,10"
                                    HorizontalAlignment="Left"
                                    BorderThickness="0"
                                    Click="btnDataSetup_Click"
                                    FontSize="18"
                                    Foreground="White"
                                    Style="{DynamicResource mouseoverstyle}"
                                    Visibility="Collapsed">
                                    <StackPanel>
                                        <Image
                                            Width="35"
                                            Height="35"
                                            Source="/Images/datasetup.png" />
                                        <TextBlock Margin="0,3,0,0" FontSize="12">Data Setup</TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button
                                    Name="btnReports"
                                    Width="80"
                                    Height="80"
                                    Margin="10,10,10,10"
                                    HorizontalAlignment="Left"
                                    BorderThickness="0"
                                    Click="btnReports_Click"
                                    FontSize="18"
                                    Foreground="White"
                                    Style="{DynamicResource mouseoverstyle}"
                                    Visibility="Collapsed">
                                    <StackPanel>
                                        <Image
                                            Width="40"
                                            Height="40"
                                            Source="/Images/report.png" />
                                        <TextBlock FontSize="12">Reports</TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button
                                    Name="btnSettings"
                                    Width="80"
                                    Height="80"
                                    Margin="10,10,10,10"
                                    HorizontalAlignment="Left"
                                    BorderThickness="0"
                                    Click="btnSettings_Click"
                                    FontSize="18"
                                    Foreground="White"
                                    Style="{DynamicResource mouseoverstyle}"
                                    Visibility="Collapsed">
                                    <StackPanel>
                                        <Image
                                            Width="35"
                                            Height="35"
                                            Source="/Images/settings.png" />
                                        <TextBlock Margin="0,3,0,0" FontSize="12">Settings</TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button
                                    Name="btnMonitor"
                                    Width="80"
                                    Height="80"
                                    Margin="10,10,10,10"
                                    HorizontalAlignment="Left"
                                    BorderThickness="0"
                                    Click="btnMonitor_Click"
                                    FontSize="18"
                                    Foreground="White"
                                    Style="{DynamicResource mouseoverstyle}"
                                    Visibility="Collapsed">
                                    <StackPanel>
                                        <Image
                                            Width="35"
                                            Height="35"
                                            Source="/Images/settings.png" />
                                        <TextBlock Margin="0,3,0,0" FontSize="12">Monitor</TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right">
                                <TextBlock>
                                    <Hyperlink
                                        Name="hyperlinkLoggeruser"
                                        Click="hyperlinkLoggeruser_Click"
                                        TextDecorations="none">
                                        <Label
                                            Name="lblLoggedInUser"
                                            HorizontalAlignment="Right"
                                            Content="{Binding LoggedInuser}"
                                            FontSize="14"
                                            FontWeight="Bold" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock
                                    Width="100"
                                    Margin="0,7,15,0"
                                    Padding="0,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                                    <Hyperlink
                                        Name="btnLogout"
                                        Click="btnLogout_Click"
                                        TextDecorations="none">
                                        <StackPanel>
                                            <Rectangle
                                                Width="20"
                                                Height="20"
                                                Margin="-30,8,10,10"
                                                Fill="{DynamicResource BlackBrush}">
                                                <Rectangle.OpacityMask>
                                                    <VisualBrush Stretch="Uniform" Visual="{StaticResource logOutIcon}" />
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                            <Label
                                                Name="label1"
                                                Width="52"
                                                Height="28"
                                                Margin="35,-35,0,0"
                                                Content="Logout" />
                                        </StackPanel>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <StackPanel
                Height="40"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="{DynamicResource AccentColorBrush3}"
                DockPanel.Dock="Bottom">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Label Margin="5,5,0,0">Load by Ticket/Vehicle No:</Label>
                    <usc:AutoCompleteComboBox
                        x:Name="acmbTransactionID"
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="250"
                        Height="28"
                        Margin="0,5,0,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource WhiteBrush}"
                        FilterMode="Contains"
                        Foreground="{DynamicResource BlackBrush}"
                        IsTextCompletionEnabled="True"
                        ItemsSource="{Binding ActiveTxData}"
                        KeyUp="acmbTransactionID_KeyUp"
                        MinimumPopulateDelay="200"
                        MinimumPrefixLength="0"
                        SelectedItem="{Binding SelectedTx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Text="{Binding TxSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ValueMemberPath="TransactionTitle">
                        <usc:AutoCompleteComboBox.ItemTemplate>
                            <DataTemplate>
                                <Label Content="{Binding TransactionTitle}" />
                            </DataTemplate>
                        </usc:AutoCompleteComboBox.ItemTemplate>
                    </usc:AutoCompleteComboBox>
                    <!--<ComboBox Name="acmbTransactionID" IsTextSearchEnabled="True" IsEditable="True" Grid.Row="0" Width="150" Grid.Column="1" Height="28" VerticalAlignment="Top" Margin="0,5,0,0"
                              ItemsSource="{Binding ActiveTxData}" SelectedValuePath="ReceiptTicketID" DisplayMemberPath="TransactionTitle"></ComboBox>-->
                    <Button
                        Name="btnEditTransaction"
                        Grid.Row="1"
                        Grid.Column="2"
                        Width="30"
                        Height="28"
                        Margin="0,0,0,0"
                        VerticalAlignment="Bottom"
                        Controls:ButtonHelper.PreserveTextCase="True"
                        BorderBrush="{DynamicResource AccentColorBrush3}"
                        Click="btnEditTransaction_Click"
                        Style="{DynamicResource mouseoverstyle}">
                        <iconPacks:PackIconFontAwesome
                            Width="14"
                            Height="14"
                            Margin="0,2,0,0"
                            Kind="search" />
                    </Button>
                    <Rectangle
                        Name="rectang"
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="2"
                        Height="20"
                        Margin="10,10,10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="{DynamicResource AccentColorBrush}"
                        Visibility="Collapsed" />
                    <Button
                        Name="btnCreateTransaction"
                        Grid.Row="1"
                        Grid.Column="2"
                        Height="28"
                        Margin="0,0,0,0"
                        Padding="7,2,7,2"
                        VerticalAlignment="Bottom"
                        Controls:ButtonHelper.PreserveTextCase="True"
                        BorderBrush="{DynamicResource AccentColorBrush3}"
                        Click="btnCreateTransaction_Click"
                        Style="{DynamicResource mouseoverstyle}"
                        Visibility="Collapsed">
                        <TextBlock>
                            <Run FontWeight="Normal" Text="New" />
                            <Run FontSize="9" Text="[Ctrl + N]" />
                        </TextBlock>
                    </Button>
                </StackPanel>
                <!--<StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-25,10,0">
                -->
                <!--  Amc Expire section  -->
                <!--
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Label Name="lblamcdate"  FontWeight="Bold" FontSize="18" Content="Amc Expire: " Padding="0" />
                        <TextBlock Name="txamcdate" FontWeight="Bold"  FontSize="18" VerticalAlignment="Center"  />
                    </StackPanel>
                    <Button Content="Download User Manual" Controls:ButtonHelper.PreserveTextCase="True" Name="btnCreatepdfDownload" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="0,-3,10,0" Visibility="Collapsed" Click="btnCreatepdfDownload_Click"></Button>
                    <Button Content="Create Support Ticket"  Controls:ButtonHelper.PreserveTextCase="True" Name="btnCreateSupportTicket" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="0,-3,10,0" Click="BtnCreateSupportTicket_Click"></Button>

                    <Label Name="lblSupportCall" FontWeight="Medium" FontSize="16" Content="Support Call: " Padding="0" ></Label>
                    <TextBlock Name="txabPhoneNo" FontWeight="Medium" FontSize="16" Padding="0" Text="{Binding Phone}"></TextBlock>


                </StackPanel>-->
                <StackPanel
                    Margin="0,-25,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <!--  AMC Expire section  -->
                    <StackPanel
                        Margin="0,0,30,0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Label
                            Name="lblamcdate"
                            Padding="0"
                            Content="Amc Expire: "
                            FontSize="18"
                            FontWeight="Bold" />
                        <TextBlock
                            Name="txamcdate"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold" />
                    </StackPanel>

                    <Button
                        Name="btnCreatepdfDownload"
                        Height="30"
                        Margin="0,-3,10,0"
                        Controls:ButtonHelper.PreserveTextCase="True"
                        BorderBrush="{DynamicResource AccentColorBrush}"
                        Click="btnCreatepdfDownload_Click"
                        Content="Download User Manual"
                        Style="{DynamicResource mouseoverstyle}"
                        Visibility="Collapsed" />

                    <Button
                        Name="btnResetTransaction"
                        Width="120"
                        Height="29"
                        Margin="-200,-1,0,0"
                        Padding="7,2,7,2"
                        Controls:ButtonHelper.PreserveTextCase="True"
                        Background="Red"
                        Click="btnResetTransaction_Click"
                        Style="{DynamicResource mouseoverstyle}"
                        Visibility="Collapsed">
                        <TextBlock>
                            <Run
                                FontSize="12"
                                FontWeight="Bold"
                                Text="Reset Cycle" />
                        </TextBlock>
                    </Button>
                    <Button
                        Name="btnCreateSupportTicket"
                        Height="30"
                        Margin="0,-3,10,0"
                        Controls:ButtonHelper.PreserveTextCase="True"
                        BorderBrush="{DynamicResource AccentColorBrush}"
                        Click="BtnCreateSupportTicket_Click"
                        Content="Create Support Ticket"
                        Style="{DynamicResource mouseoverstyle}" />

                    <Label
                        Name="lblSupportCall"
                        Padding="0"
                        Content="Support Call: "
                        FontSize="16"
                        FontWeight="Medium" />
                    <TextBlock
                        Name="txabPhoneNo"
                        Padding="0"
                        FontSize="16"
                        FontWeight="Medium"
                        Text="{Binding Phone}" />
                </StackPanel>

            </StackPanel>
        </DockPanel>
        <StackPanel
            Name="stkEditComapnysetting"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Visibility="Collapsed">
            <Button
                Name="EditCompanySetting"
                Margin="100,-1,15,0"
                Padding="0,0,0,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Black"
                BorderThickness="0"
                Click="EditCompanySetting_Click"
                Foreground="White"
                Opacity="0.5"
                Style="{StaticResource btnEditCompanySetting}">
                <StackPanel Width="160">
                    <Image
                        Width="30"
                        Height="30"
                        Source="/Images/edited.png" />
                    <TextBlock>Edit Company Settings</TextBlock>
                </StackPanel>
            </Button>
            <Button
                Name="btnCloseEditComapnySetting"
                Width="20"
                Height="20"
                Margin="-53,0,0,0"
                Padding="2,0,2,2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="red"
                BorderThickness="0"
                Click="btnCloseEditComapnySetting_Click"
                Content="X"
                FontSize="18"
                Foreground="White"
                Style="{DynamicResource btnCloseEditComapnySetting}" />
        </StackPanel>
        <Frame
            Name="MainFrame"
            Margin="0,150,0,0"
            Background="{DynamicResource WhiteBrush}"
            ContentRendered="MainFrame_ContentRendered"
            Navigating="MainFrame_Navigating"
            NavigationUIVisibility="Hidden" />
        <StatusBar
            Height="40"
            VerticalAlignment="Bottom"
            DockPanel.Dock="Bottom">
            <StatusBarItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Margin="5,0" Text="|" />
                        <TextBlock Margin="5,0,0,0" Text="Wt = " />
                        <TextBlock
                            Name="lblWeight"
                            Margin="0,0,5,0"
                            Text="{Binding SelectedWeighBridge.FormatedData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="5,0" Text="|" />
                        <TextBlock
                            Name="lblModBusText"
                            Margin="5,0"
                            Text="{Binding ModBusText}"
                            Visibility="Collapsed" />
                        <TextBlock Margin="5,0" Text="|" />
                        <TextBlock
                            Name="lblRFIDMSGText"
                            Margin="5,0"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="Black"
                            Text="{Binding CycleMSG}"
                            Visibility="Collapsed" />
                        <TextBlock Margin="5,0" Text="|" />


                    </StackPanel>
                    <StackPanel
                        x:Name="uhfstk"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <TextBlock Margin="5,0" Text="|" />
                        <TextBlock
                            Name="lblUHFLogs"
                            Margin="5,0"
                            Text="{Binding RFIDCount}" />

                        <TextBlock Margin="5,0" Text="|" />
                        <TextBlock
                            Name="lblUHF1"
                            Margin="5,0"
                            Text="{Binding UHF1Stutas}" />
                        <TextBlock Margin="5,0" Text="|" />
                        <TextBlock
                            Name="lblRFID"
                            Margin="5,0"
                            Text="{Binding RFIDText}" />
                        <TextBlock Margin="5,0" Text="|" />
                        <TextBlock
                            Name="lblUHF2"
                            Margin="5,0"
                            Text="{Binding UHF2Stutas}" />
                        <TextBlock Margin="5,0" Text="|" />
                    </StackPanel>
                </Grid>

            </StatusBarItem>
        </StatusBar>
        <!--<StackPanel HorizontalAlignment="Stretch" Height="40" Margin="0,0,1,-4" VerticalAlignment="Bottom" Background="{DynamicResource AccentColorBrush4}" >
        </StackPanel>-->
    </Grid>
    <Controls:MetroWindow.Flyouts>
        <Controls:FlyoutsControl Name="vwFlyouts">
            <Controls:Flyout
                x:Name="flyoutContainer"
                Width="400"
                IsModal="True"
                Position="Right" />
            <Controls:Flyout
                x:Name="flyChangePassword"
                Width="400"
                IsModal="True"
                Position="Right">
                <StackPanel Margin="20">
                    <Label
                        Content="Change Password"
                        FontSize="30"
                        FontWeight="Light" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,15,0,10"
                            Orientation="Horizontal">
                            <Label>Current Password</Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <PasswordBox
                            Name="pwbCurrentPassword"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="10,15,0,10"
                            Padding="5,5,5,5"
                            csc:PasswordHelper.Attach="True"
                            csc:PasswordHelper.Password="{Binding pwbCurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,15,0,10"
                            Orientation="Horizontal">
                            <Label>New Password</Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <PasswordBox
                            Name="pwbNewPassword"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="10,15,0,10"
                            Padding="5,5,5,5"
                            csc:PasswordHelper.Attach="True"
                            csc:PasswordHelper.Password="{Binding pwbNewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,15,0,10"
                            Orientation="Horizontal">
                            <Label>Confirm Password</Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <PasswordBox
                            Name="pwbConfirmPassword"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="10,15,0,10"
                            Padding="5,5,5,5"
                            csc:PasswordHelper.Attach="True"
                            csc:PasswordHelper.Password="{Binding pwbConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid
                        Margin="0,50,0,0"
                        VerticalAlignment="Bottom"
                        DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button
                            Name="btnChangePassword"
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="120"
                            Height="33"
                            Padding="3,3,3,3"
                            VerticalAlignment="Bottom"
                            Controls:ButtonHelper.PreserveTextCase="True"
                            BorderBrush="{DynamicResource AccentColorBrush}"
                            Command="{Binding SaveCommand}"
                            Content="Change Password"
                            IsDefault="True"
                            Style="{StaticResource AccentedSquareButtonStyle}" />
                        <Button
                            Name="btnChangePasswordCancel"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="100"
                            Height="33"
                            Margin="0,0,0,0"
                            VerticalAlignment="Bottom"
                            Controls:ButtonHelper.PreserveTextCase="True"
                            BorderBrush="{DynamicResource AccentColorBrush}"
                            Click="btnChangePasswordCancel_Click"
                            Content="Cancel"
                            IsCancel="True"
                            Style="{StaticResource AccentedSquareButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Controls:Flyout>
        </Controls:FlyoutsControl>
    </Controls:MetroWindow.Flyouts>
</Controls:MetroWindow>