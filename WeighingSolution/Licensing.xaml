<Controls:MetroWindow x:Class="WeighingSolution.Licensing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="400" MinWidth="540"  Icon="/Images/logo.png" ShowIconOnTitleBar="False"
        Title="Licensing" Height="300" Width="300"  WindowStyle="SingleBorderWindow"  
        GlowBrush="Black" SizeToContent="Manual" ResizeMode="NoResize">
    <Grid Background="{DynamicResource WhiteBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="0.5*"></RowDefinition>
            <RowDefinition Height="4*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Background="{DynamicResource AccentColorBrush}" Grid.Row="1">
            <TextBlock Margin="5,5,0,0" FontWeight="Bold" Text="Application Serial No:">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="White"></Setter>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"></ColumnDefinition>
                    <ColumnDefinition Width="1.5*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="10,15,10,10" Grid.Column="0" Name="lblHardwareID"></TextBlock>
                <TextBlock Margin="10,15,10,10" Grid.Column="1">
                    <Hyperlink Name="lnkCopy" Click="lnkCopy_Click">Click Here to Copy Serial No</Hyperlink>
                </TextBlock>
            </Grid>
        </StackPanel>
        <StackPanel Background="{DynamicResource AccentColorBrush}" Grid.Row="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton Name="rdbLicenseKey" GroupName="rdbLicenseType" Checked="rdbLicenseKey_Checked" IsChecked="True" Margin="5,2,0,0"></RadioButton>
                    <TextBlock Margin="5,5,0,0" FontWeight="Bold" Text="Add your license key below:">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="White"></Setter>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" >
                    <RadioButton Name="rdbUploadFile" GroupName="rdbLicenseType" Checked="rdbUploadFile_Checked" Margin="5,2,0,0"></RadioButton>
                    <TextBlock Margin="5,5,0,0" FontWeight="Bold" Text="Upload License File:">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Foreground" Value="White"></Setter>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="4" Name="stkSignatureKey">
            <TextBox Name="txtSignatureKey" Margin="10,10,10,10" Height="190" TextWrapping="WrapWithOverflow" Grid.ColumnSpan="2">
            </TextBox>
        </StackPanel>
        <StackPanel Grid.Row="4" Name="stkLicenseFile" Visibility="Collapsed">
            <Button Name="btnUploadFile" Click="btnUploadFile_Click" Margin="10,10,10,10" Width="100">Upload License</Button>
            <TextBlock Name="lblStatus">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="Green"></Setter>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <StackPanel Grid.Row="5" Name="stkVerify">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" > 
                <Button Content="Verify License" Name="btnVarify" Click="btnVarify_Click" 
                        Controls:ButtonHelper.PreserveTextCase="True" HorizontalAlignment="Right" Width="100" Height="30" 
                        Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" 
                        Padding="5,0,5,0" Margin="0,10,10,50"></Button>
                </StackPanel>
            </Grid>
           </StackPanel>
    </Grid>
</Controls:MetroWindow>
