<Controls:MetroWindow x:Class="WeighingSolution.DBConfigureation"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
        xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
        Height="450" Width="450"  Icon="/Images/logo.png" ShowIconOnTitleBar="False" WindowStartupLocation="CenterScreen"
        Title="DataBase Configuration - Weighbridge Solution" WindowStyle="SingleBorderWindow"  ResizeMode="NoResize"
        GlowBrush="Black" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" d:DesignWidth="450" d:DesignHeight="450" SizeToContent="Manual">
    <Window.Resources>
        <converter:EqualityVisibilityConverter x:Key="EqualityVisibilityConverter" />
        <converter:InEqualityVisibilityConverter x:Key="InEqualityVisibilityConverter" />
    </Window.Resources>
    <Grid Background="{DynamicResource WhiteBrush}">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <DockPanel HorizontalAlignment="Center">
                <Image Source="/Images/database.png" Width="25" Height="25" Margin="0,3,3,0" ></Image>
                <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="Database" />
                         Settings</TextBlock>
            </DockPanel>
            <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <!--<StackPanel Orientation="Horizontal" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <RadioButton Name="rdbCreateNew" IsChecked="True" Height="30" Margin="0,0,40,0">Create New Database</RadioButton>
                    <RadioButton Name="rdbUseExisting" IsChecked="{Binding UseExistingDB, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="30">Use Existing Database</RadioButton>
                </StackPanel>-->
                <Label Grid.Row="1" Grid.Column="0" Margin="10,15,0,10">Server Name</Label>
                <ComboBox Name="cmbServers" Grid.Row="1" Grid.Column="1" Margin="0,15,10,10" SelectedValuePath="Tag" SelectedValue="{Binding ServerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="5,5,5,5">
                    <ComboBoxItem Content="Local Server" Tag="Local Server"></ComboBoxItem>
                    <ComboBoxItem Content="Network Server" Tag="Network Server"></ComboBoxItem>
                </ComboBox>
                <Label Grid.Row="2" Grid.Column="0" Visibility="{Binding ServerType, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Network Server'}" Margin="10,15,0,10">Network Address</Label>
                <TextBox Name="txtNetworkIP" Grid.Row="2" Visibility="{Binding ServerType, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Network Server'}" Text="{Binding NetworkAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,15,10,15" Padding="5,5,5,5"/>
                <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" Visibility="{Binding ServerType, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Network Server'}">e.g. 192.168.0.101\SQLExpress</TextBlock>
                <Label Grid.Row="3" Grid.Column="0" Margin="10,15,0,10" Visibility="{Binding ServerType, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Local Server'}">SQL Services</Label>
                <ComboBox Name="cmbAvilableService" Grid.Row="3" Grid.Column="1" Margin="0,15,10,10" Visibility="{Binding ServerType, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Local Server'}" SelectedValue="{Binding SelectedSQLService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding AvailableSqlServices}" Padding="5,5,5,5">
                </ComboBox>
                <Label Grid.Row="4" Grid.Column="0" Visibility="{Binding CustomCredentials, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" Margin="10,15,0,10">SQL User Name</Label>
                <TextBox Name="txtUserName" Grid.Row="4" Visibility="{Binding CustomCredentials, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" Text="{Binding SqlUserID, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,15,10,10" Padding="5,5,5,5"/>
                <Label Grid.Row="5" Grid.Column="0" Visibility="{Binding CustomCredentials, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" Margin="10,15,0,10">SQL User Password</Label>
                <PasswordBox csc:PasswordHelper.Attach="True" Grid.Row="5" Grid.Column="1" Visibility="{Binding CustomCredentials, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" Margin="0,15,10,10" Padding="5,5,5,5" csc:PasswordHelper.Password="{Binding SqlPassword,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Row="6" Grid.ColumnSpan="2">
                    <Button Content="Create/Connect DB" Name="btnCreateDB" Width="200" Command="{Binding CreateDB}" Controls:ButtonHelper.PreserveTextCase="True"  Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="0,10,10,10"></Button>
                </StackPanel>
                <!--<StackPanel Grid.Row="6" Grid.ColumnSpan="2" Visibility="{Binding UseExistingDB, Converter={StaticResource NegativeBooleanToVisibilityConverter}}">
                    <Button Content="Connect DB" Name="btnConnectDB" Width="200" Command="{Binding ConnectDB}" Controls:ButtonHelper.PreserveTextCase="True"  Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="0,10,10,10"></Button>
                </StackPanel>-->
            </Grid>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
