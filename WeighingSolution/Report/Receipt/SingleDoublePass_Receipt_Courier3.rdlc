  <DataSets>
    <DataSet Name="Data">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT TData.TicketID
	,A.CompanyName AS AccountName
	,TR.CompanyName AS TransaporterName
	,TData.Charges
        ,TData.TransactionType
	,TData.TransactionMode
	,TXD.TareTime
	,TXD.GrossTime
	,ISNULL(TXD.TareWeight, 0) AS TareWeight
	,ISNULL(TXD.GrossWeight, 0) AS GrossWeight
	,ISNULL(TXD.NetWeight, 0) AS NetWeight
	,TXD.IsTareManual
	,TXD.IsGrossManual
	,TXD.WeightUnit
	,P.ProductName
	,G.GateName
	,(D.FirstName + ' ' + D.LastName) AS DriverName
	,V.VehicleNumber
	,Field1DisplayName = (
		SELECT DisplayName
		FROM CustomField
		WHERE FieldName = 'field1'
		)
	,Field2DisplayName = (
		SELECT DisplayName
		FROM CustomField
		WHERE FieldName = 'field2'
		)
	,Field3DisplayName = (
