		)
	,Field18Value = (
		SELECT CustomValue
		FROM CustomValue
		WHERE CustomFieldID IN (
				SELECT CustomFieldID
				FROM CustomField
				WHERE FieldName = 'field18'
				)
			AND ReceiptTicketID = TData.ReceiptTicketID
		)
		,Field19Value = (
		SELECT CustomValue
		FROM CustomValue
		WHERE CustomFieldID IN (
				SELECT CustomFieldID
				FROM CustomField
				WHERE FieldName = 'field19'
				)
			AND ReceiptTicketID = TData.ReceiptTicketID
		)
	,Field20Value = (
		SELECT CustomValue
		FROM CustomValue
		WHERE CustomFieldID IN (
				SELECT CustomFieldID
				FROM CustomField
				WHERE FieldName = 'field20'
				)
			AND ReceiptTicketID = TData.ReceiptTicketID
		)

FROM TransactionData TData
LEFT JOIN Account A ON A.AccountID = TData.AccountID
INNER JOIN TransactionDetail TXD ON TData.ReceiptTicketID = TXD.ReceiptTicketID
	AND (
		(
			(
				TXD.GrossWeight IS NOT NULL
				AND TXD.GrossWeight &lt;&gt; 0
				)
			AND (
				TXD.TareWeight IS NOT NULL
				AND TXD.TareWeight &lt;&gt; 0
				)
			)
		OR (
			TData.STATUS = 'Active'
			AND (TData.TransactionMode = 'Double')
			)
		)
LEFT JOIN Product P ON P.ProductID = TXD.ProductID
LEFT JOIN Gate G ON G.GateID = TXD.GateID
LEFT JOIN Account TR ON TR.AccountID = TData.TransporterID
LEFT JOIN Vehicle V ON V.VehicleID = TData.VehicleID
LEFT JOIN Driver D ON D.DriverID = TData.DriverID
</CommandText>
