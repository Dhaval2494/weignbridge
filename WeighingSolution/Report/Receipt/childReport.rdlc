<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Transaction passes</Description>
  <Author>
  </Author>
  <PageHeight>10in</PageHeight>
  <PageWidth>8in</PageWidth>
  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Server=localhost;DataBase=Endel_weighbridge;Integrated Security=SSPI;Connect Timeout=5</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <Width>7.5in</Width>
  <TopMargin>.25in</TopMargin>
  <LeftMargin>.25in</LeftMargin>
  <RightMargin>.25in</RightMargin>
  <BottomMargin>.25in</BottomMargin>
  <DataSets>
    <DataSet Name="Data">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>SELECT TData.SequenceNo
, WB.ScaleName, ISNULL(TData.TareWeight, 0) AS TareWeight
	,TData.TareTime
	,ISNULL(TData.GrossWeight, 0) AS GrossWeight
	,TData.GrossTime
	,ISNULL(TData.NetWeight, 0) AS NetWeight
	,TData.IsTareManual
	,TData.IsGrossManual
	,TData.WeighmentType
	,TData.WeightUnit
	,P.ProductName
	,G.GateName
	,UM.UserName
	,CAST(0 AS NUMERIC(18, 2)) AS TotalNetWeight
FROM TransactionDetail TData
INNER JOIN TransactionData T ON T.ReceiptTicketID = TData.ReceiptTicketID
INNER JOIN WeightBridge WB ON WB.WeightBridgeID = TData.WeightBridgeID
INNER JOIN UserMaster UM ON UM.UserID = TData.UserID
LEFT JOIN Product P ON P.ProductID = TData.ProductID
LEFT JOIN Gate G ON G.GateID = TData.GateID
WHERE (
		(
			(
				TData.GrossWeight IS NOT NULL
				AND TData.GrossWeight &lt;&gt; 0
				)
			AND (
				TData.TareWeight IS NOT NULL
				AND TData.TareWeight &lt;&gt; 0
				)
			)
		OR (
			T.STATUS = 'Active'
			AND (
				T.TransactionMode = 'Double'
				OR (
					T.TransactionMode = 'Multi'
					AND (
						SELECT SUM(SequenceNo)
						FROM TransactionDetail TXD
						WHERE TXD.ReceiptTicketID = TData.ReceiptTicketID
						) = 0
					)
				)
			)
		)</CommandText>
      </Query>
      <Fields>
        <Field Name="SequenceNo">
          <DataField>SequenceNo</DataField>
          <rd:TypeName>System.Byte</rd:TypeName>
        </Field>
        <Field Name="ScaleName">
          <DataField>ScaleName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TareWeight">
          <DataField>TareWeight</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TareTime">
          <DataField>TareTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="GrossWeight">
          <DataField>GrossWeight</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="GrossTime">
          <DataField>GrossTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="NetWeight">
          <DataField>NetWeight</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="IsTareManual">
          <DataField>IsTareManual</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="IsGrossManual">
          <DataField>IsGrossManual</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="WeighmentType">
          <DataField>WeighmentType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WeightUnit">
          <DataField>WeightUnit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProductName">
          <DataField>ProductName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GateName">
          <DataField>GateName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="UserName">
          <DataField>UserName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalNetWeight">
          <DataField>TotalNetWeight</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
