  <PageWidth>8.5in</PageWidth>
  <DataSources>
    <DataSource Name="DS1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Server=localhost;DataBase=svt_weighbridge;Integrated Security=SSPI;Connect Timeout=5</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <Width>7.5in</Width>
  <TopMargin>.25in</TopMargin>
  <LeftMargin>.25in</LeftMargin>
  <RightMargin>.25in</RightMargin>
  <BottomMargin>.25in</BottomMargin>
  <DataSets>
    <DataSet Name="Data">
      <Query>
        <DataSourceName>DS1</DataSourceName>
        <CommandText>
          SELECT TD.TicketID
          ,A.CompanyName AS AccountName
          ,TR.CompanyName AS TransaporterName
          ,TD.Charges
	  ,TD.TransactionType
          ,TD.TransactionMode
          ,TXD.TareTime
          ,TXD.GrossTime
          ,ISNULL(TXD.TareWeight, 0) AS TareWeight
          ,ISNULL(TXD.GrossWeight, 0) AS GrossWeight
          ,ISNULL(TXD.NetWeight, 0) AS NetWeight
          ,TXD.IsTareManual
          ,TXD.IsGrossManual
          ,TXD.WeightUnit
          ,P.ProductName
          ,G.GateName
          ,(D.FirstName + ' ' + D.LastName) AS DriverName
          ,V.VehicleNumber
          ,Field1DisplayName = (
          SELECT DisplayName
          FROM CustomField
          WHERE FieldName = 'field1'
          )
          ,Field2DisplayName = (
          SELECT DisplayName
          FROM CustomField
          WHERE FieldName = 'field2'
          )
          ,Field3DisplayName = (
          SELECT DisplayName
          FROM CustomField
          WHERE FieldName = 'field3'
          )
          ,Field4DisplayName = (
          SELECT DisplayName
          FROM CustomField
          WHERE FieldName = 'field4'
          )
          ,Field5DisplayName = (
          SELECT DisplayName
          FROM CustomField
          WHERE FieldName = 'field5'
          )
          ,Field6DisplayName = (
          SELECT DisplayName
          FROM CustomField
          WHERE FieldName = 'field6'
          )
          ,Field7DisplayName = (
          SELECT DisplayName
          FROM CustomField
          WHERE FieldName = 'field7'
          )
          ,Field8DisplayName = (
          SELECT DisplayName
          FROM CustomField
          WHERE FieldName = 'field8'
          )
          ,Field1Value = (
          SELECT CustomValue
          FROM CustomValue
          WHERE CustomFieldID IN (
          SELECT CustomFieldID
          FROM CustomField
          WHERE FieldName = 'field1'
          )
          AND ReceiptTicketID = TD.ReceiptTicketID
          )
          ,Field2Value = (
          SELECT CustomValue
          FROM CustomValue
          WHERE CustomFieldID IN (
          SELECT CustomFieldID
          FROM CustomField
          WHERE FieldName = 'field2'
          )
          AND ReceiptTicketID = TD.ReceiptTicketID
          )
          ,Field3Value = (
          SELECT CustomValue
          FROM CustomValue
          WHERE CustomFieldID IN (
          SELECT CustomFieldID
          FROM CustomField
          WHERE FieldName = 'field3'
          )
          AND ReceiptTicketID = TD.ReceiptTicketID
          )
          ,Field4Value = (
          SELECT CustomValue
          FROM CustomValue
          WHERE CustomFieldID IN (
          SELECT CustomFieldID
          FROM CustomField
          WHERE FieldName = 'field4'
          )
          AND ReceiptTicketID = TD.ReceiptTicketID
          )
          ,Field5Value = (
          SELECT CustomValue
          FROM CustomValue
          WHERE CustomFieldID IN (
          SELECT CustomFieldID
          FROM CustomField
          WHERE FieldName = 'field5'
          )
          AND ReceiptTicketID = TD.ReceiptTicketID
          )
          ,Field6Value = (
          SELECT CustomValue
          FROM CustomValue
          WHERE CustomFieldID IN (
          SELECT CustomFieldID
          FROM CustomField
          WHERE FieldName = 'field6'
          )
          AND ReceiptTicketID = TD.ReceiptTicketID
          )
          ,Field7Value = (
          SELECT CustomValue
          FROM CustomValue
          WHERE CustomFieldID IN (
          SELECT CustomFieldID
          FROM CustomField
          WHERE FieldName = 'field7'
          )
          AND ReceiptTicketID = TD.ReceiptTicketID
          )
          ,Field8Value = (
          SELECT CustomValue
          FROM CustomValue
          WHERE CustomFieldID IN (
          SELECT CustomFieldID
          FROM CustomField
          WHERE FieldName = 'field8'
          )
          AND ReceiptTicketID = TD.ReceiptTicketID
          )
          FROM TransactionData TD
          LEFT JOIN Account A ON A.AccountID = TD.AccountID
          INNER JOIN TransactionDetail TXD ON TD.ReceiptTicketID = TXD.ReceiptTicketID
          AND (
          (
          (
          TXD.GrossWeight IS NOT NULL
          AND TXD.GrossWeight &lt;&gt; 0
          )
          AND (
          TXD.TareWeight IS NOT NULL
          AND TXD.TareWeight &lt;&gt; 0
          )
          )
          OR (
          TD.STATUS = 'Active'
          AND (TD.TransactionMode = 'Double')
          )
          )
          LEFT JOIN Product P ON P.ProductID = TXD.ProductID
          LEFT JOIN Gate G ON G.GateID = TXD.GateID
          LEFT JOIN Account TR ON TR.AccountID = TD.TransporterID
          LEFT JOIN Vehicle V ON V.VehicleID = TD.VehicleID
          LEFT JOIN Driver D ON D.DriverID = TD.DriverID
        </CommandText>
      </Query>
