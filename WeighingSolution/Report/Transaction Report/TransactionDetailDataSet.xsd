              <DbSource ConnectionRef="weighbridgeConnectionString (Settings)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>
                      SELECT TData.ReceiptTicketID
                      ,TData.TicketID
                      ,A.CompanyName AS AccountName
                      ,TR.CompanyName AS TransaporterName
                      ,TData.TransactionMode
                      ,TData.STATUS AS TransactionStatus
                      ,TData.Charges
                      ,TData.TransactionType
                      ,(D.FirstName + ' ' + D.LastName) AS DriverName
                      ,V.VehicleNumber
                      ,Field1Value = (
                      SELECT CustomValue
                      FROM CustomValue
                      WHERE CustomFieldID IN (
                      SELECT CustomFieldID
                      FROM CustomField
                      WHERE FieldName = 'field1'
                      )
                      AND ReceiptTicketID = TData.ReceiptTicketID
                      )
                      ,Field2Value = (
                      SELECT CustomValue
                      FROM CustomValue
                      WHERE CustomFieldID IN (
                      SELECT CustomFieldID
                      FROM CustomField
                      WHERE FieldName = 'field2'
                      )
                      AND ReceiptTicketID = TData.ReceiptTicketID
                      )
                      ,Field3Value = (
                      SELECT CustomValue
                      FROM CustomValue
                      WHERE CustomFieldID IN (
                      SELECT CustomFieldID
                      FROM CustomField
                      WHERE FieldName = 'field3'
                      )
                      AND ReceiptTicketID = TData.ReceiptTicketID
                      )
                      ,Field4Value = (
                      SELECT CustomValue
                      FROM CustomValue
                      WHERE CustomFieldID IN (
                      SELECT CustomFieldID
                      FROM CustomField
                      WHERE FieldName = 'field4'
                      )
                      AND ReceiptTicketID = TData.ReceiptTicketID
                      )
                      ,Field5Value = (
                      SELECT CustomValue
                      FROM CustomValue
                      WHERE CustomFieldID IN (
                      SELECT CustomFieldID
                      FROM CustomField
                      WHERE FieldName = 'field5'
                      )
                      AND ReceiptTicketID = TData.ReceiptTicketID
                      )
                      ,Field6Value = (
                      SELECT CustomValue
                      FROM CustomValue
                      WHERE CustomFieldID IN (
                      SELECT CustomFieldID
                      FROM CustomField
                      WHERE FieldName = 'field6'
                      )
                      AND ReceiptTicketID = TData.ReceiptTicketID
                      )
                      ,Field7Value = (
                      SELECT CustomValue
                      FROM CustomValue
                      WHERE CustomFieldID IN (
                      SELECT CustomFieldID
                      FROM CustomField
                      WHERE FieldName = 'field7'
                      )
                      AND ReceiptTicketID = TData.ReceiptTicketID
                      )
                      ,Field8Value = (
                      SELECT CustomValue
                      FROM CustomValue
                      WHERE CustomFieldID IN (
                      SELECT CustomFieldID
                      FROM CustomField
                      WHERE FieldName = 'field8'
                      )
                      AND ReceiptTicketID = TData.ReceiptTicketID
                      )
                      ,TxD.SequenceNo
                      ,ISNULL(TxD.TareWeight, 0) AS TareWeight
                      ,TxD.TareTime
                      ,TXD.IsTareManual
                      ,ISNULL(TxD.GrossWeight, 0) AS GrossWeight
                      ,TxD.GrossTime
                      ,TxD.IsGrossManual
                      ,TxD.NetWeight
                      ,TxD.WeighmentType
                      ,TxD.WeightUnit
                      ,P.ProductName
                      ,G.GateName
                      ,UM.UserName
                      ,WB.ScaleName
                      FROM TransactionData TData
                      LEFT JOIN Account A ON A.AccountID = TData.AccountID
                      LEFT JOIN Account TR ON TR.AccountID = TData.TransporterID
                      LEFT JOIN Vehicle V ON V.VehicleID = TData.VehicleID
                      LEFT JOIN Driver D ON D.DriverID = TData.DriverID
                      INNER JOIN TransactionDetail TXD ON TXD.ReceiptTicketID = TData.ReceiptTicketID
                      INNER JOIN WeightBridge WB ON WB.WeightBridgeID = TxD.WeightBridgeID
                      LEFT JOIN UserMaster UM ON UM.UserID = TxD.UserID
                      LEFT JOIN Product P ON P.ProductID = TxD.ProductID
                      LEFT JOIN Gate G ON G.GateID = TXD.GateID
                      WHERE (
                      (
                      (
                      TxD.GrossWeight IS NOT NULL
                      AND TxD.GrossWeight &lt;&gt; 0
				)
			AND (
				TxD.TareWeight IS NOT NULL
				AND TxD.TareWeight &lt;&gt; 0
				)
			)
		OR (
			TData.STATUS = 'Active'
			AND (
				TData.TransactionMode = 'Double'
				OR (
					TData.TransactionMode = 'Multi'
					AND (
						SELECT SUM(SequenceNo)
						FROM TransactionDetail TXD1
						WHERE TXD1.ReceiptTicketID = TData.ReceiptTicketID
						) = 0
					)
				)
			)
		)
	AND (
		(
			TXD.CaptureTime BETWEEN @Sdate
				AND @Edate
			)
		AND (
			@TranMode = N''
			OR TData.TransactionMode = @TranMode
			)
		AND (
			@TranStatus = N''
			OR TData.STATUS = @TranStatus
			)
		AND (
			(
				@StartTicket = N''
				OR TData.TicketID &gt;= @StartTicket
				)
			AND (
				@EndTicket = N''
				OR TData.TicketID &lt;= @EndTicket
				)
			)
		AND (
			@Acnt = 0
			OR TData.AccountID = @Acnt
			)
		AND (
			@Product = 0
			OR TXD.ProductID = @Product
			)
		AND (
			@Vehicle = 0
			OR TData.VehicleID = @Vehicle
			)
		AND (
			@field1 = N''
			OR TData.ReceiptTicketID = (
				SELECT ReceiptTicketID
				FROM CustomValue CV
				WHERE CV.CustomValue LIKE '%' + @field1 + '%'
					AND CV.ReceiptTicketID = TData.ReceiptTicketID
				)
			)
		AND (
			@field2 = N''
			OR TData.ReceiptTicketID = (
				SELECT ReceiptTicketID
				FROM CustomValue CV
				WHERE CV.CustomValue LIKE '%' + @field2 + '%'
					AND CV.ReceiptTicketID = TData.ReceiptTicketID
				)
			)
		AND (
			@field3 = N''
			OR TData.ReceiptTicketID = (
				SELECT ReceiptTicketID
				FROM CustomValue CV
				WHERE CV.CustomValue LIKE '%' + @field3 + '%'
					AND CV.ReceiptTicketID = TData.ReceiptTicketID
				)
			)
		AND (
			@field4 = N''
			OR TData.ReceiptTicketID = (
				SELECT ReceiptTicketID
				FROM CustomValue CV
				WHERE CV.CustomValue LIKE '%' + @field4 + '%'
					AND CV.ReceiptTicketID = TData.ReceiptTicketID
				)
			)
		AND (
			@field5 = N''
			OR TData.ReceiptTicketID = (
				SELECT ReceiptTicketID
				FROM CustomValue CV
				WHERE CV.CustomValue LIKE '%' + @field5 + '%'
					AND CV.ReceiptTicketID = TData.ReceiptTicketID
				)
			)
		AND (
			@field6 = N''
			OR TData.ReceiptTicketID = (
				SELECT ReceiptTicketID
				FROM CustomValue CV
				WHERE CV.CustomValue LIKE '%' + @field6 + '%'
					AND CV.ReceiptTicketID = TData.ReceiptTicketID
				)
			)
		AND (
			@field7 = N''
			OR TData.ReceiptTicketID = (
				SELECT ReceiptTicketID
				FROM CustomValue CV
				WHERE CV.CustomValue LIKE '%' + @field7 + '%'
					AND CV.ReceiptTicketID = TData.ReceiptTicketID
				)
			)
		AND (
			@field8 = N''
			OR TData.ReceiptTicketID = (
				SELECT ReceiptTicketID
				FROM CustomValue CV
				WHERE CV.CustomValue LIKE '%' + @field8 + '%'
					AND CV.ReceiptTicketID = TData.ReceiptTicketID
				)
			)
		)
ORDER BY TData.TicketID ASC
</CommandText>
