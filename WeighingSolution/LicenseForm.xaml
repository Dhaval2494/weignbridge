<Controls:MetroWindow x:Class="WeighingSolution.LicenseForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Registration"
        Icon="/Images/logo.png"
        GlowBrush="Black"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Height="500" Width="800"
        MinHeight="400" MinWidth="540"
        ShowIconOnTitleBar="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{DynamicResource WhiteBrush}" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Background="{DynamicResource AccentColorBrush}" Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="License Registration" FontSize="20" FontWeight="Bold" Foreground="White" Margin="10"/>
            </StackPanel>

            <!-- Form Content -->
            <StackPanel Grid.Row="1" Margin="10,0,10,0">
                <!-- Machine Key -->
                <TextBlock Text="Machine Key *" Margin="0,5"/>
                <TextBox Name="lblHardwareID" Margin="0,0,0,10" IsReadOnly="True" Background="#FFEFEFEF"/>

                <!-- 2 Column Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column -->
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Margin="0,5">
                                    <Run Text="Company Name"/>
                                    <Run Text=" *" Foreground="Red"/>
                        </TextBlock>
                        <TextBox Name="txtCompanyName" Margin="0,0,0,10"/>

                       
                        <TextBlock Margin="0,5">
                                     <Run Text="Contact Person Name"/>
                                     <Run Text=" *" Foreground="Red"/>
                        </TextBlock>
                        <TextBox Name="txtContactPerson" Margin="0,0,0,10"/>

                        <TextBlock Margin="0,5">
                                    <Run Text="Email"/>
                                    <Run Text=" *" Foreground="Red"/>
                        </TextBlock>
                        <TextBox Name="txtEmail" Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- Right Column -->
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Margin="0,5">
                                    <Run Text="Site Address"/>
                                    <Run Text=" *" Foreground="Red"/>
                        </TextBlock>
                        <TextBox Name="txtSiteAddress" Margin="0,0,0,10"/>

                        <TextBlock Margin="0,5">
                                    <Run Text="Software Type"/>
                                    <Run Text=" *" Foreground="Red"/>
                        </TextBlock>
                        <ComboBox Name="cmbSoftwareType" Margin="0,0,0,10">
                            <ComboBoxItem Content="Basic version"/>
                            <ComboBoxItem Content="Standard version"/>
                            <ComboBoxItem Content="Professional version"/>
                            <ComboBoxItem Content="Enterprise version"/>
                            <ComboBoxItem Content="Ultimate version"/>
                        </ComboBox>

                        <TextBlock Text="To get OTP via this number on Whatsapp."
                                         FontSize="11"
                                         Foreground="Red"
                                          />
                        <TextBlock Margin="0,5">
                                    <Run Text="Contact Number"/>
                                    <Run Text=" *" Foreground="Red"/>
                        </TextBlock>
                        <TextBox Name="txtContactNo" Margin="0,0,0,10" />
                    </StackPanel>
                </Grid>


                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Sales Person -->
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Margin="0,5">
                                    <Run Text="Sales Person"/>
                                    <Run Text=" *" Foreground="Red"/>
                        </TextBlock>
                        <TextBox Name="txtSalesPerson" Margin="0,0,0,10"/>
                    </StackPanel>
                        <!-- otp section-->
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Margin="0,5">
                                    <Run Text="OTP"/>
                                    <Run Text=" *" Foreground="Red"/>
                        </TextBlock>
                        <TextBox Name="txtOTP" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!-- Submit Button -->
            <Grid Grid.Row="2" Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Button Content="I have license key" Width="150" Height="30" Margin="10,0,10,0" 
                                x:Name="Skipbtn"
                                Click="Skipbtn_Click"
                                Style="{DynamicResource mouseoverstyle}"
                                BorderBrush="{DynamicResource AccentColorBrush}"
                                Controls:ButtonHelper.PreserveTextCase="True"
                                HorizontalAlignment="Left" />
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,10">

                    <Button Content="Get OTP" Width="100" Height="30" Margin="10,0,10,0"  x:Name="otpBTN"
                        Click=  "btnGetOTP_Click"
                        Style="{DynamicResource mouseoverstyle}"
                        Background="Green"
                        Controls:ButtonHelper.PreserveTextCase="True"/>

                    <Button Content="Submit" Width="100" Height="30" x:Name="SubmitBTN"
                        Click="btnSubmit_Click" 
                        Style="{DynamicResource mouseoverstyle}"
                        BorderBrush="{DynamicResource AccentColorBrush}" IsEnabled="False"
                        Controls:ButtonHelper.PreserveTextCase="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Controls:MetroWindow>
