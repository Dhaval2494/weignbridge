<UserControl x:Class="WeighingSolution.UserControls.Flyouts.Product"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <StackPanel Margin="20">
        <Label Content="Add Product" FontWeight="Light" FontSize="30"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,15,0,10" Orientation="Horizontal">
                <Label >Product Name</Label>
                <Label Foreground="Red">*</Label>
            </StackPanel>
            <TextBox Name ="txtProductName"  Grid.Row="0" Grid.Column="1" Margin="0,15,0,10" Text="{Binding Model.ProductName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="1" Margin="0,15,0,10">Product Code</Label>
            <TextBox Name="txtProductCode" Grid.Row="1" Grid.Column="1"   Margin="0,15,0,10" Text="{Binding Model.ProductCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  />
            <Label Grid.Row="2" Margin="0,15,0,10">Notes</Label>
            <TextBox Name="txtProductNotes" Grid.Row="2" Margin="0,15,0,10" AcceptsReturn="True" Grid.Column="1" Padding="5,8,5,20" Text="{Binding Model.Notes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            </TextBox>
        </Grid>
        <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Content="Add" IsDefault="True" Grid.Column="0" Grid.Row="0" Height="33" Style="{StaticResource AccentedSquareButtonStyle}" BorderBrush="{DynamicResource AccentColorBrush}" VerticalAlignment="Bottom" Margin="0,0,0,0" Width="100" Command="{Binding SaveCommand}"/>
            <Button Content="Cancel" IsCancel="True" Grid.Row="0" Grid.Column="1" Height="33" Style="{StaticResource AccentedSquareButtonStyle}" BorderBrush="{DynamicResource AccentColorBrush}" VerticalAlignment="Bottom" Margin="0,0,0,0" Width="100" Command="{Binding CloseDetailViewCommand}"/>
        </Grid>
    </StackPanel>
</UserControl>
