<UserControl x:Class="WeighingSolution.UserControls.Flyouts.Vehicle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <StackPanel Margin="20">
        <Label Content="Add Vehicle" FontWeight="Light" FontSize="30"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,15,0,10" Orientation="Horizontal">
                <Label >Vehicle No</Label>
                <Label Foreground="Red">*</Label>
            </StackPanel>
            <TextBox Name="txtVehicleNo" CharacterCasing="Upper" 
                     Grid.Row="0" Grid.Column="1" Margin="0,15,0,10" Padding="5,5,5,5" 
                     Text="{Binding Model.VehicleNumber,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                     LostFocus="txtVehicleNo_LostFocus" KeyDown="txtVehicleNo_KeyDown" />
            <Label Grid.Row="1" Margin="0,15,0,10">Vehicle Type</Label>
            <TextBox Name="txtVehicleType" Grid.Row="1" Grid.Column="1" Margin="0,15,0,10" Padding="5,5,5,5" Text="{Binding Model.VehicleType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="2" Margin="0,15,0,10">Account</Label>
            <ComboBox Name="cmbAccountDetail" Grid.Row="2" Margin="0,15,0,10" Grid.Column="1" Padding="5,5,5,5" ItemsSource="{Binding Accounts}" DisplayMemberPath="CompanyName" SelectedValuePath="AccountID">
                <ComboBox.SelectedValue>
                    <Binding Path="Model.AccountID" Converter="{StaticResource NullReplaceConverter}">
                        <Binding.ConverterParameter>
                            <sys:Int32>0</sys:Int32>
                        </Binding.ConverterParameter>
                    </Binding>
                </ComboBox.SelectedValue>
            </ComboBox>
            <Label Grid.Row="3" Margin="0,15,0,10">Tare Weight</Label>
            <csc:FilteredTextbox x:Name="txtTareWeight" FilterRegex="^[0-9]+$|^[0-9]*[.]{0,1}[0-9]*$" Grid.Row="3" Margin="0,15,0,10" Grid.Column="1" Padding="5,5,5,5" Text="{Binding Model.TareWeight,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
            <Label Grid.Row="4" Margin="0,15,0,10">Notes</Label>
            <TextBox Grid.Row="4" Margin="0,15,0,10"  Grid.Column="1" Padding="5,5,5,5" AcceptsReturn="True" Text="{Binding Model.Notes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Content="Add" IsDefault="True" Command="{Binding SaveCommand}" Grid.Column="0" Grid.Row="0" Height="33" Style="{StaticResource AccentedSquareButtonStyle}" BorderBrush="{DynamicResource AccentColorBrush}" VerticalAlignment="Bottom" Margin="0,0,0,0" Width="100" />
            <Button Content="Cancel" IsCancel="True" Command="{Binding CloseDetailViewCommand}" Grid.Row="0" Grid.Column="1" Height="33" Style="{StaticResource AccentedSquareButtonStyle}" BorderBrush="{DynamicResource AccentColorBrush}" VerticalAlignment="Bottom" Margin="0,0,0,0" Width="100" />
        </Grid>
    </StackPanel>
</UserControl>
