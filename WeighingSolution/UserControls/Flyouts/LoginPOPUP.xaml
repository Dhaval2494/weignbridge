<UserControl x:Class="WeighingSolution.UserControls.Flyouts.LoginPOPUP"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeighingSolution.UserControls.Flyouts"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="20">
        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" FontSize="20">Please Enter Admin Credentials </TextBlock>
        <Label Content="Login" FontWeight="Light" FontSize="30"/>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,15,0,10" Orientation="Horizontal">
                <Label>User Name</Label>
                <Label Foreground="red">*</Label>
            </StackPanel>
            <TextBox Name="txtusername"  Grid.Row="0" Grid.Column="1" Margin="0,15,0,10" Text="{Binding LoginUserName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Grid.Row="1" Margin="0,15,0,10" Orientation="Horizontal">
                <Label>Password</Label>
                <Label Foreground="Red">*</Label>
            </StackPanel>
            <PasswordBox csc:PasswordHelper.Attach="True" x:Name="txtpassword" Grid.Row="1" Grid.Column="1" Margin="0,15,0,10"  csc:PasswordHelper.Password="{Binding LoginPassWord,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            <!--<TextBox Name="txtpassword"  Grid.Row="1" Grid.Column="1" Margin="0,15,0,10" Text="{Binding Model,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>-->
        </Grid>
        <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Content="Login" x:Name="save" IsDefault="True" Grid.Column="0" Grid.Row="0" Height="33" Style="{StaticResource AccentedSquareButtonStyle}" BorderBrush="{DynamicResource AccentColorBrush}" VerticalAlignment="Bottom" Margin="0,0,0,0" Width="100" Click="save_Click" />
            <Button Content="Cancel" x:Name="close" IsCancel="True" Grid.Row="0" Grid.Column="1" Height="33" Style="{StaticResource AccentedSquareButtonStyle}" BorderBrush="{DynamicResource AccentColorBrush}" VerticalAlignment="Bottom" Margin="0,0,0,0" Width="100" Click="close_Click" />
        </Grid>
    </StackPanel>
</UserControl>
