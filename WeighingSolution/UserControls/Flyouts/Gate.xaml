<UserControl x:Class="WeighingSolution.UserControls.Flyouts.Gate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeighingSolution.UserControls.Flyouts"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="20">
        <Label Content="Add Gate" FontWeight="Light" FontSize="30"/>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,15,0,10" Orientation="Horizontal">
                <Label>Gate Name</Label>
                <Label Foreground="red">*</Label>
            </StackPanel>
            <TextBox Name="txtGateName"  Grid.Row="0" Grid.Column="1" Margin="0,15,0,10" Text="{Binding Model.GateName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Grid.Row="1" Margin="0,15,0,10" Orientation="Horizontal">
                <Label>Gate Type</Label>
                <Label Foreground="Red">*</Label>
            </StackPanel>
            <ComboBox Grid.Row="1" Grid.Column="1" Name="cmbGateType"  Margin="0,15,-5,10" SelectedValue="{Binding Model.GateType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullReplaceConverter}, ConverterParameter=''}"  SelectedValuePath="Tag" IsSynchronizedWithCurrentItem="True">
                <ComboBoxItem  Content="Select GateType" Tag=""></ComboBoxItem>
                <ComboBoxItem Content="IN" Tag="IN" ></ComboBoxItem>
                <ComboBoxItem Content="OUT" Tag="OUT"></ComboBoxItem>
                <ComboBoxItem Content="BOTH" Tag="BOTH"></ComboBoxItem>
            </ComboBox>
            <Label Grid.Row="2" Margin="0,15,0,10">Note</Label>
            <TextBox Name="txtNotes" Grid.Row="2" Margin="0,15,0,10" Grid.Column="1" Padding="5,8,5,20" Text="{Binding Model.Notes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
            </TextBox>
        </Grid>
        <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Content="Add" IsDefault="True" Grid.Column="0" Grid.Row="0" Height="33" Style="{StaticResource AccentedSquareButtonStyle}" BorderBrush="{DynamicResource AccentColorBrush}" VerticalAlignment="Bottom" Margin="0,0,0,0" Width="100" Command="{Binding SaveCommand}"/>
            <Button Content="Cancel" IsCancel="True" Grid.Row="0" Grid.Column="1" Height="33" Style="{StaticResource AccentedSquareButtonStyle}" BorderBrush="{DynamicResource AccentColorBrush}" VerticalAlignment="Bottom" Margin="0,0,0,0" Width="100" Command="{Binding CloseDetailViewCommand}"/>
        </Grid>
    </StackPanel>
</UserControl>
