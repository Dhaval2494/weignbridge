<Page x:Class="WeighingSolution.View.TransactionReportFilterPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mAppsControls="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:rv="clr-namespace:Microsoft.Reporting.WinForms;assembly=Microsoft.ReportViewer.WinForms"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents" xmlns:xCeedDD1="clr-namespace:WeighingSolution.UserControls" xmlns:xCeedDD="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
      mc:Ignorable="d" Style="{DynamicResource MetroPage}"
      d:DesignHeight="700" d:DesignWidth="1200"
	Title="Transaction Report Filter">
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel  Margin="0,0,0,0">
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource CompanyIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="Transaction Report" />
                    </TextBlock>
                    <StackPanel HorizontalAlignment="Right" Margin="5,0,10,0">
                        <Button Name="btnBackToReport" IsCancel="True" Content="Back" HorizontalAlignment="Right" Height="30" VerticalAlignment="Center" Width="150" Margin="0,5,0,0" Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Click="btnBackToReport_Click"></Button>
                    </StackPanel>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"></RowDefinition>
                        <RowDefinition Height="0.7*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.3*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>
                        <ColumnDefinition Width="0.3*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Grid.Row="0" Name="stkFilterPanel">
                        <Grid Name="grdFileterParam">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"></ColumnDefinition>
                                <ColumnDefinition Width="1*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <GroupBox Name="gbTransactionDate" >
                                    <GroupBox.Header>
                                        <Label Foreground="White" Padding="10,0,0,0" FontWeight="Bold">Transaction Date</Label>
                                    </GroupBox.Header>
                                    <StackPanel Orientation="Horizontal" Background="{DynamicResource AccentColorBrush3}" HorizontalAlignment="Center" Margin="0,5,0,5">
                                        <Label Margin="0,0,5,0">From</Label>
                                        <!--<DatePicker Name="dtStartDate"  Width="150" Margin="0,0,15,0"  >
                                            <DatePicker.Resources>
                                                <Style TargetType="{x:Type DatePickerTextBox}">
                                                    <Setter Property="Padding" Value="2,3,2,2"></Setter>
                                                </Style>
                                            </DatePicker.Resources>
                                        </DatePicker>-->
                                        <mAppsControls:DateTimePicker Name="dtStartDate" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,15,0" Padding="2,3,2,2">
                                        </mAppsControls:DateTimePicker>
                                        <Label Margin="0,0,5,0">To</Label>
                                        <!--<DatePicker Name="dtEndDate" Width="150" Margin="0,0,15,0"  >
                                            <DatePicker.Resources>
                                                <Style TargetType="{x:Type DatePickerTextBox}">
                                                    <Setter Property="Padding" Value="2,3,2,2"></Setter>
                                                </Style>
                                            </DatePicker.Resources>
                                        </DatePicker>-->
                                        <mAppsControls:DateTimePicker Name="dtEndDate" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,15,0" Padding="2,3,2,2">
                                        </mAppsControls:DateTimePicker>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Name="gbTicketNo" Margin="0,10,0,0">
                                    <GroupBox.Header>
                                        <Label Foreground="White" Padding="10,0,0,0" FontWeight="Bold">Ticket No</Label>
                                    </GroupBox.Header>
                                    <StackPanel Orientation="Horizontal" Background="{DynamicResource AccentColorBrush3}" HorizontalAlignment="Center" Margin="0,5,0,5">
                                        <Label Margin="0,0,5,0">From</Label>
                                        <TextBox Name="txtTicketFrom" Width="150" Height="30" Margin="0,0,15,0" Padding="2,2,2,2"></TextBox>
                                        <Label Margin="0,0,5,0">To</Label>
                                        <TextBox Name="txtTicketTo" Width="150" Height="30" Margin="0,0,15,0" Padding="2,2,2,2"></TextBox>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Name="gbMasterField" Margin="0,10,0,0" MinHeight="251">
                                    <GroupBox.Header>
                                        <Label Foreground="White" Padding="10,0,0,0" FontWeight="Bold">Master Field</Label>
                                    </GroupBox.Header>
                                    <StackPanel Name="stkMasterField">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                            <Label Margin="15,0,15,0" Width="100">Account</Label>
                                            <xCeedDD1:AutoCompleteBoxEx  x:Name="cmbAccount" Width="300" Height="30" Margin="15,0,15,0" Padding="2,2,2,2"
                                                                     VerticalAlignment="Center"  TabIndex="4" IsEnabled="{Binding ControlsEnabled}"
                                                                     Text="{Binding AccountNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                                     ItemsSource="{Binding AutofillAccounts}" Foreground="{DynamicResource BlackBrush}" 
                                                                     Background="{DynamicResource WhiteBrush}" MinimumPrefixLength="1"
                                                                    Visibility="Visible" SelectionChanged="cmbAccount_SelectionChanged" TextChanged="cmbAccount_TextChanged"
                                                                         LostFocus="cmbAccount_LostFocus"/>
                                            <!--<ComboBox Name="CmbAccount" Width="300" Height="30" Margin="15,0,15,0" Padding="2,2,2,2" ToolTip="Search By Account" SelectedIndex="0" >
                                            </ComboBox>-->
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                            <Label Margin="15,0,15,0" Width="100">Product</Label>
                                            <xCeedDD1:AutoCompleteBoxEx  x:Name="cmbProduct" Width="300" Height="30" Margin="15,0,15,0" Padding="2,2,2,2"
                                                                     VerticalAlignment="Center"  TabIndex="6" ToolTip="Search By Product" FilterMode="ContainsOrdinal"
                                                                     Text="{Binding ProductNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                                     ItemsSource="{Binding AutofillProducts}" Foreground="{DynamicResource BlackBrush}" 
                                                                     Background="{DynamicResource WhiteBrush}" MinimumPrefixLength="1"
                                                                     Visibility="Visible"
                                                                     SelectionChanged="cmbProduct_SelectionChanged"
                                                                     TextChanged="cmbProduct_TextChanged"
                                                                     LostFocus="cmbProduct_LostFocus"/>
                                            <!--<ComboBox Name="CmbProduct" Width="300" Height="30" Margin="15,0,15,0" Padding="2,2,2,2" ToolTip="Search By Product" SelectedIndex="0" >
                                            </ComboBox>-->
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                            <Label Margin="15,0,15,0" Width="100">Vehicle</Label>
                                            <xCeedDD1:AutoCompleteBoxEx x:Name="cmbVehicalNo" Width="300" Height="30" Margin="15,0,15,0" Padding="2,2,2,2"
                                                                    VerticalAlignment="Bottom"  TabIndex="2" MinimumPrefixLength="1" FilterMode="ContainsOrdinal"
                                                                    ItemsSource="{Binding Autofillvehicles}"
                                                                    Text="{Binding VehicleNumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                                    Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}" Focusable="True" 
                                                                    SelectionChanged="cmbVehicalNo_SelectionChanged"
                                                                    TextChanged="cmbVehicalNo_TextChanged" 
                                                                        LostFocus="cmbVehicalNo_LostFocus"/>
                                            <!--<ComboBox Name="cmbVehicle" Width="300" Height="30" Margin="15,0,15,0" Padding="2,2,2,2" ToolTip="Search By Vehicle" SelectedIndex="0" >
                                            </ComboBox>-->
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                            <Label Margin="15,0,15,0" Width="100">Weighbridge</Label>
                                            <xCeedDD1:AutoCompleteBoxEx x:Name="cmbWeighbridge" Width="300" Height="30" Margin="15,0,15,0" Padding="2,2,2,2"
                                                                    VerticalAlignment="Bottom"  TabIndex="2" MinimumPrefixLength="1" FilterMode="ContainsOrdinal"
                                                                    ItemsSource="{Binding AutofillWeighbridge}"
                                                                    Text="{Binding WeighbridgeNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                                    Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}" Focusable="True" 
                                                                   SelectionChanged="cmbWeighbridge_SelectionChanged" LostFocus="cmbWeighbridge_LostFocus" TextChanged="cmbWeighbridge_TextChanged"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                                <!--<GroupBox Name="gbAccount" Margin="0,10,0,0">
                                    <GroupBox.Header>
                                        <Label Foreground="White" Padding="10,0,0,0" FontWeight="Bold">Account</Label>
                                    </GroupBox.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                        <ComboBox Name="CmbAccount" Width="400" Height="30" Margin="15,0,15,0" Padding="2,2,2,2" ToolTip="Search By Account" SelectedIndex="0" >
                                        </ComboBox>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Name="gbProduct" Margin="0,10,0,0">
                                    <GroupBox.Header>
                                        <Label Foreground="White" Padding="10,0,0,0" FontWeight="Bold">Product</Label>
                                    </GroupBox.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                        <ComboBox Name="CmbProduct" Width="400" Height="30" Margin="15,0,15,0" Padding="2,2,2,2" ToolTip="Search By Product" SelectedIndex="0" >
                                        </ComboBox>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Name="gbVehicle" Margin="0,10,0,0">
                                    <GroupBox.Header>
                                        <Label Foreground="White" Padding="10,0,0,0" FontWeight="Bold">Vehicle</Label>
                                    </GroupBox.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                        <ComboBox Name="cmbVehicle" Width="400" Height="30" Margin="15,0,15,0" Padding="2,2,2,2" ToolTip="Search By Vehicle" SelectedIndex="0" >
                                        </ComboBox>
                                    </StackPanel>
                                </GroupBox>-->
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <GroupBox Name="gbTransactionMode">
                                    <GroupBox.Header>
                                        <Label Foreground="White" Padding="10,0,0,0" FontWeight="Bold">Transaction Mode / Status / Type</Label>
                                    </GroupBox.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,5">
                                        <ComboBox Name="CmbTranMode" Width="170" Height="27" Margin="10,0,0,0" Padding="2,2,2,2" ToolTip="Search By Transaction Mode" SelectedIndex="0" >
                                        </ComboBox>
                                        <ComboBox Name="CmbTranStatus" Width="170" Height="27" Margin="10,0,0,0" Padding="2,2,2,2" ToolTip="Search By Transaction Status" SelectedIndex="0" >
                                        </ComboBox>
                                        <ComboBox Name="CmbTranType" Width="170" Height="27" Margin="10,0,0,0" Padding="2,2,2,2" ToolTip="Search By Transaction Type" SelectedIndex="0" >
                                        </ComboBox>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Name="gbCustomField" Margin="0,10,0,0" Height="336" MaxHeight="336" >
                                    <GroupBox.Header>
                                        <Label Foreground="White" Padding="10,0,0,0" FontWeight="Bold">Custom Fields</Label>
                                    </GroupBox.Header>
                                    <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                                        <StackPanel Orientation="Vertical">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.5*"></ColumnDefinition>
                                                    <ColumnDefinition Width="1*"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <Label Name="lblField1" Visibility="Collapsed" Margin="5,15,0,5" ></Label>
                                                    <Label Name="lblField2" Visibility="Collapsed" Margin="5,5,0,5"  ></Label>
                                                    <Label Name="lblField3" Visibility="Collapsed" Margin="5,5,0,5"  ></Label>
                                                    <Label Name="lblField4" Visibility="Collapsed" Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField5" Visibility="Collapsed" Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField6" Visibility="Collapsed" Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField7" Visibility="Collapsed" Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField8" Visibility="Collapsed" Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField9" Visibility="Collapsed" Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField10" Visibility="Collapsed"  Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField11" Visibility="Collapsed"  Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField12" Visibility="Collapsed"  Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField13" Visibility="Collapsed"  Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField14" Visibility="Collapsed"  Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField15" Visibility="Collapsed"  Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField16" Visibility="Collapsed"  Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField17" Visibility="Collapsed"  Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField18" Visibility="Collapsed"  Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField19" Visibility="Collapsed"  Margin="5,5,0,5" ></Label>
                                                    <Label Name="lblField20" Visibility="Collapsed"  Margin="5,5,0,15" ></Label>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <xCeedDD:AutoCompleteBox Name="txtField1" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields1}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField2" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields2}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField3" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields3}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField4" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields4}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField5" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields5}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField6" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue6, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields6}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField7" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue7, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields7}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField8" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue8, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields8}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField9" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue9, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields9}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField10" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue10, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields10}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField11" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue11, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields11}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField12" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue12, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields12}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField13" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue13, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields13}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField14" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue14, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields14}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField15" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue15, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields15}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField16" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue16, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields16}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField17" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue17, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields17}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField18" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue18, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields18}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField19" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue19, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields19}" />
                                                    <xCeedDD:AutoCompleteBox Name="txtField20" Visibility="Collapsed" Grid.Row="0" Padding="4"  Margin="0,5,5,5" VerticalAlignment="Center" Grid.Column="1" MinimumPrefixLength="2" Foreground="{DynamicResource BlackBrush}" Background="{DynamicResource WhiteBrush}"  Text="{Binding CustomValue20, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ItemsSource="{Binding CustomFields20}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </csc:ScrollViewerEx>
                                </GroupBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <!--<StackPanel Grid.ColumnSpan="2"  Grid.Column="1" Grid.Row="1" Orientation="Horizontal"  Margin="0">-->
                    <StackPanel Orientation="Horizontal"  Grid.Column="1" Grid.Row="1">
                        <RadioButton Name="rbTransactionSummary" Visibility="Collapsed" Grid.Row="1" Content="Transaction Summary" Margin="10,5,0,5" ></RadioButton>
                        <RadioButton Name="rbTransactionDetail" Visibility="Collapsed" Content="Transaction Detail" Margin="10,5,0,5"></RadioButton>
                        <!--<ComboBox Name="cmbFilterBy" Grid.Row="0" Grid.Column="1"  SelectedValuePath="Tag">
                            <ComboBoxItem x:Name="Tran" Content="DotMatrix" Tag="DotMatrix"></ComboBoxItem>
                            <ComboBoxItem x:Name="Laser" IsSelected="True" Content="Laser" Tag="Laser" ></ComboBoxItem>
                        </ComboBox>-->
                    </StackPanel>
                    <Button Name="btnfilter" Visibility="Visible"  Grid.Column="1" Grid.Row="1" Content="Filter" Height="30" Width="150" Margin="440,5,5,0" HorizontalAlignment="Right" Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Click="btnfilter_Click"></Button>
                    <!--</StackPanel>-->
                </Grid>
            </csc:ScrollViewerEx>
        </DockPanel>
    </Grid>
</Page>
