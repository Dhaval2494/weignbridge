<Page x:Class="WeighingSolution.View.TransactionDetailReport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:rv="clr-namespace:Microsoft.Reporting.WinForms;assembly=Microsoft.ReportViewer.WinForms"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="300" d:DesignWidth="300"
	Title="TransactionDetailReport">

    <Grid Background="{DynamicResource WhiteBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,5,0,0">
        <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
            <DockPanel Margin="10,0,0,0">
                <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{StaticResource CompanyIcon}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="Transaction Detail Report" />
                </TextBlock>
                <StackPanel HorizontalAlignment="Stretch" Margin="5,0,10,0">
                    <Button Name="btnfilterBack" IsCancel="True" Content="Back" HorizontalAlignment="Right" Height="30" Width="150" Margin="0,5,0,0" Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Click="btnfilterBack_Click"></Button>
                </StackPanel>
            </DockPanel>
            <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
        </StackPanel>

        <WindowsFormsHost Margin="80,80,80,40" VerticalAlignment="Stretch" Height="Auto" Name="winform">
            <rv:ReportViewer x:Name="reportViewer"  Margin="10,20,10,10" />
        </WindowsFormsHost>
        <TextBlock Name="txtmsg" FontSize="20" Opacity="0.5" HorizontalAlignment="Center"  VerticalAlignment="Top"  Margin="0,100,0,0" >No Record Exist</TextBlock>
    </Grid>
</Page>
