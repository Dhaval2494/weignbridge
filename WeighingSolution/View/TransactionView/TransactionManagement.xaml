                                                        Visibility="{Binding IsRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>

                                                <xCeedDD:AutoCompleteBox
    Grid.Row="0"
    Grid.Column="1"
    Margin="3"
    Padding="4"
    VerticalAlignment="Center"
    Background="{DynamicResource WhiteBrush}"
    Foreground="{DynamicResource BlackBrush}"
    ItemsSource="{Binding FieldValues}"
    MinimumPrefixLength="2"
    Text="{Binding CustomValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    IsEnabled="{Binding Editable}" />

                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </UniformGrid>
                        </StackPanel>
                    </csc:ScrollViewerEx>
                </GroupBox>

                <!--  Right Panel contaning receipt details, camera and weighmeter  -->
                <DockPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    LastChildFill="True">
                    <DockPanel
                        Name="dockMain"
                        Background="{DynamicResource AccentColorBrush}"
                        DockPanel.Dock="Top"
                        LastChildFill="True">
                        <!--  Transaction Summary  -->
                        <DockPanel
                            Name="dockDefault"
                            Width="225"
                            Height="230"
                            DockPanel.Dock="left"
                            KeyboardNavigation.TabNavigation="None"
                            LastChildFill="True">
                            <StackPanel Margin="10,0,0,5" DockPanel.Dock="Bottom">
                                <TextBlock FontWeight="Bold" Foreground="White">Net Weight:</TextBlock>
                                <TextBlock FontSize="45" Foreground="White">
                                    <Run Text="{Binding Model.NetWeight, StringFormat={x:Static strFormat:Constant.DecimalFormat}, Mode=OneWay, TargetNullValue='00'}" />
                                    <Run Text="{Binding Model.SummaryTransaction.WeightUnit}" />
                                </TextBlock>
                            </StackPanel>
                            <Grid Margin="5,10,0,0" DockPanel.Dock="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Orientation="Horizontal">
                                    <Rectangle
                                        Width="60"
                                        Margin="0,3,5,0"
                                        Fill="White">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{StaticResource EmptyTruckIcon}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="White">
                                        Prev.<LineBreak />
                                        Tare:</TextBlock>
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                                    <Rectangle
                                        Width="60"
                                        Margin="0,3,5,0"
                                        Fill="White">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{StaticResource LoadedTruckIcon}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="White">
                                        Prev.<LineBreak />
                                        Gross:</TextBlock>
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    FontSize="24"
                                    Foreground="White">
                                    <Run Text="{Binding Model.SummaryTransaction.TareWeight, StringFormat={x:Static strFormat:Constant.DecimalFormat}, TargetNullValue='00'}" />
                                </TextBlock>
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Foreground="White">
                                    <Run Text="{Binding Model.SummaryTransaction.TareTime, StringFormat={x:Static strFormat:Constant.SelectedDateFormat}}" /><LineBreak />
                                    <Run Text="{Binding Model.SummaryTransaction.TareTime, StringFormat={x:Static strFormat:Constant.SelectedTimeFormat}}" /><LineBreak />
                                    <!--<Run Text="{Binding Model.SummaryTransaction.TareTime, StringFormat='{}{0:hh:mm tt}'}" />-->
                                </TextBlock>
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="24"
                                    Foreground="White">
                                    <Run Text="{Binding Model.SummaryTransaction.GrossWeight, StringFormat={x:Static strFormat:Constant.DecimalFormat}, TargetNullValue='00'}" />
                                </TextBlock>
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Foreground="White">
                                    <Run Text="{Binding Model.SummaryTransaction.GrossTime, StringFormat={x:Static strFormat:Constant.SelectedDateFormat}}" /><LineBreak />
                                    <Run Text="{Binding Model.SummaryTransaction.GrossTime, StringFormat={x:Static strFormat:Constant.SelectedTimeFormat}}" /><LineBreak />
                                    <!--<Run Text="{Binding Model.SummaryTransaction.GrossTime, StringFormat='{}{0:hh:mm tt}'}" />-->
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                        <Border
                            Width="1"
                            Height="230"
                            Background="White"
                            DockPanel.Dock="Left"
                            KeyboardNavigation.TabNavigation="None" />
                        <DockPanel
                            Name="dckPanelWeightIndicator"
                            Height="230"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            DockPanel.Dock="Right"
                            KeyboardNavigation.TabIndex="3"
                            KeyboardNavigation.TabNavigation="Local"
                            LastChildFill="True">
                            <Grid
                                Name="gridAutomanualweight"
                                Margin="0,0,10,5"
                                HorizontalAlignment="Center"
                                DockPanel.Dock="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RadioButton
                                    Name="rdbAutomatic"
                                    Margin="10,0"
                                    Foreground="White"
                                    GroupName="rdbAutoManual"
                                    IsChecked="True"
                                    TabIndex="2"
                                    Visibility="Collapsed">
                                    Automatic
                                </RadioButton>
                                <RadioButton
                                    Name="rdbManual"
                                    Grid.Column="1"
                                    Margin="10,0,10,0"
                                    Checked="rdbManual_Checked"
                                    Foreground="White"
                                    GroupName="rdbAutoManual"
                                    IsChecked="{Binding ActiveTransaction.IsCapturedManual, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TabIndex="3"
                                    Visibility="Collapsed">
                                    Manual
                                </RadioButton>
                                <Button
                                    Name="btnCaptureWeight"
                                    Grid.Column="2"
                                    Width="130"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Controls:ButtonHelper.PreserveTextCase="True"
                                    BorderBrush="{DynamicResource AccentColorBrush}"
                                    Command="{Binding CaptureWeightCommand}"
                                    Content="Capture Weight (F8)"
                                    Style="{DynamicResource HighlightedSquareButtonStyle}"
                                    TabIndex="4">
                                    <Button.CommandParameter>
                                        <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                                            <Binding ElementName="txtWeightMeter" Path="Text" />
                                            <Binding ElementName="lblWeightMeter" Path="Text" />
                                        </MultiBinding>
                                    </Button.CommandParameter>
                                </Button>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <!--  Automatic Weigh Capture  -->
                                <Grid HorizontalAlignment="Center" Visibility="{Binding ActiveTransaction.IsCapturedManual, Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Name="lblWeightMeter"
                                        Grid.Column="0"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Bottom"
                                        FontFamily="Digital-7"
                                        FontSize="90"
                                        Foreground="White"
                                        Text="{Binding SelectedWeighBridge.FormatedData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextAlignment="Center"
                                        Visibility="{Binding ActiveTransaction.WeightBridge.IsCablePlugged, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        Name="lblUnit1"
                                        Grid.Column="1"
                                        Margin="0,0,0,10"
                                        VerticalAlignment="Bottom"
                                        FontSize="24"
                                        Foreground="White"
                                        Text="{Binding SelectedWeighBridge.Unit.UnitName}"
                                        TextAlignment="Right"
                                        Visibility="{Binding ActiveTransaction.WeightBridge.IsCablePlugged, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                                    <Rectangle
                                        Grid.Column="0"
                                        Width="180"
                                        Height="180"
                                        Margin="0,0,10,5"
                                        HorizontalAlignment="Center"
                                        Fill="White"
                                        Visibility="{Binding ActiveTransaction.WeightBridge.IsCablePlugged, Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{StaticResource UnpluggedIcon}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>

                                <!--  Manual Weigh Capture  -->
                                <Grid HorizontalAlignment="Center" Visibility="{Binding ActiveTransaction.IsCapturedManual, Converter={StaticResource NegativeBooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="225" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Name="lblSubWeightMeter"
                                        Grid.Column="0"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Digital-7"
                                        FontSize="24"
                                        Foreground="White"
                                        TextAlignment="Center">
                                        <Rectangle
                                            Width="50"
                                            Height="50"
                                            Fill="White">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource WeightMeterIcon}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <LineBreak />
                                        <Run Text="{Binding ActiveTransaction.WeightBridge.FormatedData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </TextBlock>
                                    <csc:FilteredTextbox
                                        x:Name="txtWeightMeter"
                                        Grid.Column="1"
                                        Margin="0,0,0,0"
                                        Padding="10,0,10,0"
                                        VerticalAlignment="Bottom"
                                        Background="White"
                                        FilterRegex="^[0-9]+$|^[0-9]*[.]{0,1}[0-9]*$"
                                        FontFamily="Digital-7"
                                        FontSize="75"
                                        Foreground="Black"
                                        TabIndex="1"
                                        Text="0"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Name="lblUnit2"
                                        Grid.Column="2"
                                        Margin="0,0,0,10"
                                        VerticalAlignment="Bottom"
                                        FontSize="24"
                                        Foreground="White"
                                        Text="{Binding SelectedWeighBridge.Unit.UnitName}"
                                        TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
