<Page
    x:Class="WeighingSolution.View.TransactionManagement"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
    xmlns:converter1="clr-namespace:WeighingSolution.DataLayer;assembly=WeighingSolution.SharedComponents"
    xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mAppsControls="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:WeighingSolution.SharedComponents;assembly=WeighingSolution.SharedComponents"
    xmlns:strFormat="clr-namespace:WeighingSolution.DataLayer;assembly=WeighingSolution.DataLayer"
    xmlns:weighingsolution="clr-namespace:WeighingSolution"
    xmlns:xCeedDD="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
    xmlns:xCeedDD1="clr-namespace:WeighingSolution.UserControls"
    Title="Transaction Management"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    FocusManager.IsFocusScope="True"
    Style="{DynamicResource MetroPage}"
    mc:Ignorable="d">


    <Page.Resources>
        <converter:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converter:ListToVisibilityConverter x:Key="ListToVisibilityConverter" />
        <converter:WeightVisibilityConverter x:Key="WeightVisibilityConverter" />
        <converter:EqualityVisibilityConverter x:Key="EqualityVisibilityConverter" />
        <converter:InEqualityVisibilityConverter x:Key="InEqualityVisibilityConverter" />
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converter:EqualityConverter x:Key="EqualityConverter" />
        <converter:InEqualityConverter x:Key="InEqualityConverter" />
        <converter1:Base64ToImageConverter x:Key="Base64ToImageConverter" />
        <converter1:CameraImagePathConverter x:Key="CameraImagePathConverter" />
        <converter:BooleanAndConverter x:Key="BooleanAndConverter" />

        <BitmapImage x:Key="DefaultImage" UriSource="/Images/no-img.png" />
    </Page.Resources>
    <Page.InputBindings>
        <KeyBinding Command="{Binding CaptureWeightCommand}" Gesture="F8">
            <KeyBinding.CommandParameter>
                <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                    <Binding ElementName="txtWeightMeter" Path="Text" />
                    <Binding ElementName="lblWeightMeter" Path="Text" />
                </MultiBinding>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding
            Command="{Binding SaveCommand}"
            CommandParameter="Continue"
            Gesture="F7" />
    </Page.InputBindings>
    <DockPanel Background="{DynamicResource WhiteBrush}" KeyboardNavigation.TabNavigation="Cycle">
        <!--  Multi Weighbridge Icons / Buttons  -->
        <StackPanel
            Name="stkMultiWeighBridge"
            Width="100"
            Background="{DynamicResource AccentColorBrush2}"
            DockPanel.Dock="Left"
            Orientation="Vertical"
            Visibility="Collapsed">
            <ListView
                Name="lvActiveWeighbridges"
                Margin="0"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding ActiveWeighBridges}"
                KeyboardNavigation.DirectionalNavigation="Cycle"
                SelectedItem="{Binding SelectedWeighBridge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TabIndex="1">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource MetroListViewItem}" TargetType="{x:Type ListViewItem}">
                        <Setter Property="Margin" Value="9,15,9,15" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Controls:ItemHelper.SelectedBackgroundBrush" Value="Transparent" />
                        <Setter Property="Controls:ItemHelper.ActiveSelectionBackgroundBrush" Value="Transparent" />
                        <Setter Property="Controls:ItemHelper.HoverSelectedBackgroundBrush" Value="Transparent" />
                        <Setter Property="Controls:ItemHelper.HoverBackgroundBrush" Value="Transparent" />
                        <Setter Property="Controls:ItemHelper.ActiveSelectionForegroundBrush" Value="{DynamicResource BlackBrush}" />
                        <Setter Property="Controls:ItemHelper.SelectedForegroundBrush" Value="{DynamicResource BlackBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}" />
                        <Style.Triggers>
                            <Trigger Property="ListViewItem.IsMouseOver" Value="True">
                                <Setter Property="Controls:ItemHelper.ActiveSelectionForegroundBrush" Value="{DynamicResource WhiteBrush}" />
                                <Setter Property="Controls:ItemHelper.SelectedForegroundBrush" Value="{DynamicResource WhiteBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0"
                            Padding="0,0,0,7"
                            BorderThickness="1"
                            CornerRadius="5">
                            <Border.Style>
                                <Style>
                                    <Setter Property="Border.BorderBrush" Value="{DynamicResource AccentColorBrush2}" />
                                    <Setter Property="Border.Background" Value="{DynamicResource AccentColorBrush4}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True">
                                            <Setter Property="Border.Background" Value="{DynamicResource WhiteBrush}" />
                                            <Setter Property="Border.BorderBrush" Value="{DynamicResource WhiteBrush}" />
                                        </DataTrigger>
                                        <Trigger Property="Border.IsMouseOver" Value="True">
                                            <Setter Property="Border.Background" Value="{DynamicResource WhiteBrush}" />
                                            <Setter Property="Border.BorderBrush" Value="{DynamicResource WhiteBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Width="80" Margin="0">
                                <Rectangle
                                    Width="60"
                                    Height="60"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    Fill="{DynamicResource BlackBrush}"
                                    Visibility="{Binding FormatedData, Converter={StaticResource WeightVisibilityConverter}, ConverterParameter='Visible'}">
                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform" Visual="{StaticResource EmptyWeighScaleIcon}" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Rectangle
                                    Width="60"
                                    Height="60"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    Fill="{DynamicResource BlackBrush}"
                                    Visibility="{Binding FormatedData, Converter={StaticResource WeightVisibilityConverter}, ConverterParameter='Collapsed'}">
                                    <Rectangle.OpacityMask>
                                        <VisualBrush Stretch="Uniform" Visual="{StaticResource LoadedWeighSclaleIcon}" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Text="{Binding FormatedData, TargetNullValue=VACANT}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Width="74"
                                    FontSize="8"
                                    Text="{Binding ScaleName}"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <DockPanel
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource AccentColorBrush4}"
            DockPanel.Dock="Right"
            LastChildFill="True">
            <!--  Bottom Panel containing Action buttons: Cancel, End Transaction, Continue and Capture Weight  -->
            <StackPanel
                Height="100"
                Margin="0,0,0,0"
                VerticalAlignment="Bottom"
                Background="{DynamicResource AccentColorBrush4}"
                DockPanel.Dock="Bottom"
                KeyboardNavigation.TabIndex="5"
                KeyboardNavigation.TabNavigation="Local"
                Orientation="Horizontal">
                <Button
    Name="btnContinue"
    Height="30"
    Margin="10,10,10,10"
    Padding="20,0,20,0"
    VerticalAlignment="Top"
    Controls:ButtonHelper.PreserveTextCase="True"
    BorderBrush="{DynamicResource AccentColorBrush}"
    Command="{Binding SaveCommand}"
    CommandParameter="Continue"
    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
    Style="{DynamicResource mouseoverstyle}"
    TabIndex="1"
    Visibility="Collapsed">

                    <Button.Content>
                        <Grid>

                            <!-- Normal Text -->
                            <TextBlock
                Text="Continue (F7)"
                VerticalAlignment="Center">

                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSaving}" Value="True" />
                                                    <Condition Binding="{Binding SavingAction}" Value="Continue" />
                                                </MultiDataTrigger.Conditions>

                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>

                            <!-- Loading -->
                            <StackPanel Orientation="Horizontal">

                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">

                                        <!-- Default -->
                                        <Setter Property="Visibility" Value="Collapsed" />

                                        <Style.Triggers>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSaving}" Value="True" />
                                                    <Condition Binding="{Binding SavingAction}" Value="Continue" />
                                                </MultiDataTrigger.Conditions>

                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>

                                        </Style.Triggers>

                                    </Style>
                                </StackPanel.Style>

                                <Controls:ProgressRing
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    Foreground="White"
                    IsActive="True" />

                                <TextBlock
                    Text="Saving..."
                    VerticalAlignment="Center" />

                            </StackPanel>

                        </Grid>
                    </Button.Content>
                </Button>
                <!--<Button TabIndex="2" Content="Continue And Print" Name="btnContinueAndPrint" Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Padding="20,0,20,0" Margin="10,30,10,30" Visibility="Collapsed" Command="{Binding SaveCommand}" CommandParameter="ContinueAndPrint"></Button>-->
                <Button
    Name="btnEndTransaction"
    Height="30"
    Margin="10,10,10,10"
    Padding="20,0,20,0"
    VerticalAlignment="Top"
    Controls:ButtonHelper.PreserveTextCase="True"
    BorderBrush="{DynamicResource AccentColorBrush}"
    Command="{Binding SaveCommand}"
    CommandParameter="EndTransaction"
    IsDefault="True"
    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}"
    Style="{DynamicResource mouseoverstyle}"
    TabIndex="3"
    Visibility="Collapsed">
                    <Button.Content>
                        <Grid>
                            <TextBlock Text="End Transaction (Enter)" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSaving}" Value="True" />
                                                    <Condition Binding="{Binding SavingAction}" Value="EndTransaction" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSaving}" Value="True" />
                                                    <Condition Binding="{Binding SavingAction}" Value="EndTransaction" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Controls:ProgressRing
                    Width="16" Height="16" Margin="0,0,8,0"
                    Foreground="White" IsActive="True" />
                                <TextBlock Text="Ending..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button.Content>
                </Button>
                <!--<Button TabIndex="4" Content="End Transaction And Print"  Controls:ButtonHelper.PreserveTextCase="True" Name="btnEndTransactionAndPrint" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}"  Height="30" Padding="20,0,20,0" Margin="10,30,10,30" Visibility="Collapsed" Command="{Binding SaveCommand}" CommandParameter="EndTransactionAndPrint"></Button>-->
                <Button
                    Name="btnBackToList"
                    Height="30"
                    Margin="10,10,10,10"
                    Padding="20,0,20,0"
                    VerticalAlignment="Top"
                    Controls:ButtonHelper.PreserveTextCase="True"
                    BorderBrush="{DynamicResource AccentColorBrush}"
                    Command="{Binding CloseDetailViewCommand}"
                    CommandParameter="/View/TransactionView/TransactionManagementList_Page.Xaml"
                    Content="Cancel (Esc)"
                    IsCancel="True"
                    Style="{DynamicResource mouseoverstyle}"
                    TabIndex="5" />
            </StackPanel>

            <!--  Left GroupBox containing input fields, Right Panel contaning receipt details, camera and weighmeter  -->
            <Grid DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Left GroupBox containing Master Input Fields  -->
                <GroupBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0"
                    VerticalAlignment="Stretch"
                    BorderBrush="{DynamicResource AccentColorBrush}"
                    DockPanel.Dock="Top"
                    KeyboardNavigation.TabNavigation="Local"
                    TabIndex="2">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="Transaction Details" />
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding PageLoadText}"
                                TextAlignment="Right" />
                        </StackPanel>
                    </GroupBox.Header>
                    <csc:ScrollViewerEx
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid
                                Name="gridTranDetail"
                                Margin="15,10,0,0"
                                KeyboardNavigation.TabIndex="1"
                                KeyboardNavigation.TabNavigation="Local">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="-5,0,0,5"
                                    VerticalAlignment="Top">
                                    Transaction Mode:
                                </Label>
                                <RadioButton
                                    Name="rdbSinglePass"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,0,5"
                                    Checked="rdbTransactionMode_Checked"
                                    GroupName="rdbTransactionMode"
                                    IsChecked="{Binding Model.TransactionMode, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Single'}"
                                    IsEnabled="{Binding EditMode, Converter={StaticResource InverseBooleanConverter}}"
                                    TabIndex="1">
                                    Single
                                </RadioButton>
                                <RadioButton
                                    Name="rdbDoublePass"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="100,0,0,5"
                                    Checked="rdbTransactionMode_Checked"
                                    GroupName="rdbTransactionMode"
                                    IsChecked="{Binding Model.TransactionMode, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Double'}"
                                    TabIndex="2">
                                    Double
                                </RadioButton>
                                <RadioButton
                                    Name="rdbMultiPass"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="200,0,0,5"
                                    Checked="rdbTransactionMode_Checked"
                                    GroupName="rdbTransactionMode"
                                    IsChecked="{Binding Model.TransactionMode, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Multi'}"
                                    TabIndex="3"
                                    Visibility="{Binding Source={x:Static strFormat:Constant.IsBasicversion}, Converter={StaticResource InEqualityVisibilityConverter}, ConverterParameter={StaticResource TrueValue}}">
                                    Multi
                                </RadioButton>

                                <Label
                                    Name="lblWeighmentType"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="-5,0,0,5"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding EditMode, Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                                    Weighment Type:
                                </Label>
                                <RadioButton
                                    Name="rdbTareWeight"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,0,5"
                                    GroupName="rdbWeighmentType"
                                    IsChecked="{Binding ActiveTransaction.WeighmentType, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Tare'}"
                                    IsEnabled="{Binding Model.TransactionMode, Converter={StaticResource InEqualityConverter}, ConverterParameter='Single'}"
                                    TabIndex="4"
                                    Visibility="{Binding EditMode, Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                                    Tare
                                </RadioButton>
                                <RadioButton
                                    Name="rdbGrossWeight"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="100,0,0,5"
                                    GroupName="rdbWeighmentType"
                                    IsChecked="{Binding ActiveTransaction.WeighmentType, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Gross'}"
                                    IsEnabled="{Binding Model.TransactionMode, Converter={StaticResource InEqualityConverter}, ConverterParameter='Single'}"
                                    TabIndex="5"
                                    Visibility="{Binding EditMode, Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                                    Gross
                                </RadioButton>

                                <Label
                                    Name="lblTxType"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="-5,0,0,5"
                                    VerticalAlignment="Top">
                                    Transaction Type:
                                </Label>
                                <RadioButton
                                    Name="rdbShipped"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,0,5"
                                    GroupName="rdbTransactionType"
                                    IsChecked="{Binding Model.TransactionType, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Outgoing'}"
                                    IsEnabled="{Binding EditMode, Converter={StaticResource InverseBooleanConverter}}"
                                    TabIndex="6">
                                    Outgoing
                                </RadioButton>
                                <RadioButton
                                    Name="rdbReceived"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="100,0,0,5"
                                    GroupName="rdbTransactionType"
                                    IsChecked="{Binding Model.TransactionType, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Incoming'}"
                                    IsEnabled="{Binding EditMode, Converter={StaticResource InverseBooleanConverter}}"
                                    TabIndex="7">
                                    Incoming
                                </RadioButton>
                                <RadioButton
                                    Name="rdbBoth"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="200,0,0,5"
                                    GroupName="rdbTransactionType"
                                    IsChecked="{Binding Model.TransactionType, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Both'}"
                                    IsEnabled="{Binding EditMode, Converter={StaticResource InverseBooleanConverter}}"
                                    TabIndex="8">
                                    Both
                                </RadioButton>

                                <Label
                                    Name="lblTransactionDate"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="-5,0,0,0"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding EntryDateEditable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    Transaction Datetime:
                                </Label>
                                <mAppsControls:DateTimePicker
                                    Name="txtTransactionDate"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Width="250"
                                    Margin="0,0,5,5"
                                    Padding="5,5,5,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource WhiteBrush}"
                                    Foreground="{DynamicResource BlackBrush}"
                                    SelectedDate="{Binding ActiveTransaction.CaptureTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TabIndex="9"
                                    Visibility="{Binding EntryDateEditable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Grid
                                    Name="gridtoken"
                                    Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Visibility="Collapsed">
                                    <StackPanel
                                        Name="stktoken"
                                        Margin="-5,5,10,5"
                                        Orientation="Horizontal">
                                        <StackPanel Width="70" Orientation="Horizontal">
                                            <Label Content="Token:" />
                                            <Label
                                                x:Name="lblTokenRequired"
                                                Content="*"
                                                Foreground="Red" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="CmbToken"
                                            Width="250px"
                                            Height="30px"
                                            Margin="55,0,5,5"
                                            Padding="2"
                                            DisplayMemberPath="TokenName"
                                            IsEditable="True"
                                            IsEnabled="{Binding ControlsEnabled}"
                                            IsTextSearchEnabled="True"
                                            ItemsSource="{Binding Tokens}"
                                            SelectedItem="{Binding Model.Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValue="{Binding SelectedToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="TokenID" />
                                        <!--  SelectionChanged="CmbToken_SelectionChanged"  -->
                                        <Button
                                            Name="btnChangeToken"
                                            Height="30"
                                            Margin="20,0,0,5"
                                            Padding="5"
                                            Controls:ButtonHelper.PreserveTextCase="True"
                                            BorderBrush="{DynamicResource AccentColorBrush}"
                                            Command="{Binding ChangeTokenCommand}"
                                            Content="Change Token"
                                            Style="{DynamicResource mouseoverstyle}"
                                            Visibility="{Binding IsChangeTokenVisible, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                                <Border
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="2"
                                    Width="1"
                                    Height="100"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AccentColorBrush}"
                                    KeyboardNavigation.TabNavigation="None" />

                                <Image
                                    Name="AnprNumber"
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="2"
                                    Width="170"
                                    Height="100"
                                    HorizontalAlignment="Left"
                                    Opacity="1"
                                    Source="{Binding Base64ImageString, Converter={StaticResource Base64ToImageConverter}, FallbackValue={StaticResource DefaultImage}}" />


                            </Grid>
                            <Border
                                Height="2"
                                Margin="0,0,0,3"
                                Background="{DynamicResource AccentColorBrush}" />
                            <UniformGrid
                                Margin="15,0,15,0"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local"
                                Rows="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>


                                    <StackPanel
                                        x:Name="splAnprLabel"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,5,5,5"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                        <Label
                                            x:Name="lblAnprNo"
                                            Padding="0,5"
                                            Content="ANPR:" />
                                    </StackPanel>

                                    <Grid
                                        x:Name="grdAnpr"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            Name="txtAnpr"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,5,5,5"
                                            Text="{Binding AnprNumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />

                                        <Button
                                            x:Name="btnLeftAnpr"
                                            Grid.Column="1"
                                            Width="40"
                                            Height="28"
                                            Margin="0,5,5,5"
                                            VerticalAlignment="Center"
                                            Controls:ButtonHelper.PreserveTextCase="True"
                                            BorderBrush="{DynamicResource AccentColorBrush}"
                                            Content="Left"
                                            IsTabStop="False"
                                            PreviewMouseDown="btnLeftAnpr_PreviewMouseDown"
                                            Style="{DynamicResource mouseoverstyle}"
                                            Visibility="Visible" />
                                        <Button
                                            x:Name="btnRightAnpr"
                                            Grid.Column="2"
                                            Width="40"
                                            Height="28"
                                            Margin="0,5,5,5"
                                            VerticalAlignment="Center"
                                            Controls:ButtonHelper.PreserveTextCase="True"
                                            BorderBrush="{DynamicResource AccentColorBrush}"
                                            Content="Right"
                                            IsTabStop="False"
                                            PreviewMouseDown="btnRightAnpr_PreviewMouseDown"
                                            Style="{DynamicResource mouseoverstyle}"
                                            Visibility="Visible" />
                                    </Grid>

                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,5,5,5"
                                        Orientation="Horizontal">
                                        <Label
                                            x:Name="lblVehicalNo"
                                            Padding="0,5"
                                            Content="Vehicle:" />
                                        <Label
                                            x:Name="lblVehicleRequired"
