                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn
                                                            Width="130"
                                                            Binding="{Binding GrossTime, StringFormat={x:Static strFormat:Constant.DateTimeFormat}}"
                                                            Header="Gross Time"
                                                            IsReadOnly="True" />
                                                        <DataGridTemplateColumn
                                                            Width="70"
                                                            Header="Tare Wt"
                                                            IsReadOnly="True">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock>
                                                                        <Run Text="{Binding TareWeight, StringFormat={x:Static strFormat:Constant.DecimalFormat}}" />
                                                                        <Run Text="{Binding WeightUnit}" />
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn
                                                            Width="130"
                                                            Binding="{Binding TareTime, StringFormat={x:Static strFormat:Constant.DateTimeFormat}}"
                                                            Header="Tare Time"
                                                            IsReadOnly="True" />
                                                        <DataGridTemplateColumn
                                                            Width="70"
                                                            Header="Net Wt"
                                                            IsReadOnly="True">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock>
                                                                        <Run Text="{Binding NetWeight, Mode=OneWay, StringFormat={x:Static strFormat:Constant.DecimalFormat}}" />
                                                                        <Run Text="{Binding WeightUnit}" />
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <!--<DataGridTextColumn Header="Product"  Width="60" IsReadOnly="True" Binding="{Binding Product.ProductName}" />-->

                                                        <DataGridTemplateColumn Width="100" Header="Product">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>

                                                                    <ComboBox
                                                                        Margin="0,5,5,5"
                                                                        VerticalAlignment="Center"
                                                                        DisplayMemberPath="ProductName"
                                                                        IsEditable="True"
                                                                        IsTextSearchEnabled="True"
                                                                        ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                        LostFocus="cmbProduct_LostFocus"
                                                                        SelectedValue="{Binding ProductID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        SelectedValuePath="ProductID"
                                                                        Visibility="{Binding PreviousModel.ProductMaster, Converter={StaticResource NullToVisibilityConverter}}" />

                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Width="100" Header="Gate">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <ComboBox
                                                                        Margin="0,5,5,5"
                                                                        VerticalAlignment="Center"
                                                                        DisplayMemberPath="GateName"
                                                                        IsEditable="True"
                                                                        IsTextSearchEnabled="True"
                                                                        ItemsSource="{Binding DataContext.Gates, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                        LostFocus="cmbGate_LostFocus"
                                                                        SelectedValue="{Binding GateID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        SelectedValuePath="GateID"
                                                                        Visibility="{Binding PreviousModel.GateMaster, Converter={StaticResource NullToVisibilityConverter}}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn
                                                            Width="60"
                                                            Binding="{Binding UserMaster.UserName}"
                                                            Header="User"
                                                            IsReadOnly="True" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </csc:ScrollViewerEx>
                            </Border>
                        </TabItem>
                        <TabItem Header="Receipt Details" IsSelected="True">
                            <Border
                                Margin="0,-1,0,0"
                                Padding="5"
                                Background="{DynamicResource AccentColorBrush4}"
                                BorderBrush="{DynamicResource AccentColorBrush}"
                                BorderThickness="0,1,1,1"
                                KeyboardNavigation.TabNavigation="None">
                                <csc:ScrollViewerEx Foreground="{DynamicResource BlackBrush}" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Name="stkReceiptDetail">
                                        <csc:ScrollViewerEx Height="135" Foreground="{DynamicResource BlackBrush}">
                                            <Grid Name="gridReceiptDetail" Margin="10,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Grid.IsSharedSizeScope="True">
                                                    <Grid Name="gridReceiptMasterdetail">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition SharedSizeGroup="MasterLabelColumn" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Margin="0,0,10,0"
                                                            FontSize="15"
                                                            FontWeight="Bold"
                                                            Visibility="{Binding EditMode, Converter={StaticResource NegativeBooleanToVisibilityConverter}}">
                                                            Ticket No:
                                                        </TextBlock>
                                                        <TextBlock
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Padding="0,0,5,0"
                                                            FontSize="15"
                                                            Text="{Binding Model.TicketID}"
                                                            Validation.ErrorTemplate="{StaticResource SuppressValidationError}"
                                                            Visibility="{Binding EditMode, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                                                        <!--<TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" FontSize="15" FontWeight="Bold" Visibility="{Binding EditMode, Converter={StaticResource PositiveBooleanToVisibilityConverter}}">Last Ticket No:</TextBlock>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Padding="0,0,5,0" FontSize="15" Text="{Binding LastTicketID}" Visibility="{Binding EditMode, Converter={StaticResource PositiveBooleanToVisibilityConverter}}" Validation.ErrorTemplate="{StaticResource SuppressValidationError}"></TextBlock>-->
                                                        <Label
                                                            Grid.Row="1"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0"
                                                            Padding="0"
                                                            Content=" " />
                                                        <TextBlock
                                                            Grid.Row="2"
                                                            Grid.Column="0"
                                                            Margin="0,0,10,0"
                                                            FontWeight="Bold"
                                                            Visibility="{Binding Model.VehicleMaster, Converter={StaticResource NullToVisibilityConverter}}">
                                                            Vehicle No:
                                                        </TextBlock>
                                                        <StackPanel
                                                            Grid.Row="2"
                                                            Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Validation.ErrorTemplate="{StaticResource SuppressValidationError}"
                                                            Visibility="{Binding Model.VehicleMaster, Converter={StaticResource NullToVisibilityConverter}}">
                                                            <TextBlock Padding="0,0,5,0">
                                                                <Run Text="{Binding Model.Vehicle.VehicleNumber}" />
                                                            </TextBlock>
                                                            <TextBlock FontWeight="Medium" Visibility="{Binding Model.Vehicle.TareWeight, Converter={StaticResource NullToVisibilityConverter}}">
                                                                <Run Text="{Binding Model.Vehicle.TareWeight, StringFormat='{x:Static strFormat:Constant.TareWeightDecimal}'}" />
                                                                <!--  StringFormat='(Tare Wt: \{0:0.##}\)'  -->
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock
                                                            Grid.Row="3"
                                                            Grid.Column="0"
                                                            Margin="0,0,10,0"
                                                            FontWeight="Bold"
                                                            Visibility="{Binding Model.AccountMaster, Converter={StaticResource NullToVisibilityConverter}}">
                                                            Account:
                                                        </TextBlock>
                                                        <TextBlock
                                                            Grid.Row="3"
                                                            Grid.Column="1"
                                                            Padding="0,0,5,0"
                                                            Text="{Binding Model.Account.CompanyName}"
                                                            Validation.ErrorTemplate="{StaticResource SuppressValidationError}"
                                                            Visibility="{Binding Model.AccountMaster, Converter={StaticResource NullToVisibilityConverter}}" />
                                                        <TextBlock
                                                            Grid.Row="4"
                                                            Grid.Column="0"
                                                            Margin="0,0,10,0"
                                                            FontWeight="Bold"
                                                            Visibility="{Binding Model.TransporterMaster, Converter={StaticResource NullToVisibilityConverter}}">
                                                            Transaporter:
                                                        </TextBlock>
                                                        <TextBlock
                                                            Grid.Row="4"
                                                            Grid.Column="1"
                                                            Padding="0,0,5,0"
                                                            Text="{Binding Model.Transporter.CompanyName}"
                                                            Validation.ErrorTemplate="{StaticResource SuppressValidationError}"
                                                            Visibility="{Binding Model.TransporterMaster, Converter={StaticResource NullToVisibilityConverter}}" />
                                                        <TextBlock
                                                            Grid.Row="5"
                                                            Grid.Column="0"
                                                            Margin="0,0,10,0"
                                                            FontWeight="Bold"
                                                            Visibility="{Binding Model.DriverMaster, Converter={StaticResource NullToVisibilityConverter}}">
                                                            Driver:
                                                        </TextBlock>
                                                        <TextBlock
                                                            Grid.Row="5"
                                                            Grid.Column="1"
                                                            Padding="0,0,5,0"
                                                            Text="{Binding Model.Driver.DriverName}"
                                                            Validation.ErrorTemplate="{StaticResource SuppressValidationError}"
                                                            Visibility="{Binding Model.DriverMaster, Converter={StaticResource NullToVisibilityConverter}}" />
                                                        <!--<TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,10,0" FontWeight="Bold" Visibility="{Binding Model.RFIDTokenMaster, Converter={StaticResource NullToVisibilityConverter}}">RFID Token:</TextBlock>
                                                    <TextBlock Grid.Row="6" Grid.Column="1" Padding="0,0,5,0" Text="{Binding Model.RFToken.TokenValue}" Visibility="{Binding Model.RFIDTokenMaster, Converter={StaticResource NullToVisibilityConverter}}" Validation.ErrorTemplate="{StaticResource SuppressValidationError}"></TextBlock>-->
                                                        <TextBlock
                                                            Grid.Row="6"
                                                            Grid.Column="0"
                                                            Margin="0,0,10,0"
                                                            FontWeight="Bold"
                                                            Visibility="{Binding Model.ChargesMaster, Converter={StaticResource NullToVisibilityConverter}}">
                                                            Charges:
                                                        </TextBlock>
                                                        <TextBlock
                                                            Grid.Row="6"
                                                            Grid.Column="1"
                                                            Padding="0,0,5,0"
                                                            Text="{Binding Model.Charges}"
                                                            Validation.ErrorTemplate="{StaticResource SuppressValidationError}"
                                                            Visibility="{Binding Model.ChargesMaster, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    </Grid>
                                                    <!--  Show only if single/double pass transaction  -->
                                                    <Grid Visibility="{Binding Model.TransactionMode, Converter={StaticResource InEqualityVisibilityConverter}, ConverterParameter='Multi'}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition SharedSizeGroup="MasterLabelColumn" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Margin="0,0,10,0"
                                                            FontWeight="Bold"
                                                            Visibility="{Binding Model.ProductMaster, Converter={StaticResource NullToVisibilityConverter}}">
                                                            Product:
                                                        </TextBlock>
                                                        <TextBlock
                                                            Grid.Row="0"
                                                            Grid.Column="1"
                                                            Padding="0,0,5,0"
                                                            Text="{Binding Model.SummaryTransaction.Product.ProductName}"
                                                            Validation.ErrorTemplate="{StaticResource SuppressValidationError}"
                                                            Visibility="{Binding Model.ProductMaster, Converter={StaticResource NullToVisibilityConverter}}" />
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Margin="0,0,10,0"
                                                            FontWeight="Bold"
                                                            Visibility="{Binding Model.GateMaster, Converter={StaticResource NullToVisibilityConverter}}">
                                                            Gate:
                                                        </TextBlock>
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Padding="0,0,5,0"
                                                            Text="{Binding Model.SummaryTransaction.Gate.GateName}"
                                                            Validation.ErrorTemplate="{StaticResource SuppressValidationError}"
                                                            Visibility="{Binding Model.GateMaster, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="0,27,0,0"
                                                    HorizontalAlignment="Stretch">
                                                    <ItemsControl ItemsSource="{Binding Model.CustomValues}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Grid.IsSharedSizeScope="True" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition SharedSizeGroup="ColumnOne" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        Margin="0,0,10,0"
                                                                        FontWeight="Bold"
                                                                        Text="{Binding CustomField.DisplayName, StringFormat='\{0\}: '}" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Margin="0,0,5,0"
                                                                        Text="{Binding CustomValue1}"
                                                                        Validation.ErrorTemplate="{StaticResource SuppressValidationError}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </csc:ScrollViewerEx>
                                        <!--  show only if multi pass  -->
                                        <StackPanel Margin="10,15,10,0" Visibility="{Binding Model.TransactionMode, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Multi'}">
                                            <StackPanel Orientation="Vertical" Visibility="{Binding Model.ValidTransactionDetails, Converter={StaticResource ListToVisibilityConverter}}">
                                                <DataGrid
                                                    Name="dgPasses"
                                                    Margin="0,0,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Stretch"
                                                    AutoGenerateColumns="False"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource AccentColorBrush}"
                                                    BorderThickness="1,0,1,1"
                                                    CanUserAddRows="False"
                                                    CanUserDeleteRows="False"
                                                    CanUserSortColumns="False"
                                                    HorizontalScrollBarVisibility="Auto"
                                                    ItemsSource="{Binding Model.ValidTransactionDetails}"
                                                    VerticalScrollBarVisibility="Disabled">
                                                    <DataGrid.ColumnHeaderStyle>
                                                        <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                                            <Setter Property="Background" Value="{StaticResource AccentColorBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Margin" Value="0,0,0,0" />
                                                            <Setter Property="Padding" Value="2,3,2,3" />
                                                        </Style>
                                                    </DataGrid.ColumnHeaderStyle>
                                                    <DataGrid.RowStyle>
                                                        <Style BasedOn="{StaticResource MetroDataGridRow}" TargetType="{x:Type DataGridRow}">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGrid.RowStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn
                                                            Width="20"
                                                            Binding="{Binding SequenceNo}"
                                                            Header="#"
                                                            IsReadOnly="True" />
                                                        <DataGridTextColumn
                                                            Width="80"
                                                            Binding="{Binding WeightBridge.ScaleName}"
                                                            Header="Scale Name"
                                                            IsReadOnly="True" />
                                                        <DataGridTemplateColumn
                                                            Width="70"
                                                            Header="Gross Wt"
                                                            IsReadOnly="True">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock>
                                                                        <Run Text="{Binding GrossWeight, StringFormat={x:Static strFormat:Constant.DecimalFormat}}" />
                                                                        <Run Text="{Binding WeightUnit}" />
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn
                                                            Width="130"
                                                            Binding="{Binding GrossTime, StringFormat={x:Static strFormat:Constant.DateTimeFormat}}"
                                                            Header="Gross Time"
                                                            IsReadOnly="True" />
                                                        <DataGridTemplateColumn
                                                            Width="70"
                                                            Header="Tare Wt"
                                                            IsReadOnly="True">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock>
                                                                        <Run Text="{Binding TareWeight, StringFormat={x:Static strFormat:Constant.DecimalFormat}}" />
                                                                        <Run Text="{Binding WeightUnit}" />
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn
                                                            Width="130"
                                                            Binding="{Binding TareTime, StringFormat={x:Static strFormat:Constant.DateTimeFormat}}"
                                                            Header="Tare Time"
                                                            IsReadOnly="True" />
                                                        <DataGridTemplateColumn
                                                            Width="70"
                                                            Header="Net Wt"
                                                            IsReadOnly="True">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock>
                                                                        <Run Text="{Binding NetWeight, Mode=OneWay, StringFormat={x:Static strFormat:Constant.DecimalFormat}}" />
                                                                        <Run Text="{Binding WeightUnit}" />
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <!--<DataGridTextColumn Header="Product"  Width="60" IsReadOnly="True" Binding="{Binding Product.ProductName}" />-->

                                                        <DataGridTemplateColumn Width="100" Header="Product">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>

                                                                    <ComboBox
                                                                        Margin="0,5,5,5"
                                                                        VerticalAlignment="Center"
                                                                        DisplayMemberPath="ProductName"
                                                                        IsEditable="True"
                                                                        IsTextSearchEnabled="True"
                                                                        ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                        LostFocus="cmbProduct_LostFocus"
                                                                        SelectedValue="{Binding ProductID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        SelectedValuePath="ProductID"
                                                                        Visibility="{Binding Model.ProductMaster, Converter={StaticResource NullToVisibilityConverter}}" />

                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Width="100" Header="Gate">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <ComboBox
                                                                        Margin="0,5,5,5"
                                                                        VerticalAlignment="Center"
                                                                        DisplayMemberPath="GateName"
                                                                        IsEditable="True"
                                                                        IsTextSearchEnabled="True"
                                                                        ItemsSource="{Binding DataContext.Gates, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                        LostFocus="cmbGate_LostFocus"
                                                                        SelectedValue="{Binding GateID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        SelectedValuePath="GateID"
                                                                        Visibility="{Binding Model.GateMaster, Converter={StaticResource NullToVisibilityConverter}}" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn
                                                            Width="60"
                                                            Binding="{Binding UserMaster.UserName}"
                                                            Header="User"
                                                            IsReadOnly="True" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                </csc:ScrollViewerEx>
                            </Border>
                        </TabItem>

                        <TabItem Header="Captured Images">
                            <Border
                                Margin="0,-1,0,0"
                                Padding="5"
                                Background="{DynamicResource AccentColorBrush4}"
                                BorderBrush="{DynamicResource AccentColorBrush}"
                                BorderThickness="0,1,1,1">
                                <csc:ScrollViewerEx HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ListBox
                                        Name="lstboxCapturedImages"
                                        Background="Transparent"
                                        ItemsSource="{Binding lstCamImage}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel
                                                    Margin="0,0,0,0"
                                                    Background="Transparent"
                                                    Orientation="Horizontal" />
                                                <!--  Width="480"  -->
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Image
                                                    Name="ListBoxCaptureImages"
                                                    Width="130"
                                                    Margin="10"
                                                    HorizontalAlignment="Left"
                                                    Opacity="1"
                                                    Source="{Binding CameraImagePath, Converter={StaticResource CameraImagePathConverter}, FallbackValue={StaticResource DefaultImage}}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </csc:ScrollViewerEx>
                            </Border>
                        </TabItem>

                    </TabControl>
                </DockPanel>

            </Grid>
        </DockPanel>
    </DockPanel>
</Page>