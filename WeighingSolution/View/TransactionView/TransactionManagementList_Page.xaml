<Page x:Class="WeighingSolution.View.TransactionManagementList_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:userControls="clr-namespace:WeighingSolution.UserControls"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      xmlns:shared="clr-namespace:WeighingSolution.SharedComponents;assembly=WeighingSolution.SharedComponents"
      xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="700" d:DesignWidth="1200"
	Title="Transaction Management">
    <Page.InputBindings>
        <KeyBinding Gesture="F3" Command="{Binding ViewReceipt}"></KeyBinding>
    </Page.InputBindings>
    <Page.Resources>
        <converter:EqualityVisibilityConverter x:Key="EqualityVisibilityConverter" />
        <converter:InEqualityVisibilityConverter x:Key="InEqualityVisibilityConverter" />
    </Page.Resources>
    <Grid Name="rootGrid" Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,0" >
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource TransactionIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25" VerticalAlignment="Center">
                          <Run FontWeight="Bold"  FontSize="25" Text="Transaction" />
                         Management
                    </TextBlock>
                   
                    <StackPanel Orientation="Horizontal"  HorizontalAlignment="Right" Margin="0,8,20,5">

                        <Label Margin="0,0,10,0" >Search by Ticket</Label>
                        <CheckBox  Name="cbSearchByTicket" Margin="0,0,10,0"  IsChecked="{Binding IsSearchByTicket,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        
                        <TextBox  Name="txtsearch" Width="300" Margin="0,0,0,0"  BorderBrush="{DynamicResource AccentColorBrush}" Padding="5,5,5,5" ToolTip="Search" Text="{Binding SearchString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MetroTextBox}" >
                                    <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="True"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="Controls:TextBoxHelper.HasText" Value="false" >
                                            <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="False" />
                                            <Setter Property="Controls:TextBoxHelper.Watermark"  Value="Search Record" />
                                        </Trigger>
                                        <Trigger Property="Controls:TextBoxHelper.HasText"   Value="True">
                                            <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="True" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Name="btnSearch" IsDefault="True" HorizontalAlignment="Left" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="34" Width="34"  Margin="0,0,20,0" Command="{Binding FilterData}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="search" Margin="0,2,0,0"  Height="14" Width="14" />
                            </StackPanel>
                        </Button>

                        <Button Name="btnprint" HorizontalAlignment="Right" Content="print" Visibility="Collapsed"
                            Style="{DynamicResource  mouseoverstyle}" Click="btnprint_Click_1"
                                BorderBrush="{DynamicResource AccentColorBrush}" Height="34" Width="50"  Margin="0,0,20,0">
                        </Button>

                        <TextBlock Visibility="Collapsed" Name="txtbAddTransaction" Margin="0,0,20,0" FontWeight="Bold" HorizontalAlignment="Right">
                            <Button Name="btnCreateTransaction" Click="btnCreateTransaction_Click" Controls:ButtonHelper.PreserveTextCase="True" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Padding="20,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="PlusCircle"  Margin="0,1,2,0"  Height="14" Width="14" />
                                    <TextBlock>CREATE TRANSACTION</TextBlock>
                                </StackPanel>
                            </Button>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Name="stkContainer" Orientation="Vertical">
                    <TabControl BorderThickness="0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Margin="0,10,0,0" SelectedItem="{Binding SelectedTabItem}">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Grid Name="Panel">
                                                <Border Name="Border" CornerRadius="3,3,0,0" Padding="15,6" Margin="10,0,0,0" BorderBrush="{DynamicResource AccentColorBrush}">
                                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" />
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentColorBrush}" />
                                                    <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="{StaticResource BlackBrush}" />
                                                    <Setter Property="BorderThickness" Value="1"  TargetName="Border"></Setter>
                                                    <Setter Property="TextElement.FontWeight" Value="Normal" TargetName="ContentSite"></Setter>
                                                    <Setter Property="TextElement.FontSize" Value="13" TargetName="ContentSite"></Setter>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="False">
                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentColorBrush4}" />
                                                    <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="{StaticResource BlackBrush}" />
                                                    <Setter Property="BorderThickness" Value="0"  TargetName="Border"></Setter>
                                                    <Setter Property="TextElement.FontWeight" Value="Normal" TargetName="ContentSite"></Setter>
                                                    <Setter Property="TextElement.FontSize" Value="13" TargetName="ContentSite"></Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        <TabItem Header="Active Transaction" Margin="0,0,0,0" Tag="Active" Height="31" VerticalAlignment="Top">
                        </TabItem>
                        <TabItem Header="Completed Transaction" Margin="0,0,0,0" Tag="Complete">
                        </TabItem>
                        <TabItem Header="Void Transaction" Margin="0,0,0,0" Tag="Void">
                        </TabItem>
                    </TabControl>
                    <DataGrid Name="DatagridTransactionManagement" CanUserDeleteRows="False" AutoGenerateColumns="False"  ItemsSource="{Binding ViewList}" 
                              Background="{StaticResource AccentColorBrush}" Margin="5,-4,5,0" 
                              HorizontalAlignment="Stretch" CanUserAddRows="False" ScrollViewer.CanContentScroll="True" VerticalScrollBarVisibility="Auto" 
                              VerticalAlignment="Stretch" SelectedItem="{Binding SelectedTransaction}">
                        <DataGrid.Resources>
                            <shared:BindingProxy x:Key="proxy" Data="{Binding}" />
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"  >
                                <Setter Property="Background" Value="{StaticResource AccentColorBrush}"/>
                                <Setter Property="Height" Value="35"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                <Setter Property="Margin" Value="4,0,0,0"></Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowHeaderTemplate>
                            <DataTemplate>
                                <Expander Expanded="Expander_Toggle" Collapsed="Expander_Toggle" >
                                </Expander>
                            </DataTemplate>
                        </DataGrid.RowHeaderTemplate>

                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border CornerRadius="1" BorderBrush="{StaticResource AccentColorBrush}" Background="White" BorderThickness="2" DockPanel.Dock="Top">
                                    <StackPanel Orientation="Vertical" Background="White" Margin="10,5,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="300" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="400" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Product :" Foreground="Black" FontWeight="Bold" Grid.Column="0"  Grid.Row="0" />
                                            <TextBlock Text="{Binding TransactionProducts}"  Foreground="Black" Grid.Column="1" Grid.Row="0" />

                                            <TextBlock Text="Transporter :" Foreground="Black" FontWeight="Bold" Grid.Column="0"  Grid.Row="1" />
                                            <TextBlock Text="{Binding Transporter_Name}"  Foreground="Black" Grid.Column="1"  Grid.Row="1" />

                                            <TextBlock Text="Account :" Foreground="Black" FontWeight="Bold" Grid.Column="0"  Grid.Row="2" />
                                            <TextBlock Text="{Binding Account_Name}"  Foreground="Black" Grid.Column="1"  Grid.Row="2" />

                                            <TextBlock Text="Transaction Mode :" Foreground="Black" FontWeight="Bold" Grid.Column="2"  Grid.Row="0" />
                                            <TextBlock Text="{Binding TransactionMode}"  Foreground="Black" Grid.Column="3"  Grid.Row="0" />

                                            <TextBlock Text="Transaction Type :" Foreground="Black" FontWeight="Bold"  Grid.Column="2"  Grid.Row="1" />
                                            <TextBlock Text="{Binding TransactionType}"  Foreground="Black" Grid.Column="3" Grid.Row="1" />

                                            <TextBlock Text="Charges :" Foreground="Black" Grid.Column="2" FontWeight="Bold"  Grid.Row="2" />
                                            <TextBlock Text="{Binding Charges}"  Foreground="Black" Grid.Column="3"  Grid.Row="2" />

                                            <TextBlock Text="Scale Name :" Foreground="Black" FontWeight="Bold"  Grid.Column="4"  Grid.Row="0" />
                                            <TextBlock Text="{Binding WeightBridgeName}"  Foreground="Black" Grid.Column="5" Grid.Row="0" />

                                            <TextBlock Text="Driver :" Foreground="Black" FontWeight="Bold" Grid.Column="4"  Grid.Row="1" />
                                            <TextBlock Text="{Binding Driver.FirstName}"  Foreground="Black" Grid.Column="5"  Grid.Row="1" />

                                            <TextBlock Text="Gate :" Foreground="Black" Grid.Column="4" FontWeight="Bold"  Grid.Row="2" />
                                            <TextBlock Text="{Binding GateNameForListPage}"  Foreground="Black" Grid.Column="5"  Grid.Row="2" />

                                            <StackPanel Grid.Column="6" Grid.Row="0" Grid.RowSpan="20" Orientation="Horizontal">
                                                <ItemsControl ItemsSource="{Binding CustomFieldViewModels}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Grid.IsSharedSizeScope="True"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition SharedSizeGroup="ColumnOne" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Foreground="Black" Grid.Column="0" FontWeight="Bold" Text="{Binding DisplayName, StringFormat='{}{0}: '}" Margin="0,0,10,0"></TextBlock>                                                                
                                                                <TextBlock Foreground="Black" Grid.Column="1" Text="{Binding CustomValue}" Margin="0,0,5,0" Validation.ErrorTemplate="{StaticResource 
                                                                    SuppressValidationError}"></TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                        </Grid>
                                    </StackPanel>
                                </Border>


                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Transaction Title" MinWidth="350" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="Ticket No: "/>
                                            <Run Text="{Binding TicketID, Mode=OneWay}" FontWeight="Medium" FontSize="14"/>
                                            <Run Text=" Vehicle No: "/>
                                            <Run Text="{Binding Vehicle_Number, Mode=OneWay}" FontWeight="Medium" FontSize="14"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="1*"
                                MinWidth="150"
                                Binding="{Binding TokenName}"
                                Header="Token Name"
                                IsReadOnly="True" />
                            <DataGridTextColumn Header="Products" MinWidth="150" Width="1*" IsReadOnly="True" Binding="{Binding TransactionProducts}" />

                            <DataGridTextColumn Header="Transaction Time" Visibility="{Binding Data.SelectedTabItem.Tag, Source={StaticResource proxy}, Converter={StaticResource 
                                EqualityVisibilityConverter}, ConverterParameter='Active'}" MinWidth="120" Width="150" IsReadOnly="True" Binding="{Binding CreationTimestringForListPage}" />
                            
                            <DataGridTextColumn Header="Last Weighment" Visibility="{Binding Data.SelectedTabItem.Tag, Source={StaticResource proxy}, Converter={StaticResource 
                                EqualityVisibilityConverter}, ConverterParameter='Active'}" MinWidth="150" Width="150" IsReadOnly="True" Binding="{Binding LastWeighment}" />

                            <!--<DataGridTextColumn Header="Tare Weight" MinWidth="150" Width="150" Visibility="{Binding Data.SelectedTabItem.Tag, Source={StaticResource proxy}, 
                                Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Complete'}" IsReadOnly="True" Binding="{Binding CompeletedTareWeight}">
                            </DataGridTextColumn>-->
                            
                            
                            <DataGridTemplateColumn Header="Tare" MinWidth="200" Width="250" Visibility="{Binding Data.SelectedTabItem.Tag, Source={StaticResource proxy}, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Complete'}" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding CompeletedTareWeight, Mode=OneWay}" FontWeight="Bold" FontSize="14"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding CompeletedTareTime, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!--<DataGridTextColumn Header="Gross Weight" MinWidth="150" Width="150" Visibility="{Binding Data.SelectedTabItem.Tag, Source={StaticResource proxy}, 
                                Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Complete'}" IsReadOnly="True" Binding="{Binding CompeletedGrossWeight}">
                            </DataGridTextColumn>-->
                            
                            <DataGridTemplateColumn Header="Gross" MinWidth="200" Width="250" Visibility="{Binding Data.SelectedTabItem.Tag, Source={StaticResource proxy}, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Complete'}" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding CompeletedGrossWeight,  Mode=OneWay}" FontWeight="Bold" FontSize="14"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding CompeletedGrossTime, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Net Weight" MinWidth="130" Width="130" Visibility="{Binding Data.SelectedTabItem.Tag, Source={StaticResource proxy}, 
                                Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Complete'}" IsReadOnly="True" Binding="{Binding CompeletedNetWeight}" FontSize="15" FontWeight="Bold">
                            </DataGridTextColumn>
                            <!--<DataGridTemplateColumn Header="Net Weight" MinWidth="150" Width="150" Visibility="{Binding Data.SelectedTabItem.Tag, Source={StaticResource proxy}, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Complete'}" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding CompeletedNetWeight, StringFormat={x:Static strFormat:Constant.DecimalFormat}}" />
                                        <Run Text="{Binding CompeletedWeightUnit}" />
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->
                            <!--<DataGridTextColumn Header="RFID Token"  Width="100" MinWidth="100" IsReadOnly="True" Binding="{Binding RFToken.TokenValue}" />-->
                            
                            <!--<DataGridTextColumn Header="Transaction Mode" MinWidth="100"  Width="120" IsReadOnly="True" Binding="{Binding TransactionMode}" />-->
                            <!--<DataGridTextColumn Header="Status" MinWidth="100" Width="100" IsReadOnly="True" Binding="{Binding Status}" />-->
                            <DataGridTemplateColumn Header="Edit" MinWidth="80" Width="80" Visibility="{Binding Data.EditVisible, Source={StaticResource proxy}, 
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" ToolTip="Edit">
                                            <Hyperlink  CommandParameter="{Binding}" Name="btnEditTransactionManagement" TextDecorations="none" FontWeight="Bold"
                                                        Command="{Binding DataContext.EditTransaction, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                <StackPanel Orientation="Horizontal">
                                                  <!--<Image Height="20" Width="20" Source="/Images/edit.png"></Image>-->
                                                    <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" Margin="0,0,0,0">
                                                        <Rectangle.OpacityMask>
                                                            <VisualBrush Stretch="Uniform" Visual="{StaticResource EditLinkIcon}" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>    
                                                  <TextBlock Foreground="{DynamicResource BlackBrush}" Text="Edit" Margin="5,0,0,0" ></TextBlock>
                                                 </StackPanel>
                                            </Hyperlink>    
                                    </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Void" Width="80" MinWidth="80" Visibility="{Binding Data.VoidVisible, Source={StaticResource proxy}, 
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <Hyperlink  CommandParameter="{Binding}" Name="btnVoidCurrentTransaction" TextDecorations="none" FontWeight="Bold"
                                                        Command="{Binding DataContext.VoidTransaction, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                <StackPanel Orientation="Horizontal">
                                                  <!--<Image Height="20" Width="20" Source="/Images/void.png"></Image>-->
                                                    <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" Margin="0,0,0,0">
                                                        <Rectangle.OpacityMask>
                                                            <VisualBrush Stretch="Uniform" Visual="{StaticResource VoidLinkIcon}" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>  
                                                  <TextBlock Foreground="{DynamicResource BlackBrush}" Text="Void" Margin="5,0,0,0" ></TextBlock>
                                                 </StackPanel>
                                            </Hyperlink>   
                                    </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="View (F3)" Width="80" MinWidth="80" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                                 <Hyperlink  CommandParameter="{Binding Path=ReceiptTicketID}" Click="btnViewDetail_Click" TextDecorations="none" FontWeight="Bold">
                                                <StackPanel Orientation="Horizontal">
                                                  <!--<Image Height="20" Width="20" Source="/Images/view.png"></Image>-->
                                                    <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" Margin="0,0,0,0">
                                                        <Rectangle.OpacityMask>
                                                            <VisualBrush Stretch="Uniform" Visual="{StaticResource ViewLinkIcon}" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>  
                                                  <TextBlock Foreground="{DynamicResource BlackBrush}" Text="View" Margin="5,0,0,0" ></TextBlock>
                                                 </StackPanel>
                                            </Hyperlink>   
                                    </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" Visibility="{Binding HasData,Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                        <TextBlock Name="txtmsg" FontSize="20" Opacity="0.5" Margin="5,5,5,5" >No Record Exist</TextBlock>
                    </StackPanel>
                    <userControls:PaginationElements x:Name="ucPager" Visibility="{Binding HasData,Converter={StaticResource NegativeBooleanToVisibilityConverter}}" Loaded="ucPager_Loaded" />
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
    </Grid>
</Page>