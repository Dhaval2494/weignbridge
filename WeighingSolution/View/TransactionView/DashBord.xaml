<Page
    x:Class="WeighingSolution.View.DashBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DashBoard"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    FocusManager.IsFocusScope="True"
    Style="{DynamicResource MetroPage}"
    mc:Ignorable="d">
    <Page.Resources>
        <converter:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converter:ListToVisibilityConverter x:Key="ListToVisibilityConverter" />
        <converter:WeightVisibilityConverter x:Key="WeightVisibilityConverter" />
        <converter:EqualityVisibilityConverter x:Key="EqualityVisibilityConverter" />
        <converter:InEqualityVisibilityConverter x:Key="InEqualityVisibilityConverter" />
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converter:EqualityConverter x:Key="EqualityConverter" />
        <converter:InEqualityConverter x:Key="InEqualityConverter" />
    </Page.Resources>
    <DockPanel Background="{DynamicResource WhiteBrush}" KeyboardNavigation.TabNavigation="Cycle">
        <DockPanel
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource AccentColorBrush4}"
            DockPanel.Dock="Right"
            LastChildFill="True">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.Background>
                        <ImageBrush ImageSource="/Images/weighbridge_1.png" Stretch="Fill" />
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="10"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="red"
                        Text="{Binding Displayrfidleft}" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="4"
                        Grid.ColumnSpan="6"
                        Margin="10"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="red"
                        Text="{Binding Displayrfidright}" />
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,10"
                        Padding="10"
                        Background="Transparent"
                        BorderBrush="Black"
                        BorderThickness="1">
                        <TextBox
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="{Binding ColorVehicle}"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="Yellow"
                            Text="{Binding DisplayVehicle}" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="3"
                        Grid.ColumnSpan="5"
                        Margin="05,0,0,10"
                        Padding="10"
                        Background="Transparent"
                        BorderBrush="Black"
                        BorderThickness="1">
                        <TextBox
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Black"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="Yellow"
                            Text="{Binding Display_Massag}" />
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Width="300"
                        Padding="10"
                        Background="Transparent"
                        BorderBrush="Black"
                        BorderThickness="1">
                        <TextBox
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="{Binding Displaycolor}"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="Yellow"
                            Text="{Binding DisplayWeight}" />
                    </Border>
                    <Image
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Width="81"
                        Margin="10,5.4,0,67"
                        HorizontalAlignment="Left"
                        Source="/Images/scane_RFID_left.png"
                        Visibility="{Binding IsUHFLeft, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                    <Image
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Width="81"
                        Margin="52,5.4,0,67"
                        HorizontalAlignment="Left"
                        Source="/Images/RFID_L.png"
                        Visibility="{Binding IsUHFLeft, Converter={StaticResource PositiveBooleanToVisibilityConverter}}" />

                    <Image
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,5.4,0.4,66"
                        HorizontalAlignment="Right"
                        Source="/Images/green light.png"
                        Visibility="{Binding IsTLeft, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                    <Image
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,2.6,0.8,68.6"
                        HorizontalAlignment="Right"
                        Source="/Images/red light.png"
                        Visibility="{Binding IsTLeft, Converter={StaticResource PositiveBooleanToVisibilityConverter}}" />

                    <Image
                        Grid.Row="3"
                        Grid.Column="2"
                        Width="53"
                        Height="130"
                        Margin="0,0,0,25"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Source="/Images/boom barrier close_L.png"
                        Visibility="{Binding IsBoomLeft, Converter={StaticResource PositiveBooleanToVisibilityConverter}}" />
                    <Image
                        Grid.Row="3"
                        Grid.Column="2"
                        Width="53"
                        Height="130"
                        Margin="0,0,0,50"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Source="/Images/boom barrier open_L.png"
                        Visibility="{Binding IsBoomLeft, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                    <Grid Grid.Row="3" Grid.Column="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="156*" />
                            <RowDefinition Height="95*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Width="100"
                            Height="250"
                            Margin="-7,0,21.4,0.4"
                            Source="/Images/position sensor red.png"
                            Visibility="{Binding IsSensore1, Converter={StaticResource PositiveBooleanToVisibilityConverter}}" />
                        <Image
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Width="100"
                            Height="250"
                            Margin="-7,0,21.4,0.4"
                            Source="/Images/position sensor green.png"
                            Visibility="{Binding IsSensore1, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                        <Image
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="4"
                            Width="100"
                            Height="250"
                            Margin="33.2,0,-18.8,0.4"
                            Source="/Images/position sensor red.png"
                            Visibility="{Binding IsSensore3, Converter={StaticResource PositiveBooleanToVisibilityConverter}}" />
                        <Image
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="4"
                            Width="100"
                            Height="250"
                            Margin="31.2,0,-16.8,0.4"
                            Source="/Images/position sensor green.png"
                            Visibility="{Binding IsSensore3, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                    </Grid>
                    <Image
                        Grid.Row="3"
                        Grid.Column="4"
                        Width="53"
                        Height="130"
                        Margin="0,0,0,25"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Source="/Images/boom barrier close_R.png"
                        Visibility="{Binding IsBoomRight, Converter={StaticResource PositiveBooleanToVisibilityConverter}}" />
                    <Image
                        Grid.Row="3"
                        Grid.Column="4"
                        Width="53"
                        Height="130"
                        Margin="0,0,25,50"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Source="/Images/boom barrier open_L.png"
                        Visibility="{Binding IsBoomRight, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                    <Image
                        Grid.Row="3"
                        Grid.Column="4"
                        Grid.ColumnSpan="2"
                        Margin="24.2,5.6,47.067,65.6"
                        Source="/Images/red light.png"
                        Visibility="{Binding IsTRight, Converter={StaticResource PositiveBooleanToVisibilityConverter}}" />
                    <Image
                        Grid.Row="3"
                        Grid.Column="4"
                        Grid.ColumnSpan="2"
                        Margin="24.2,5.6,47.067,65.6"
                        Source="/Images/green light.png"
                        Visibility="{Binding IsTRight, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                    <Image
                        Grid.Row="3"
                        Grid.Column="6"
                        Margin="0.2,4.4,0,67"
                        Source="/Images/_scanRFID_Right.png"
                        Visibility="{Binding IsUHFRight, Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                    <Image
                        Grid.Row="3"
                        Grid.Column="5"
                        Grid.ColumnSpan="2"
                        Margin="51.2,4.4,21,67"
                        Source="/Images/RFID_R.png"
                        Visibility="{Binding IsUHFRight, Converter={StaticResource PositiveBooleanToVisibilityConverter}}" />

                    <Image
                        x:Name="Right_TImg_Card_Tap"
                        Grid.Row="3"
                        Grid.Column="6"
                        Grid.ColumnSpan="7"
                        Width="300"
                        Height="250"
                        Margin="0,0,0,-40"
                        Source="/Images/Truck002.png"
                        Visibility="{Binding Right_TImg_Card_Tap}" />
                    <Image
                        x:Name="Right_TImg_WT_Start"
                        Grid.Row="3"
                        Grid.Column="2"
                        Grid.ColumnSpan="4"
                        Width="300"
                        Height="250"
                        Margin="-70,0,0,-40"
                        Source="/Images/Truck002.png"
                        Visibility="{Binding Right_TImg_WT_Start}" />
                    <Image
                        x:Name="Right_TImg_S3_Cut"
                        Grid.Row="3"
                        Grid.Column="4"
                        Grid.ColumnSpan="4"
                        Width="300"
                        Height="250"
                        Margin="-150,0,0,-40"
                        Source="/Images/Truck002.png"
                        Visibility="{Binding Right_TImg_S3_Cut}" />
                    <Image
                        x:Name="Right_TImg_S2_UnCut"
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Width="300"
                        Height="250"
                        Margin="0,0,0,-40"
                        Source="/Images/Truck002.png"
                        Visibility="{Binding Right_TImg_S2_UnCut}" />

                    <Image
                        x:Name="Right_TImg_S2_Cut"
                        Grid.Row="3"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Width="300"
                        Height="250"
                        Margin="-200,0,0,-40"
                        Source="/Images/Truck002.png"
                        Visibility="{Binding Right_TImg_S2_Cut}" />

                    <Image
                        x:Name="Left_TImg_Card_Tap"
                        Grid.Row="3"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Width="300"
                        Height="250"
                        Margin="-100,20.4,25.2,40"
                        Source="/Images/Truck001.png"
                        Visibility="{Binding Left_TImg_Card_Tap}" />
                    <!--  Visibility="{Binding IsUHFLeft, Converter={StaticResource NegativeBooleanToVisibilityConverter}}"  -->
                    <Image
                        x:Name="Left_TImg_S2_Cut"
                        Grid.Row="3"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Width="300"
                        Margin="32,30.4,382.4,60"
                        Source="/Images/Truck001.png"
                        Visibility="{Binding Left_TImg_S2_Cut}" />

                    <Image
                        x:Name="Left_TImg_WT_Start"
                        Grid.Row="3"
                        Grid.Column="2"
                        Grid.ColumnSpan="4"
                        Width="300"
                        Height="250"
                        Margin="-70,0,0,-40"
                        Source="/Images/Truck001.png"
                        Visibility="{Binding Left_TImg_WT_Start}" />

                    <Image
                        x:Name="Left_TImg_S3_Cut"
                        Grid.Row="3"
                        Grid.Column="3"
                        Grid.ColumnSpan="7"
                        Width="300"
                        Height="250"
                        Margin="150,0,0,-40"
                        Source="/Images/Truck001.png"
                        Visibility="{Binding Left_TImg_S3_Cut}" />

                    <Image
                        x:Name="Left_TImg_S3_UnCut"
                        Grid.Row="3"
                        Grid.Column="4"
                        Grid.ColumnSpan="7"
                        Width="300"
                        Height="250"
                        Margin="0,0,0,-40"
                        Source="/Images/Truck001.png"
                        Visibility="{Binding Left_TImg_S3_UnCut}" />

                </Grid>


            </Grid>
        </DockPanel>
    </DockPanel>
</Page>