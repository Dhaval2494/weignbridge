<simpleChildWindow:ChildWindow x:Class="UnmannedPlugin.ChangeStatusWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:simpleChildWindow="clr-namespace:MahApps.Metro.SimpleChildWindow;assembly=MahApps.Metro.SimpleChildWindow"       
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      d:DesignHeight="300"
                      d:DesignWidth="300"
                      mc:Ignorable="d"
                     CloseByEscape="False"  AllowMove="True" BorderBrush="{DynamicResource AccentBaseColorBrush}" BorderThickness="1" GlowBrush="{DynamicResource AccentColorBrush}"
                     ShowCloseButton="False" HorizontalContentAlignment="Center" IsModal="True" VerticalContentAlignment="Center" EnableDropShadow="False"	Title="ChangeTokenStatus">
    <simpleChildWindow:ChildWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="Dictionary1.xaml"/>-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </simpleChildWindow:ChildWindow.Resources>
    <simpleChildWindow:ChildWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Margin="4" TextTrimming="CharacterEllipsis" Text="Change Token Status" FontFamily="Arial" FontWeight="Bold"/>
        </DataTemplate>
    </simpleChildWindow:ChildWindow.TitleTemplate>
    <simpleChildWindow:ChildWindow.OverlayBrush>
        <SolidColorBrush Opacity="0.7" Color="{StaticResource BlackColor}" />
    </simpleChildWindow:ChildWindow.OverlayBrush>
    <StackPanel Background="{DynamicResource WhiteBrush}" MinWidth="450px" HorizontalAlignment="Stretch" Orientation="Horizontal" Margin="10,10,10,10" >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Name="lblPrevToken" Grid.Row="0" Grid.Column="0" Content=" Token Status" ></Label>
            <ComboBox Name="Cmbtokenstatus" Grid.Row="0" Grid.Column="1" Width="250px" Margin="10,0,5,5" Padding="5">
                <ComboBoxItem Content="Allocate" Tag="Allocate"></ComboBoxItem>
                <ComboBoxItem Content="Free" Tag="Free"></ComboBoxItem>
            </ComboBox>
            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Content="Change Token status" Controls:ButtonHelper.PreserveTextCase="True"  Name="btnChangeTokenstatus" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Width="150" Margin="20,0,0,5" Padding="5" Click="btnChangeTokenstatus_Click" ></Button>
        </Grid>
    </StackPanel>
</simpleChildWindow:ChildWindow>