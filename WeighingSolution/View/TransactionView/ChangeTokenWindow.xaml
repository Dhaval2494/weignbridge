<simpleChildWindow:ChildWindow 
      x:Class="UnmannedPlugin.ChangeTokenWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:simpleChildWindow="clr-namespace:MahApps.Metro.SimpleChildWindow;assembly=MahApps.Metro.SimpleChildWindow"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300"
      CloseByEscape="True"  AllowMove="True" BorderBrush="{DynamicResource AccentBaseColorBrush}" BorderThickness="1" GlowBrush="{DynamicResource AccentColorBrush}"
      ShowCloseButton="True" HorizontalContentAlignment="Center" IsModal="True" VerticalContentAlignment="Center" EnableDropShadow="False"	Title="ChangeToken">
    <simpleChildWindow:ChildWindow.Resources>
        <!--<ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Dictionary1.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>-->
    </simpleChildWindow:ChildWindow.Resources>
    <simpleChildWindow:ChildWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Margin="4" TextTrimming="CharacterEllipsis" Text="Change Token" FontFamily="Arial" FontWeight="Bold"/>
        </DataTemplate>
    </simpleChildWindow:ChildWindow.TitleTemplate>
    <simpleChildWindow:ChildWindow.OverlayBrush>
        <SolidColorBrush Opacity="0.7" Color="{StaticResource BlackColor}" />
    </simpleChildWindow:ChildWindow.OverlayBrush>

    <StackPanel Background="{DynamicResource WhiteBrush}" MinWidth="450px" HorizontalAlignment="Stretch" Orientation="Horizontal" Margin="10,10,10,10" >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <Label Name="lblToken" Content="New Token"></Label>
                <Label Foreground="Red">*</Label>
            </StackPanel>
            <ComboBox Name="CmbToken" Grid.Row="0" Grid.Column="1" Width="250px"  Margin="10,0,5,5"  IsTextSearchEnabled="True" IsEditable="True" ItemsSource="{Binding Tokens}" SelectedValuePath="TokenID"  SelectedValue="{Binding NewToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="TokenName"></ComboBox>
            <StackPanel Grid.Row="1" Grid.Column="0"  Orientation="Horizontal">
                <Label Name="lblPrevToken" Content="Previous Token Status" ></Label>
                <Label Foreground="Red">*</Label>
            </StackPanel>
            <ComboBox Name="Cmbtokenstatus" Grid.Row="1" Grid.Column="1" Width="250px" SelectedValue="{Binding Model.Token.TokenStatus,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Margin="10,0,5,5" Padding="5" SelectedValuePath="Tag" >
                <ComboBoxItem Content="Free" Tag="Free"></ComboBoxItem>
                <ComboBoxItem Content="Disable" Tag="Disable"></ComboBoxItem>
            </ComboBox>
            <StackPanel Grid.Row="2" Grid.Column="0"  Orientation="Horizontal">
                <Label Name="lblChangeTokenreason" Content="Change Token reason"></Label>
                <Label Foreground="Red">*</Label>
            </StackPanel>
            <TextBox AcceptsReturn="True" Grid.Row="2" Grid.Column="1" Margin="10,0,5,5" Height="45" Text="{Binding Model.CancelReason,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ></TextBox>
            <Button Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" IsDefault="True" Content="Change Token (Enter)" Controls:ButtonHelper.PreserveTextCase="True"  Name="btnChangeToken" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Width="150" Margin="20,0,0,5" Padding="5" Command="{Binding SaveChangeTokenCommand}"></Button>
        </Grid>
    </StackPanel>
</simpleChildWindow:ChildWindow>
