                                        <Label Name="lblField12" VerticalAlignment="Center"  Grid.Row="11" Grid.Column="4" ></Label>
                                        <csc:FilteredTextbox Name="txtField12" Text="F12" Margin="0,2,30,2" Grid.Row="11" Grid.Column="5" ></csc:FilteredTextbox>

                                        <CheckBox Name="cbField13" HorizontalAlignment="Right" Grid.Row="12"  Grid.Column="0" ></CheckBox>
                                        <Label Name="lblField13" VerticalAlignment="Center"  Grid.Row="12" Grid.Column="1" ></Label>
                                        <csc:FilteredTextbox Name="txtField13" Text="F13" Margin="0,2,30,2" Grid.Row="12" Grid.Column="2" ></csc:FilteredTextbox>

                                        <CheckBox Name="cbField14" HorizontalAlignment="Right" Grid.Row="12"  Grid.Column="3" ></CheckBox>
                                        <Label Name="lblField14" VerticalAlignment="Center"  Grid.Row="12" Grid.Column="4" ></Label>
                                        <csc:FilteredTextbox Name="txtField14" Text="F14" Margin="0,2,30,2" Grid.Row="12" Grid.Column="5" ></csc:FilteredTextbox>

                                        <CheckBox Name="cbField15" HorizontalAlignment="Right" Grid.Row="13"  Grid.Column="0" ></CheckBox>
                                        <Label Name="lblField15" VerticalAlignment="Center"  Grid.Row="13" Grid.Column="1" ></Label>
                                        <csc:FilteredTextbox Name="txtField15" Text="F15" Margin="0,2,30,2" Grid.Row="13" Grid.Column="2" ></csc:FilteredTextbox>

                                        <CheckBox Name="cbField16" HorizontalAlignment="Right" Grid.Row="13"  Grid.Column="3" ></CheckBox>
                                        <Label Name="lblField16" VerticalAlignment="Center"  Grid.Row="13" Grid.Column="4" ></Label>
                                        <csc:FilteredTextbox Name="txtField16" Text="F16" Margin="0,2,30,2" Grid.Row="13" Grid.Column="5" ></csc:FilteredTextbox>

                                        <CheckBox Name="cbField17" HorizontalAlignment="Right" Grid.Row="14"  Grid.Column="0" ></CheckBox>
                                        <Label Name="lblField17" VerticalAlignment="Center"  Grid.Row="14" Grid.Column="1" ></Label>
                                        <csc:FilteredTextbox Name="txtField17" Text="F17" Margin="0,2,30,2" Grid.Row="14" Grid.Column="2" ></csc:FilteredTextbox>

                                        <CheckBox Name="cbField18" HorizontalAlignment="Right" Grid.Row="14"  Grid.Column="3" ></CheckBox>
                                        <Label Name="lblField18" VerticalAlignment="Center"  Grid.Row="14" Grid.Column="4" ></Label>
                                        <csc:FilteredTextbox Name="txtField18" Text="F18" Margin="0,2,30,2" Grid.Row="14" Grid.Column="5" ></csc:FilteredTextbox>

                                        <CheckBox Name="cbField19" HorizontalAlignment="Right" Grid.Row="15"  Grid.Column="0" ></CheckBox>
                                        <Label Name="lblField19" VerticalAlignment="Center"  Grid.Row="15" Grid.Column="1" ></Label>
                                        <csc:FilteredTextbox Name="txtField19" Text="F19" Margin="0,2,30,2" Grid.Row="15" Grid.Column="2" ></csc:FilteredTextbox>

                                        <CheckBox Name="cbField20" HorizontalAlignment="Right" Grid.Row="15"  Grid.Column="3" ></CheckBox>
                                        <Label Name="lblField20" VerticalAlignment="Center"  Grid.Row="15" Grid.Column="4" ></Label>
                                        <csc:FilteredTextbox Name="txtField20" Text="F20" Margin="0,2,30,2" Grid.Row="15" Grid.Column="5" ></csc:FilteredTextbox>

                                    </Grid>
                            <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                            </StackPanel>
                                </UniformGrid>
                            </GroupBox>
                        </StackPanel>
                    </csc:ScrollViewerEx>

                    <GroupBox Name="SC_gbDataSelection" Margin="10,10,10,0" Visibility="{Binding Model.SMSType, Converter={StaticResource InEqualityVisibilityConverter}, ConverterParameter='Every Transaction|Custom On Transaction'}">
                        <GroupBox.Header>
                            <Label Foreground="White" Padding="10,0,0,0" FontWeight="Bold">Data Selection</Label>
                        </GroupBox.Header>
                        <UniformGrid Margin="15,5,200,0" Rows="1" Columns="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                    <RowDefinition Height="Auto"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="0.5*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Name="SC_lblAccountName" Margin="15,10,15,10" Grid.Row="0" Grid.Column="0" Content="Account"></Label>
                                <ComboBox Name="cmbAccount"  ItemsSource="{Binding Accounts}" Margin="15,10,15,10" Padding="2,2,2,2"  Grid.Row="0" Grid.Column="1" IsEditable="True"  Controls:TextBoxHelper.ClearTextButton="True"
                                                          VerticalAlignment="Center" SelectedValuePath="AccountID"    DisplayMemberPath="CompanyName" >
                                    <ComboBox.SelectedValue>
                                        <Binding Path="SMSModel.AccountID" Converter="{StaticResource NullReplaceConverter}">
                                            <Binding.ConverterParameter>
                                                <sys:Int32>0</sys:Int32>
                                            </Binding.ConverterParameter>
                                        </Binding>
                                    </ComboBox.SelectedValue>
                                </ComboBox>
                                <Label Name="SC_lblVehicleName" Margin="15,10,15,10" Grid.Row="1" Grid.Column="0" Content="Vehicle"></Label>
                                <ComboBox Name="cmbVehicle"  Margin="15,10,15,10" Padding="2,2,2,2"  Grid.Row="1" Grid.Column="1" IsTextSearchEnabled="True" IsEditable="True" ItemsSource="{Binding Vehicles}" Controls:TextBoxHelper.ClearTextButton="True"
                                                          VerticalAlignment="Center" SelectedValuePath="VehicleID" DisplayMemberPath="VehicleNumber" >
                                    <ComboBox.SelectedValue>
                                        <Binding Path="SMSModel.VehicleID" Converter="{StaticResource NullReplaceConverter}">
                                            <Binding.ConverterParameter>
                                                <sys:Int32>0</sys:Int32>
                                            </Binding.ConverterParameter>
                                        </Binding>
                                    </ComboBox.SelectedValue>
                                </ComboBox>
                                <Label Name="SC_lblProductName" Margin="15,10,15,10" Grid.Row="2" Grid.Column="0" Content="Product"></Label>
                                <ComboBox Name="CmbProduct" Margin="15,10,15,10" Padding="2,2,2,2"  Grid.Row="2" Grid.Column="1" IsTextSearchEnabled="True" IsEditable="True" ItemsSource="{Binding Products}" Controls:TextBoxHelper.ClearTextButton="True"
                                                          VerticalAlignment="Center" SelectedValuePath="ProductID" DisplayMemberPath="ProductName">
                                    <ComboBox.SelectedValue>
                                        <Binding Path="SMSModel.ProductID" Converter="{StaticResource NullReplaceConverter}">
                                            <Binding.ConverterParameter>
                                                <sys:Int32>0</sys:Int32>
                                            </Binding.ConverterParameter>
                                        </Binding>
                                    </ComboBox.SelectedValue>
                                </ComboBox>
                                <Label Name="SC_lblTranMode" Margin="15,10,15,10" Grid.Row="3" Grid.Column="0" Content="Transaction Mode"></Label>
                                <ComboBox Name="CmbTranMode" ItemsSource="{Binding lstTransMode}" Margin="15,10,15,10" Padding="2,2,2,2"  Grid.Row="3" Grid.Column="1" IsEditable="True" SelectedValue="{Binding SMSModel.TransactionMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullReplaceConverter}, ConverterParameter=''}" Controls:TextBoxHelper.ClearTextButton="True"></ComboBox>
                                <Label Name="SC_lblTranStatus" Margin="15,10,15,10" Grid.Row="4" Grid.Column="0" Content="Transaction Status"></Label>
                                <ComboBox Name="CmbTranStatus" ItemsSource="{Binding lstTransStatus}" Margin="15,10,15,10" Padding="2,2,2,2"   Grid.Row="4" Grid.Column="1" IsEditable="True" SelectedValue="{Binding SMSModel.Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullReplaceConverter}, ConverterParameter=''}" Controls:TextBoxHelper.ClearTextButton="True"></ComboBox>
                                <Label Name="SC_lblTranType" Margin="15,10,15,10" Grid.Row="5" Grid.Column="0" Content="Transaction Type"></Label>
                                <ComboBox Name="CmbTranType" ItemsSource="{Binding lstTranType}" Margin="15,10,15,10" Padding="2,2,2,2" Grid.Row="5" Grid.Column="1" IsEditable="True" SelectedValue="{Binding SMSModel.TransactionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullReplaceConverter}, ConverterParameter=''}" Controls:TextBoxHelper.ClearTextButton="True"></ComboBox>
                            </Grid>
                            <ItemsControl IsTabStop="False" ItemsSource="{Binding customField,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Column="1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1"></UniformGrid>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock  Margin="15,8,15,10"  Grid.Column="0" Text="{Binding DisplayName, StringFormat='\{0\}: '}"  />
                                            <ComboBox Margin="15,8,15,10" Padding="2,2,2,2" ItemsSource="{Binding FieldValues}"   Grid.Column="1" IsEditable="True" Controls:TextBoxHelper.ClearTextButton="True"
                                                                                Background="{DynamicResource WhiteBrush}" Foreground="{DynamicResource BlackBrush}" SelectedValue="{Binding SelectedfieldValues, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullReplaceConverter}, ConverterParameter=''}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </UniformGrid>
                    </GroupBox>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
        <DockPanel>
            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Save (Enter)" Controls:ButtonHelper.PreserveTextCase="True" Name="CameraManagementSave" IsDefault="True" Grid.Row="0" Grid.Column="0" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="45,30,0,50"   Click="SMSSeduleSave_Click"></Button>
                <!--Command="{Binding SaveCommand}"-->
                <Button Content="Cancel (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="CameraManagementCancel" Grid.Row="0" Grid.Column="1" Height="30" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Margin="25,30,10,50" Command="{Binding CloseDetailViewCommand}"></Button>
                <!--Command="{Binding CloseDetailViewCommand}"-->
            </Grid>
        </DockPanel>
    </Grid>
</Page>
