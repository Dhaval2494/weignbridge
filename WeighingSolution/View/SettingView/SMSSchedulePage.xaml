<Page x:Class="WeighingSolution.View.SMSSchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
      xmlns:shared="clr-namespace:WeighingSolution.SharedComponents;assembly=WeighingSolution.SharedComponents"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="600" d:DesignWidth="800"
	Title="SMSSchedulePage">
    <Page.Resources>
        <converter:InEqualityVisibilityConverter x:Key="InEqualityVisibilityConverter" />
        <converter:EqualityConverter x:Key="EqualityConverter" />
        <converter:EqualityVisibilityConverter x:Key="EqualityVisibilityConverter" />
    </Page.Resources>
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100" >
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Image Source="/Images/sms.png" Width="25" Height="25"  Margin="0,3,3,0" />
                    <TextBlock FontSize="25" VerticalAlignment="Center">
                          <Run FontWeight="Bold"  FontSize="25" Text="SMS" />
                         Setting</TextBlock>
                </DockPanel>
                <Border BorderBrush="Black" BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto"   VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel  Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="10,15,0,10">
                            <Label >Schedule Name</Label>
                            <Label Foreground="red">*</Label>
                        </StackPanel>
                        <TextBox Name="txtScheduleName" MaxLength="250"  Grid.Row="0" Grid.Column="1" Margin="0,15,10,10"  Text="{Binding Model.ScheduleName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal" Margin="10,15,0,10" Grid.Row="0" Grid.Column="2">
                            <Label >Schedule Description</Label>
                        </StackPanel>
                        <TextBox Name="txtScheduleDesc" MaxLength="250"  Grid.Row="0" Grid.Column="3" Margin="0,15,10,10" Text="{Binding Model.ScheduleDescription,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal" Margin="10,15,0,10" Grid.Row="3"  Grid.Column="2" Visibility="{Binding SMSToVisibility}">
                            <Label >SMS To</Label>
                            <Label Foreground="red">*</Label>
                        </StackPanel>
                        <TextBox Name="txtSMSTo" MaxLength="250"  Grid.Row="3" Grid.Column="3" Margin="0,15,10,10" Text="{Binding Model.SMSTo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding SMSToVisibility}"/>

                      
                        <StackPanel Orientation="Horizontal" Margin="10,15,0,10" Grid.Row="2" Grid.Column="0" >
                            <Label >SMS Body</Label>
                        </StackPanel>
                        <TextBox Name="txtSMSBody" MaxLength="250"  Height="45"  Grid.Row="2" Grid.Column="1"  Margin="0,15,10,10" Text="{Binding Model.SMSBody,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal" Margin="10,15,0,10" Grid.Row="2" Grid.Column="2">
                            <Label >SMS End</Label>
                        </StackPanel>

                        <TextBox Name="txtEnd" MaxLength="250"  Grid.Row="2" Grid.Column="3" Margin="0,15,10,10" Text="{Binding Model.SMSEnd,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal" Margin="10,15,0,10" Grid.Row="3" Grid.Column="0">
                            <Label >SMS Type</Label>
                        </StackPanel>
                        <ComboBox Name="cmbConnectionType" Grid.Row="3" Grid.Column="1" Margin="0,15,10,10" 
                                  SelectedValue="{Binding SMSType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                            <ComboBoxItem x:Name="iEveryTransaction" Content="Every Transaction" Tag="Every Transaction"></ComboBoxItem>
                            <ComboBoxItem x:Name="iCustomOnTransaction" Content="Custom On Transaction" Tag="Custom On Transaction" ></ComboBoxItem>
                            <!--<ComboBoxItem x:Name="iTransactionSummary" Content="Transaction Summary" Tag="Transaction Summary" ></ComboBoxItem>
                            <ComboBoxItem x:Name="iTransactionDetail" Content="Transaction Detail" Tag="Transaction Detail" ></ComboBoxItem>-->
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="10,15,0,10" Grid.Row="3" Grid.Column="2" Visibility="{Binding Model.SMSType, Converter={StaticResource InEqualityVisibilityConverter}, ConverterParameter='Every Transaction|Custom On Transaction'}">
                            <Label Name="lblSchedule"  Content="Schedule Time" ></Label>
                            <Label Foreground="red">*</Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,15,0,10" Grid.Row="3" Grid.Column="3" Visibility="{Binding Model.SMSType, Converter={StaticResource InEqualityVisibilityConverter}, ConverterParameter='Every Transaction|Custom On Transaction'}">
                            <RadioButton Name="rbDaily" Content="Daily" Margin="0,5,10,5" IsChecked="{Binding Model.ScheduleType, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Daily'}"  ></RadioButton>
                            <RadioButton Name="rbWeek" Content="Weekly" Margin="30,5,10,5" IsChecked="{Binding Model.ScheduleType, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Week'}"></RadioButton>
                            <RadioButton Name="rbMonth" Content="Monthly" Margin="30,5,10,5" IsChecked="{Binding Model.ScheduleType, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Month'}"></RadioButton>
                            <RadioButton Name="rbYear" Content="Yearly" Margin="30,5,10,5" IsChecked="{Binding Model.ScheduleType, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='Year'}"></RadioButton>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="3"  Visibility="{Binding Model.SMSType, Converter={StaticResource InEqualityVisibilityConverter}, ConverterParameter='Every Transaction|Custom On Transaction'}">
                            <StackPanel Name="stkYear" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding Model.ScheduleType, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Week'}">
                                    <Label Name="lblDay" Content="Day:"></Label>
                                    <ComboBox Name="cmbDay" Margin="10,0,0,0" ItemsSource="{Binding lstday}" SelectedValue="{Binding ST.Day,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding Model.ScheduleType, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Year'}">
                                    <Label Name="lblMonth" Content="Month:"></Label>
                                    <ComboBox Name="cmbMonth" Margin="10,0,0,0" ItemsSource="{Binding lstmonth}" SelectedValue="{Binding ST.Month,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style >
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Model.ScheduleType}" Value="Month">
                                                    <Setter Property="Visibility" Value="Visible"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Model.ScheduleType}" Value="Year">
                                                    <Setter Property="Visibility" Value="Visible"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Label Name="lblDate" Margin="20,0,0,0" Content="Date:"></Label>
                                    <ComboBox Name="cmbDate" Margin="10,0,0,0" ItemsSource="{Binding lstdate}" SelectedValue="{Binding ST.Date,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Name="lblHour" Margin="20,0,0,0" Content="Hour:"></Label>
                                    <ComboBox Name="cmbhour" Margin="10,0,0,0" ItemsSource="{Binding lsthour}" SelectedValue="{Binding ST.Hour,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ></ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
