                                <CheckBox Name="cbGrossTime" HorizontalAlignment="Left" Grid.Row="2"  Grid.Column="2" Content="Gross Time"  Margin="5,0,0,0"   Command="{Binding CBCheckedUnchecked}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"></CheckBox>
