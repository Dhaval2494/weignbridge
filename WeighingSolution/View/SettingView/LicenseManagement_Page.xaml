<Page x:Class="WeighingSolution.View.SettingView.LicenseManagement_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      xmlns:Constant="clr-namespace:WeighingSolution.DataLayer;assembly=WeighingSolution.DataLayer"
      xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents" 
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="500" d:DesignWidth="700"
	Title="LicenseManagement_Page">
    <Page.Resources>
        <converter:InEqualityVisibilityConverter x:Key="InEqualityVisibilityConverter" />
    </Page.Resources>
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel  Margin="0,0,0,0">
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource LicenseIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="License" />
                        Management</TextBlock>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Top">
                    <Grid Background="{DynamicResource WhiteBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.2*"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="0.2*"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="0.2*"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="4*"></RowDefinition>
                            <RowDefinition Height="1*"></RowDefinition>
                            <RowDefinition Height="1*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel  Grid.Row="1" Margin="5,5,5,0">
                            <StackPanel Background="{DynamicResource AccentColorBrush}">
                                <TextBlock Margin="5,5,5,5" FontWeight="Bold" Text="License Information">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="White"></Setter>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="4*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                    <RowDefinition Height="*"></RowDefinition>
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Margin="10,5,0,0">Assign To</Label>
                                <Label Name="lblAssignTo" Grid.Row="0" Grid.Column="1"  Margin="0,5,50,0"></Label>
                                <Label Grid.Row="1" Grid.Column="0" Margin="10,5,0,0">Software Type</Label>
                                <Label Name="lblsoftwaretype" Grid.Row="1" Grid.Column="1"  Margin="0,5,50,0"></Label>
                                <Label Grid.Row="2" Grid.Column="0" Margin="10,5,0,0">License Type</Label>
                                <Label Name="lblLicenseType" Grid.Row="2" Grid.Column="1"  Margin="0,5,50,0"></Label>
                                <Label Grid.Row="3" Grid.Column="0" Margin="10,5,0,0">Expire On</Label>
                                <Label Name="lblExpireOn" Grid.Row="3" Grid.Column="1" Margin="0,5,50,0"></Label>
                                <Label x:Name="lblamcexpire" Grid.Row="4" Grid.Column="0" Margin="10,5,0,0" Visibility="Collapsed">Amc Expire</Label>
                                <Label Name="txtamcexpire" Grid.Row="4" Grid.Column="1" Margin="0,5,50,0" Visibility="Collapsed"></Label>
                            </Grid>
                        </StackPanel>
                        <StackPanel Background="{DynamicResource AccentColorBrush}" Grid.Row="2" Margin="5,0,5,0">
                            <TextBlock Margin="5,5,5,5" FontWeight="Bold" Text="Application Serial No:">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="White"></Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="3"  Margin="5,0,5,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"></ColumnDefinition>
                                    <ColumnDefinition Width="1.5*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Label Margin="10,15,10,10" Grid.Column="0" Name="lblHardwareID"></Label>
                                <TextBlock Margin="10,15,10,10" Grid.Column="1">
                                         <Hyperlink Name="lnkCopy" Click="lnkCopy_Click">Click Here to Copy Serial No</Hyperlink>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <StackPanel Background="{DynamicResource AccentColorBrush}" Grid.Row="4" Margin="5,0,5,0" Visibility="{Binding Source={x:Static Constant:Constant.IsBasicversion}, Converter={StaticResource InEqualityVisibilityConverter}, ConverterParameter={StaticResource TrueValue}}">
                            <TextBlock Margin="5,5,5,5" FontWeight="Bold" Text="Included Plugin:">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="White"></Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Margin="5,0,5,0" Visibility="{Binding Source={x:Static Constant:Constant.IsBasicversion}, Converter={StaticResource InEqualityVisibilityConverter}, ConverterParameter={StaticResource TrueValue}}">
                            <DataGrid Name="drgPlugin" Padding="5,0,5,5" Visibility="Collapsed" CanUserDeleteRows="False" AutoGenerateColumns="False" Margin="0,4,0,0" HorizontalAlignment="Center" 
                                      CanUserAddRows="False" ScrollViewer.CanContentScroll="True" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
                                        <Setter Property="Foreground" Value="White"></Setter>
                                        <Setter Property="Height" Value="25"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,2,0,2"/>
                                        <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns >
                                    <DataGridTextColumn>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Padding" Value="5,0,5,0"></Setter>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Plugin Name"  Width="*" IsReadOnly="True" Binding="{Binding Path=PluginName}"  />
                                    <DataGridTextColumn Header="Plugin Expiry"  Width="*" IsReadOnly="True" Binding="{Binding Path=ExpiredOn}"  />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Label Margin="10,10,10,10" Name="lblNoPlugin">No Plugin Included</Label>
                        </StackPanel>
                        <StackPanel Background="{DynamicResource AccentColorBrush}" Grid.Row="6"  Margin="5,0,5,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"></ColumnDefinition>
                                    <ColumnDefinition Width="1*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <RadioButton Name="rdbLicenseKey" GroupName="rdbLicenseType" Checked="rdbLicenseKey_Checked" IsChecked="True" Margin="5,2,0,0"></RadioButton>
                                    <TextBlock Margin="5,5,5,5" FontWeight="Bold" Text="Add your license key below:">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="White"></Setter>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" >
                                    <RadioButton Name="rdbUploadFile" GroupName="rdbLicenseType" Checked="rdbUploadFile_Checked" Margin="5,2,0,0"></RadioButton>
                                    <TextBlock Margin="5,5,5,5" FontWeight="Bold" Text="Upload License File:">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="White"></Setter>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="7" Name="stkSignatureKey"  Margin="5,0,5,0">
                            <TextBox Name="txtSignatureKey" Margin="10,10,10,10" Height="190" TextWrapping="WrapWithOverflow" Grid.ColumnSpan="2">
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Row="7" Name="stkLicenseFile" Visibility="Collapsed" >
                            <Button Name="btnUploadFile" Click="btnUploadFile_Click" Margin="10,10,10,10" Width="100">Upload License</Button>
                            <TextBlock Name="lblStatus">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="Green"></Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="8" Name="stkVerify" Orientation="Horizontal">
                            <Button Content="Renew License" Name="btnRenewLicense" Click="btnRenewLicense_Click" Controls:ButtonHelper.PreserveTextCase="True" HorizontalAlignment="Left" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Padding="25,5,25,5" Margin="45,10,10,50"></Button>
                            <Button Content="Go To Setting (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="LicenseCancel" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Padding="25,5,25,5" Margin="25,10,10,50" Click="LicenseCancel_Click"></Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
    </Grid>
</Page>
