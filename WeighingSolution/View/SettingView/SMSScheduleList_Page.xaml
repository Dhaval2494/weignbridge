<Page x:Class="WeighingSolution.View.SMSScheduleList_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      xmlns:shared="clr-namespace:WeighingSolution.SharedComponents;assembly=WeighingSolution.SharedComponents" xmlns:userControls="clr-namespace:WeighingSolution.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="800"
      Style="{DynamicResource MetroPage}"
	  Title="SMSPage">
    <Page.Resources>
        <converter:MultiBindingConverter x:Key="MultiBindingConverter" />
    </Page.Resources>
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100" >
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Image Source="/Images/sms.png" Width="25" Height="25"  Margin="0,3,3,0" />                    
                    <TextBlock FontSize="25" VerticalAlignment="Center">
                          <Run FontWeight="Bold"  FontSize="25" Text="SMS" />
                         Schedules</TextBlock>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,8,20,5" >
                        <!--<Button HorizontalAlignment="Right" Margin="0,20,10,10"  Content=" Send SMS" Click="Button_Click"></Button>
                        <Button Content="SMTP" Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource  mouseoverstyle}" Margin="0,15,10,10"   Name="SMSSetting"   BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Click="SMSSetting_Click"  ></Button>-->
                        <TextBox  Name="txtsearch" Width="300" Margin="0,0,0,0"  BorderBrush="{DynamicResource AccentColorBrush}" Padding="5,5,5,5" ToolTip="Search"  Text="{Binding SearchString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MetroTextBox}" >
                                    <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="True"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="Controls:TextBoxHelper.HasText" Value="false" >
                                            <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="False" />
                                            <Setter Property="Controls:TextBoxHelper.Watermark"  Value="Search Record" />
                                        </Trigger>
                                        <Trigger Property="Controls:TextBoxHelper.HasText"   Value="True">
                                            <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="True" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Name="btnSearch" IsDefault="True" HorizontalAlignment="Left" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="34" Width="34"  Margin="0,0,20,0" Command="{Binding FilterData}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="search" Margin="0,2,0,0"  Height="14" Width="14" />
                            </StackPanel>
                        </Button>
                        <TextBlock Name="txtbAddSchedule" Visibility="Visible" Margin="0,0,20,0" FontWeight="Bold" HorizontalAlignment="Right" >
                            <Button Name="btnAddSchedule" Click="btnAddSchedule_Click" Controls:ButtonHelper.PreserveTextCase="True" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Padding="20,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="PlusCircle"  Margin="0,1,2,0"  Height="14" Width="14" />
                                    <TextBlock>ADD Schedule</TextBlock>
                                </StackPanel>
                            </Button>
                        </TextBlock>

                        <Button Name="btnSMSServerSetting" HorizontalAlignment="Left" BorderBrush="{DynamicResource AccentColorBrush}" Height="34" Width="34"  Margin="0,0,20,0" Click="btnSMSServerSetting_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType='Button'>
                                                <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" ToolTip="Click to configure email server setting" Margin="0,0,0,0">
                                                    <Rectangle.OpacityMask>
                                                        <VisualBrush Stretch="Uniform" Visual="{StaticResource SettingsIcon}" />
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>
                </DockPanel>
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto"   VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <DataGrid Name="DatagridSMSSchedule" AutoGenerateColumns="False" ItemsSource="{Binding ViewList.View}"  Margin="0,4,0,0"  CanUserAddRows="False" PreviewKeyDown="DatagridSMSSchedule_PreviewKeyDown" >
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
                                <Setter Property="Height" Value="35"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
                                <Setter Property="BorderThickness" Value="0,2,0,2"/>
                                <Setter Property="Margin" Value="0,0,0,0"></Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns >
                            <DataGridTextColumn>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Padding" Value="6,6,6,6"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Schedule Name" Width="*"  IsReadOnly="True" Binding="{Binding Path=ScheduleName}" />
                            <DataGridTextColumn Header="SMS Type" Width="*"  IsReadOnly="True" Binding="{Binding Path=SMSType}" />
                            <DataGridTextColumn Header="SMS To" Width="200"  IsReadOnly="True" Binding="{Binding Path=SMSTo}" />
                            <DataGridTemplateColumn Header="Enable/Disable" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnable}" Value="True">
                                                            <Setter Property="Text" Value="Enable" />
                                                            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEnable}" Value="False">
                                                            <Setter Property="Text" Value="Disable" />
                                                            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock   VerticalAlignment="Center" ToolTip="Edit">
                                                        <Hyperlink  Name="EditSchedule" TextDecorations="none"  FontWeight="Bold"
                                                                    Command="{Binding DataContext.EditObject, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                            <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                                                                  <Rectangle.OpacityMask>
                                                                       <VisualBrush Stretch="Uniform" Visual="{StaticResource EditLinkIcon}" />
                                                                  </Rectangle.OpacityMask>
                                                            </Rectangle>
                                                             <Hyperlink.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                                                         <Binding Path="SMSSetupID" />
                                                         <Binding Source="SMSSchedulePage"/>
                                                    </MultiBinding>
                                                </Hyperlink.CommandParameter>
                                                        </Hyperlink>
                                            </TextBlock>
                                            <TextBlock  Margin="5,0,5,0"  VerticalAlignment="Center"  >
                                                 <Hyperlink  Name="EnableLink" CommandParameter="{Binding}"  TextDecorations="none" 
                                                             Command="{Binding DataContext.EnableDisableScheduleCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                   <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" ToolTip="Enable" Margin="0,0,0,0" Visibility="{Binding IsEnable,Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                                                        <Rectangle.OpacityMask>
                                                                    <VisualBrush Stretch="Uniform" Visual="{StaticResource ThumbUpIcon}" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                    <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" ToolTip="Disable" Margin="0,0,0,0" Visibility="{Binding IsEnable,Converter={StaticResource NegativeBooleanToVisibilityConverter}}">
                                                        <Rectangle.OpacityMask>
                                                                    <VisualBrush Stretch="Uniform" Visual="{StaticResource ThumbDownIcon}" />
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                  </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Delete" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" ToolTip="Delete"  >
                                            <Hyperlink  CommandParameter="{Binding}" Name="HyperLinkDeleteSMSSchedule" TextDecorations="none" Foreground="Black" FontWeight="Bold"
                                                        Command="{Binding DataContext.DeleteScheduleCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" >
                                                  <Image Height="20" Width="20" Source="/Images/close.png"></Image>
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" Visibility="{Binding HasData,Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                        <TextBlock Name="txtmsg" FontSize="20" Opacity="0.5" Margin="5,5,5,5" >No Record Exist</TextBlock>
                    </StackPanel>
                    <userControls:PaginationElements x:Name="ucPager" Visibility="{Binding HasData,Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
        <DockPanel>

            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Go To Setting (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="SMSScheduleListCancel" Grid.Row="0" Grid.Column="0" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Margin="45,30,10,50" Click="SMSScheduleListCancel_Click"  ></Button>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
