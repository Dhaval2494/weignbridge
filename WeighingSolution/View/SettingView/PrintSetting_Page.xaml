<Page x:Class="WeighingSolution.View.PrintSetting_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents" xmlns:xCeedDD="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="600" d:DesignWidth="800"
	Title="Print Setting Page" FocusManager.FocusedElement="{Binding ElementName=cmbPrintType }">
    <Page.Resources>
    </Page.Resources>
    <Page.CommandBindings>
    </Page.CommandBindings>
    <Page.InputBindings>       
    </Page.InputBindings>
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel  Margin="0,0,0,50">
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Image Source="/Images/printing.png" Width="25" Height="25"  Margin="0,3,5,0" />
                    <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="Print" />
                         Settings</TextBlock>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <StackPanel Name="stkPrintSetting" VerticalAlignment="Top">
                        <GroupBox Name="gbConnectionSettings" Header="Connection Settings">
                            <StackPanel>
                                <Grid Name="gridPrintsetting">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="10,5,0,20" Orientation="Horizontal">
                                        <Label>Print Type</Label>
                                    </StackPanel>
                                    <ComboBox Name="cmbPrintType" Grid.Row="0" Grid.Column="1" Margin="0,5,10,20" SelectedValue="{Binding PrintType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                        <ComboBoxItem x:Name="DotMatrix" Content="DotMatrix" Tag="DotMatrix"></ComboBoxItem>
                                        <ComboBoxItem x:Name="Laser" Content="Laser" Tag="Laser" ></ComboBoxItem>
                                    </ComboBox>

                                    <StackPanel Orientation="Horizontal" Grid.Row="1"  Grid.Column="0" Margin="10,0,0,20">
                                        <Label>Printer Name</Label>
                                        <Label Foreground="Red">*</Label>
                                    </StackPanel>

                                    <ComboBox Name="cmbPrinters" Grid.Row="1" Grid.Column="1" Margin="0,5,10,20" 
                                              ItemsSource="{Binding InstalledPrinter}"
                                              SelectedValue="{Binding PrinterName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                                    </ComboBox>

                                </Grid>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Save(Enter)" Name="PrintSettingSave" Visibility="Collapsed" IsDefault="True"  Grid.Column="0"  Controls:ButtonHelper.PreserveTextCase="True"  Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="35,15,0,15" Command="{Binding SaveSettingCommand}"></Button>
                                        <Button Content="Cancel (Esc)" Name="PrintSettingCancel" IsCancel="True"  Grid.Column="1"  Controls:ButtonHelper.PreserveTextCase="True" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Margin="20,15,10,15"  Command="{Binding CloseDetailViewCommand}" CommandParameter="/View/SettingView/Setting_Page.Xaml" ></Button>

                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
    </Grid>
</Page>
