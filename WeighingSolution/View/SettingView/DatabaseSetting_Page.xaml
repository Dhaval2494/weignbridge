<Page
    x:Class="WeighingSolution.View.DatabaseSetting_Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DatabaseSetting_Page"
    d:DesignHeight="600"
    d:DesignWidth="800"
    FocusManager.FocusedElement="{Binding ElementName=txtServerName}"
    Style="{DynamicResource MetroPage}"
    mc:Ignorable="d">
    <Page.Resources>
        <RoutedUICommand x:Key="DeleteDatabaseCommand" Text="Delete Database" />
        <RoutedUICommand x:Key="DeleteTransactionData" Text="Delete TranData" />
    </Page.Resources>
    <Page.CommandBindings>
        <CommandBinding Command="{StaticResource DeleteTransactionData}" Executed="DeleteTransactionDataCommandExecuted" />
    </Page.CommandBindings>
    <Page.InputBindings>
        <!--<KeyBinding Key="Delete" Modifiers="Control+Shift" Command="{StaticResource DeleteDatabaseCommand}" />-->

        <KeyBinding Command="{StaticResource DeleteTransactionData}" Gesture="Control+Shift+D" />
    </Page.InputBindings>
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,50">
            <StackPanel
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                DockPanel.Dock="Top">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle
                        Width="25"
                        Height="25"
                        Margin="0,3,5,0"
                        Fill="{DynamicResource BlackBrush}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource DatabaseIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                        <Run
                            FontSize="25"
                            FontWeight="Bold"
                            Text="Database" />
                        Settings</TextBlock>
                    <StackPanel
                        x:Name="SyncSettingsPanel"
                        Margin="0,8,20,5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Visibility="Collapsed">

                        <TextBlock FontSize="25">Sync Settings</TextBlock>
                        <Button Name="btnSyncServerSetting"
                            Width="34"
                            Height="34"
                            Margin="0,0,20,0"
                            HorizontalAlignment="Left"
                            BorderBrush="{DynamicResource AccentColorBrush}"
                            Click="btnSyncServerSetting_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Rectangle
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,0,0,0"
                                                    Fill="{DynamicResource BlackBrush}"
                                                    ToolTip="Click to configure Sync server setting">
                                                    <Rectangle.OpacityMask>
                                                        <VisualBrush Stretch="Uniform" Visual="{StaticResource SettingsIcon}" />
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <Border
                    Height="4"
                    Margin="0,4,1,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{DynamicResource AccentColorBrush}"
                    BorderThickness="0" />
            </StackPanel>
            <csc:ScrollViewerEx VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,0" VerticalAlignment="Stretch">
                    <StackPanel Name="stkDataBaseSetting" VerticalAlignment="Top">
                        <GroupBox Name="gbConnectionSettings" Header="Connection Settings">
                            <StackPanel>
                                <Grid Name="gridDataBasesetting">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="10,5,0,20"
                                        Orientation="Horizontal">
                                        <Label>Server Name</Label>
                                        <Label Foreground="Red">*</Label>
                                    </StackPanel>
                                    <TextBox
                                        Name="txtServerName"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,5,10,20"
                                        Padding="2,2,2,2"
                                        Text="{Binding Server, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="10,0,0,20"
                                        Orientation="Horizontal">
                                        <Label>File Name</Label>
                                        <Label Foreground="Red">*</Label>
                                    </StackPanel>
                                    <TextBox
                                        Name="txtDBFileName"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,0,10,20"
                                        Padding="2,2,2,2"
                                        Text="{Binding DBName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Margin="10,0,0,20">
                                        Port
                                    </Label>
                                    <TextBox
                                        Name="txtPort"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,0,10,20"
                                        Padding="2,2,2,2"
                                        Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="10,0,0,20"
                                        Orientation="Horizontal">
                                        <Label>User Name</Label>
                                        <Label Foreground="Red">*</Label>
                                    </StackPanel>
                                    <TextBox
                                        Name="txtUserName"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,0,10,20"
                                        Padding="2,2,2,2"
                                        Text="{Binding UserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        Margin="10,0,0,0"
                                        Orientation="Horizontal">
                                        <Label>Password</Label>
                                        <Label Foreground="Red">*</Label>
                                    </StackPanel>
                                    <PasswordBox
                                        Name="pwbxPassword"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="0,0,10,0"
                                        Padding="2,2,2,2"
                                        csc:PasswordHelper.Attach="True"
                                        csc:PasswordHelper.Password="{Binding password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Name="DatabaseSettingSave"
                                            Grid.Column="0"
                                            Height="30"
                                            Margin="35,15,0,15"
                                            Controls:ButtonHelper.PreserveTextCase="True"
                                            BorderBrush="{DynamicResource AccentColorBrush}"
                                            Command="{Binding SaveSettingCommand}"
                                            Content="Save(Enter)"
                                            IsDefault="True"
                                            Style="{DynamicResource mouseoverstyle}"
                                            Visibility="Collapsed" />
                                        <Button
                                            Name="DataBaseSettingCancel"
                                            Grid.Column="1"
                                            Height="30"
                                            Margin="20,15,10,15"
                                            Controls:ButtonHelper.PreserveTextCase="True"
                                            BorderBrush="{DynamicResource AccentColorBrush}"
                                            Command="{Binding CloseDetailViewCommand}"
                                            CommandParameter="/View/SettingView/Setting_Page.Xaml"
                                            Content="Cancel (Esc)"
                                            IsCancel="True"
                                            Style="{DynamicResource mouseoverstyle}" />
                                        <Button
                                            Name="btnDeleteDatabase"
                                            Grid.Column="2"
                                            Height="30"
                                            Margin="0,15,10,15"
                                            Command="{StaticResource DeleteDatabaseCommand}"
                                            Visibility="Collapsed">
                                            Delete Database
                                        </Button>
                                        <Button
                                            Name="btnDeleteData"
                                            Grid.Column="3"
                                            Margin="0,15,10,15"
                                            Command="{StaticResource DeleteTransactionData}"
                                            Visibility="Collapsed">
                                            Delete TxData
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Name="GBAutoBackup" Header="Auto Backup">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Margin="10,15,0,10">Auto Backup</Label>
                                <StackPanel
                                    Name="stkServiceStarted"
                                    Grid.Column="1"
                                    Margin="0,15,10,10"
                                    Orientation="Horizontal"
                                    Visibility="Visible">
                                    <CheckBox
                                        Name="cbenbleDB"
                                        Margin="10,0,0,10"
                                        IsChecked="{Binding AutoBackupEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        Enable
                                    </CheckBox>
                                    <StackPanel
                                        Name="stkDBBackuptime"
                                        Margin="20,0,0,10"
                                        Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=cbenbleDB, Path=IsChecked}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=cbenbleDB, Path=IsChecked}" Value="false">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ComboBox
                                            Name="cmbhours"
                                            Margin="10,0,0,0"
                                            SelectedValue="{Binding AutoBackupHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Tag">
                                            <ComboBoxItem Content="1" Tag="1" />
                                            <ComboBoxItem Content="2" Tag="2" />
                                            <ComboBoxItem Content="3" Tag="3" />
                                            <ComboBoxItem Content="4" Tag="4" />
                                            <ComboBoxItem Content="5" Tag="5" />
                                            <ComboBoxItem Content="6" Tag="6" />
                                            <ComboBoxItem Content="7" Tag="7" />
                                            <ComboBoxItem Content="8" Tag="8" />
                                            <ComboBoxItem Content="9" Tag="9" />
                                            <ComboBoxItem Content="10" Tag="10" />
                                            <ComboBoxItem Content="11" Tag="11" />
                                            <ComboBoxItem Content="12" Tag="12" />
                                        </ComboBox>
                                        <Label Name="lblhours" Margin="3,0,0,0">
                                            Hours
                                        </Label>
                                        <ComboBox
                                            Name="cmbminutes"
                                            Margin="10,0,0,0"
                                            SelectedValue="{Binding AutoBackupMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Tag">
                                            <ComboBoxItem Content="0" Tag="0" />
                                            <ComboBoxItem Content="1" Tag="1" />
                                            <ComboBoxItem Content="2" Tag="2" />
                                            <ComboBoxItem Content="3" Tag="3" />
                                            <ComboBoxItem Content="4" Tag="4" />
                                            <ComboBoxItem Content="5" Tag="5" />
                                            <ComboBoxItem Content="6" Tag="6" />
                                            <ComboBoxItem Content="7" Tag="7" />
                                            <ComboBoxItem Content="8" Tag="8" />
                                            <ComboBoxItem Content="9" Tag="9" />
                                            <ComboBoxItem Content="10" Tag="10" />
                                            <ComboBoxItem Content="11" Tag="11" />
                                            <ComboBoxItem Content="12" Tag="12" />
                                            <ComboBoxItem Content="13" Tag="13" />
                                            <ComboBoxItem Content="14" Tag="14" />
                                            <ComboBoxItem Content="15" Tag="15" />
                                            <ComboBoxItem Content="16" Tag="16" />
                                            <ComboBoxItem Content="17" Tag="17" />
                                            <ComboBoxItem Content="18" Tag="18" />
                                            <ComboBoxItem Content="19" Tag="19" />
                                            <ComboBoxItem Content="20" Tag="20" />
                                            <ComboBoxItem Content="21" Tag="21" />
                                            <ComboBoxItem Content="22" Tag="22" />
                                            <ComboBoxItem Content="23" Tag="23" />
                                            <ComboBoxItem Content="24" Tag="24" />
                                            <ComboBoxItem Content="25" Tag="25" />
                                            <ComboBoxItem Content="26" Tag="26" />
                                            <ComboBoxItem Content="27" Tag="27" />
                                            <ComboBoxItem Content="28" Tag="28" />
                                            <ComboBoxItem Content="29" Tag="29" />
                                            <ComboBoxItem Content="30" Tag="30" />
                                            <ComboBoxItem Content="31" Tag="31" />
                                            <ComboBoxItem Content="32" Tag="32" />
                                            <ComboBoxItem Content="33" Tag="33" />
                                            <ComboBoxItem Content="34" Tag="34" />
                                            <ComboBoxItem Content="35" Tag="35" />
                                            <ComboBoxItem Content="36" Tag="36" />
                                            <ComboBoxItem Content="37" Tag="37" />
                                            <ComboBoxItem Content="38" Tag="38" />
                                            <ComboBoxItem Content="39" Tag="39" />
                                            <ComboBoxItem Content="40" Tag="40" />
                                            <ComboBoxItem Content="41" Tag="41" />
                                            <ComboBoxItem Content="42" Tag="42" />
                                            <ComboBoxItem Content="43" Tag="43" />
                                            <ComboBoxItem Content="44" Tag="44" />
                                            <ComboBoxItem Content="45" Tag="45" />
                                            <ComboBoxItem Content="46" Tag="46" />
                                            <ComboBoxItem Content="47" Tag="47" />
                                            <ComboBoxItem Content="48" Tag="48" />
                                            <ComboBoxItem Content="49" Tag="49" />
                                            <ComboBoxItem Content="50" Tag="50" />
                                            <ComboBoxItem Content="51" Tag="51" />
                                            <ComboBoxItem Content="52" Tag="52" />
                                            <ComboBoxItem Content="53" Tag="53" />
                                            <ComboBoxItem Content="54" Tag="54" />
                                            <ComboBoxItem Content="55" Tag="55" />
                                            <ComboBoxItem Content="56" Tag="56" />
                                            <ComboBoxItem Content="57" Tag="57" />
                                            <ComboBoxItem Content="58" Tag="58" />
                                            <ComboBoxItem Content="59" Tag="59" />
                                        </ComboBox>
                                        <Label Name="lblminutes" Margin="3,0,0,0">Minute</Label>
                                        <ComboBox
                                            Name="cmbmeridiem"
                                            Margin="20,0,0,0"
                                            SelectedValue="{Binding AutoBackupMeridiem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Tag">
                                            <ComboBoxItem Content="AM" Tag="AM" />
                                            <ComboBoxItem Content="PM" Tag="PM" />
                                        </ComboBox>
                                        <Button
                                            Name="btnSelectPathForAutoBackUp"
                                            Margin="20,0,0,0"
                                            Command="{Binding SelectFile}">
                                            Choose folder location for auto backup
                                        </Button>
                                        <TextBlock
                                            Name="lblSavepath"
                                            Grid.Row="5"
                                            Grid.Column="1"
                                            Margin="10,5,0,0"
                                            Text="{Binding AutoBackupFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button
                                    Name="Autobackupsave"
                                    Grid.Column="2"
                                    Height="30"
                                    Margin="0,0,10,0"
                                    Controls:ButtonHelper.PreserveTextCase="True"
                                    BorderBrush="{DynamicResource AccentColorBrush}"
                                    Command="{Binding SaveCommand}"
                                    Content="Save Auto Backup Detail"
                                    FontWeight="SemiBold"
                                    Style="{DynamicResource mouseoverstyle}" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Name="gbBackupRestore" Header="Backup-Restore Database">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Name="txtFileLocationForBackup"
                                        Margin="30,15,10,10"
                                        Text="{Binding lblFileLocation, Mode=TwoWay}" />
                                    <Button
                                        Name="btnChooseFileForBackup"
                                        Margin="10,10,10,10"
                                        HorizontalAlignment="Left"
                                        Command="{Binding BackupFileLocationCommand}">
                                        Choose File Location
                                    </Button>
                                </StackPanel>
                                <Button
                                    Name="btnBackupDatabase"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Height="30"
                                    Margin="10,10,10,10"
                                    HorizontalAlignment="Right"
                                    Controls:ButtonHelper.PreserveTextCase="True"
                                    BorderBrush="{DynamicResource AccentColorBrush}"
                                    Command="{Binding BackUpDBCommand}"
                                    Style="{DynamicResource mouseoverstyle}">
                                    Backup Database
                                </Button>

                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Name="txtFileLocationForRestore"
                                        Margin="30,15,10,10"
                                        Text="{Binding lblRestoreFileLocation, Mode=TwoWay}" />
                                    <Button
                                        Name="btnChooseFileForRestore"
                                        Margin="10,10,10,10"
                                        HorizontalAlignment="Left"
                                        Command="{Binding RestoreFileLocationCommand}">
                                        Select File
                                    </Button>
                                </StackPanel>
                                <Button
                                    Name="btnRestoreDatabase"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Height="30"
                                    Margin="10,10,10,10"
                                    HorizontalAlignment="Right"
                                    Controls:ButtonHelper.PreserveTextCase="True"
                                    BorderBrush="{DynamicResource AccentColorBrush}"
                                    Command="{Binding RestoreDBCommand}"
                                    Style="{DynamicResource mouseoverstyle}">
                                    Restore Database
                                </Button>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
    </Grid>
</Page>
