<simpleChildWindow:ChildWindow 
      x:Class="WeighingSolution.View.EmailServerSettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      xmlns:simpleChildWindow="clr-namespace:MahApps.Metro.SimpleChildWindow;assembly=MahApps.Metro.SimpleChildWindow"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      CloseByEscape="True"  AllowMove="True" BorderBrush="{DynamicResource AccentBaseColorBrush}" BorderThickness="1" GlowBrush="{DynamicResource AccentColorBrush}"
      ShowCloseButton="True" HorizontalContentAlignment="Center" IsModal="True" VerticalContentAlignment="Center" EnableDropShadow="False"	Title="EmailServerSetting"
      mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Background="{DynamicResource WhiteBrush}" >
            <StackPanel Name="stkSetting" Margin="5">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10" Grid.Row="0" Grid.Column="0" Width="100">
                        <Label >Server Name</Label>
                        <Label Foreground="red">*</Label>
                    </StackPanel>
                    <TextBox Name="txtServerName" MaxLength="250"  Grid.Row="0" Grid.Column="1" Margin="0,10,10,10" Padding="2" Text="{Binding Path=ServerName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="350"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10" Grid.Row="0" Grid.Column="2" Width="100">
                        <Label >Port</Label>
                        <Label Foreground="red">*</Label>
                    </StackPanel>
                    <csc:FilteredTextbox Name="txtPort" FilterRegex="^[0-9]+$" MaxLength="10"  Grid.Row="0" Grid.Column="3" Margin="0,10,10,10" Padding="2" Text="{Binding Path=Port,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Width="350"/>
                    <Label  Margin="0,10,0,10" Grid.Row="1" Grid.Column="0"  Width="100" >User Name</Label>
                    <TextBox Name="txtUserName" MaxLength="250"  Grid.Row="1" Grid.Column="1" Margin="0,10,10,10" Padding="2" Text="{Binding Path=UserName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="350"/>
                    <Label Margin="0,10,0,10" Grid.Row="1" Grid.Column="2"  Width="100" >Password</Label>
                    <PasswordBox csc:PasswordHelper.Attach="True" MaxLength="250"  Grid.Row="1" Grid.Column="3" Margin="0,10,10,10" Width="350"  csc:PasswordHelper.Password="{Binding PassWord, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                    <Label  Margin="0,10,0,10" Grid.Row="2" Grid.Column="0"  Width="100" >Email From</Label>
                    <TextBox Name="txtEmailFrom" MaxLength="250"  Grid.Row="2" Grid.Column="1" Margin="0,10,10,10" Padding="2" Text="{Binding Path=EmailFrom,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,TargetNullValue=''}" Width="350"/>
                    <Label Name="lblSSl" Margin="5,10,10,10" Grid.Row="2" Grid.Column="2" Width="100">Use SSL</Label>
                    <CheckBox Name="cbSSl" Grid.Row="2" Grid.Column="3" IsChecked="{Binding UseSSL,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></CheckBox>
                    <Button Grid.Row="3" Grid.Column="3" Content="Save" HorizontalAlignment="Right" Padding="5" Margin="0,10,10,10" VerticalAlignment="Bottom"  Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource  mouseoverstyle}" Name="EmailServerSettingSave"   BorderBrush="{DynamicResource AccentColorBrush}" Height="30"  Command="{Binding SaveSettingCommand}" ></Button>
                </Grid>
                <Border Height="1" Background="{StaticResource AccentColorBrush}" HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,20,0,20">
                    <Label>Email To:</Label>
                    <TextBox MaxLength="250" Width="300" Text="{Binding EmailTo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"></TextBox>
                    <Button Name="btnTestEmail" Margin="15,0,0,0" Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Command="{Binding SendTestMail}">Send Test Email</Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</simpleChildWindow:ChildWindow>
