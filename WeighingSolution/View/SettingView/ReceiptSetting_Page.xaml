<Page x:Class="WeighingSolution.View.ReceiptSetting_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents" xmlns:xCeedDD="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="600" d:DesignWidth="800"
	Title="Receipt Setting Page" FocusManager.FocusedElement="{Binding ElementName=cmbReceiptType }">
    <Page.Resources>
    </Page.Resources>
    <Page.CommandBindings>
    </Page.CommandBindings>
    <Page.InputBindings>       
    </Page.InputBindings>
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel  Margin="0,0,0,50">
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Image Source="/Images/Printing.png" Width="25" Height="25"  Margin="0,3,5,0" />
                    <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="Receipt" />
                         Settings</TextBlock>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <StackPanel Name="stkReceiptSetting" VerticalAlignment="Top">
                        <GroupBox Name="gbConnectionSettings" Header="Receipt Settings">
                            <StackPanel>
                                <Grid Name="gridReceiptsetting">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Margin="10,15,0,10">Select Receipt Format</Label>
                                    <ComboBox Name="cmbReceipt" Grid.Row="0" Grid.Column="1" Margin="0,15,10,10" ItemsSource="{Binding Receipts}" DisplayMemberPath="Label" SelectedValuePath="Label" SelectedValue="{Binding SelectedReceipt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Label Grid.Row="1" Grid.Column="0" Margin="10,15,0,10">Select Multi Receipt Format</Label>
                                    <ComboBox Name="cmbMultReceipt" Grid.Row="1" Grid.Column="1" Margin="0,15,10,10" ItemsSource="{Binding MultiReceipts}" DisplayMemberPath="Label" SelectedValuePath="Label" SelectedValue="{Binding MultiSelectedReceipt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--<Label Grid.Row="1" Grid.Column="0" Margin="10,15,0,10">Select Multi Receipt Format</Label>-->
                                    <Image Source="{Binding SelectedSlipImage}"
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="10"
                                            Stretch="Uniform"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            MaxWidth="700"
                                            MaxHeight="700"/>
                                </Grid>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Save(Enter)" Name="ReceiptSettingSave"  IsDefault="True"  Grid.Column="0"  Controls:ButtonHelper.PreserveTextCase="True"  Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="35,15,0,15" Command="{Binding SaveSettingCommand}"></Button>
                                        <Button Content="Cancel (Esc)" Name="ReceiptSettingCancel" IsCancel="True"  Grid.Column="1"  Controls:ButtonHelper.PreserveTextCase="True" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Margin="20,15,10,15"  Command="{Binding CloseDetailViewCommand}" CommandParameter="/View/SettingView/Setting_Page.Xaml" ></Button>

                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
    </Grid>
</Page>
