<Page x:Class="WeighingSolution.View.PluginManagement_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:userControls="clr-namespace:WeighingSolution.UserControls"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="300" d:DesignWidth="300"
	Title="PluginManagement_Page">

    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel  Margin="0,0,0,50">
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource PluginIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25" Margin="0,5,0,5">
                          <Run FontWeight="Bold"  FontSize="25" Text="Plugin" />
                         Management</TextBlock>
                    <StackPanel Orientation="Horizontal"  HorizontalAlignment="Right" Margin="0,8,20,5">
                        <TextBox  Name="txtsearch" Width="300" Margin="0,0,0,0"  BorderBrush="{DynamicResource AccentColorBrush}" Padding="5,5,5,5" ToolTip="Search"  Text="{Binding SearchString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MetroTextBox}" >
                                    <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="True"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="Controls:TextBoxHelper.HasText" Value="false" >
                                            <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="False" />
                                            <Setter Property="Controls:TextBoxHelper.Watermark"  Value="Search Record" />
                                        </Trigger>
                                        <Trigger Property="Controls:TextBoxHelper.HasText"   Value="True">
                                            <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="True" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Name="btnSearch" IsDefault="True" HorizontalAlignment="Left" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="34" Width="34"  Margin="0,0,20,0" Command="{Binding FilterData}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="search" Margin="0,2,0,0"  Height="14" Width="14" />
                            </StackPanel>
                        </Button>
                        <TextBlock Name="txtUploadPlugin" Visibility="Collapsed" Margin="0,0,20,0" FontWeight="Bold" HorizontalAlignment="Right">
                            <Button Name="btnUploadPlugin" Controls:ButtonHelper.PreserveTextCase="True" Height="34" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Padding="20,0,20,0" Command="{Binding SelectFile}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="PlusCircle"  Margin="0,1,2,0"  Height="14" Width="14" />
                                    <TextBlock>Upload New Plugin</TextBlock>
                                </StackPanel>
                            </Button>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                    <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0" Orientation="Vertical">
                        <DataGrid Name="DatagridPluginManagement" CanUserDeleteRows="False" AutoGenerateColumns="False" ItemsSource="{Binding ViewList.View}" Margin="0,4,0,0" HorizontalAlignment="Center" CanUserAddRows="False" ScrollViewer.CanContentScroll="True" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
                                    <Setter Property="Height" Value="35"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,2,0,2"/>
                                    <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns >
                                <DataGridTextColumn>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Padding" Value="6,6,6,6"></Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Plugin Name"  Width="*" IsReadOnly="True"  Binding="{Binding PluginName}"/>
                                <DataGridTemplateColumn Header="Install Status" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Text" Value="UnInstalled" />
                                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ISInstall}" Value="True">
                                                                <Setter Property="Text" Value="Installed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Plugin Status" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Text" Value="Disabled" />
                                                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnable}" Value="True">
                                                                <Setter Property="Text" Value="Enabled" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Action" Width="*" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock  VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ISInstall}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Hyperlink Name="InstallPlugin" CommandParameter="{Binding}" TextDecorations="none" 
                                                           Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                         <Image Height="20" Width="20" HorizontalAlignment="Left" ToolTip="Install Plugin" Source="/Images/active.png" />
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock  VerticalAlignment="Center">
                                                    <Hyperlink Name="UnInstallPlugin" CommandParameter="{Binding}" TextDecorations="none" 
                                                           Command="{Binding DataContext.UnInstallCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                         <Image Height="20" Width="20" HorizontalAlignment="Left" ToolTip="Uninstall/Remove Plugin" Source="/Images/close.png" />
                                                    </Hyperlink>
                                                </TextBlock>
                                                <Button Margin="5,0,5,0" Cursor="Hand" VerticalAlignment="Center" Visibility="{Binding ISInstall, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        CommandParameter="{Binding}" Command="{Binding DataContext.EnableDisableCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType='Button'>
                                                                        <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" ToolTip="Click to Enable Plugin" Margin="0,0,0,0">
                                                                            <Rectangle.OpacityMask>
                                                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource ThumbUpIcon}" />
                                                                            </Rectangle.OpacityMask>
                                                                        </Rectangle>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnable}" Value="True">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType='Button'>
                                                                                <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" ToolTip="Click to Disable Plugin" Margin="0,0,0,0">
                                                                                    <Rectangle.OpacityMask>
                                                                                        <VisualBrush Stretch="Uniform" Visual="{StaticResource ThumbDownIcon}" />
                                                                                    </Rectangle.OpacityMask>
                                                                                </Rectangle>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Name="btnPluginSetting" Margin="5,0,5,0" Cursor="Hand" VerticalAlignment="Center"  Visibility="{Binding IsConfigur, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    CommandParameter="{Binding}" Command="{Binding DataContext.PluginsettingCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                        
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType='Button'>
                                                                        <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" ToolTip="Click to configure this plugin" Margin="0,0,0,0">
                                                                            <Rectangle.OpacityMask>
                                                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource SettingsIcon}" />
                                                                            </Rectangle.OpacityMask>
                                                                        </Rectangle>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <!--<Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnable}" Value="True">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType='Button'>
                                                                                <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" ToolTip="Click to Disable Plugin" Margin="0,0,0,0" Visibility="{Binding Active,Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                                                                                    <Rectangle.OpacityMask>
                                                                                        <VisualBrush Stretch="Uniform" Visual="{StaticResource ThumbDownIcon}" />
                                                                                    </Rectangle.OpacityMask>
                                                                                </Rectangle>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>-->
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel HorizontalAlignment="Center" Visibility="{Binding HasData,Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                            <TextBlock Name="txtmsg" FontSize="20" Opacity="0.5" Margin="5,5,5,5" >No Record Exist</TextBlock>
                        </StackPanel>
                        <userControls:PaginationElements x:Name="ucPager" Visibility="{Binding HasData,Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                    </StackPanel>
                </csc:ScrollViewerEx>
            </StackPanel>
        </DockPanel>
        <DockPanel>
            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Go To Setting (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="PlugiManagementListCancel" Grid.Row="0" Grid.Column="0" Height="30"  Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Margin="45,30,10,50" Command="{Binding BackToSetting}"></Button>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
