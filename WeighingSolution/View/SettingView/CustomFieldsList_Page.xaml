<Page x:Class="WeighingSolution.View.CustomFieldsList_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="600" d:DesignWidth="800"
	Title="CustomFieldsList_Page">
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100" >
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource CustomIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="Field" />
                         Settings</TextBlock>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <!--<StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0" Orientation="Vertical" >-->
                <TabControl Margin="0,10,0,35" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" BorderThickness="0" SelectedIndex="0" SelectedItem="{Binding SelectedTabItem}">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Grid Name="Panel">
                                            <Border Name="Border" CornerRadius="3,3,0,0" Padding="15,6" Margin="10,0,0,0" BorderBrush="{DynamicResource AccentColorBrush}">
                                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentColorBrush}" />
                                                <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="{StaticResource BlackBrush}" />
                                                <Setter Property="BorderThickness" Value="1"  TargetName="Border"></Setter>
                                                <Setter Property="TextElement.FontWeight" Value="Normal" TargetName="ContentSite"></Setter>
                                                <Setter Property="TextElement.FontSize" Value="13" TargetName="ContentSite"></Setter>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentColorBrush4}" />
                                                <Setter Property="TextElement.Foreground" TargetName="ContentSite" Value="{StaticResource BlackBrush}" />
                                                <Setter Property="BorderThickness" Value="0"  TargetName="Border"></Setter>
                                                <Setter Property="TextElement.FontWeight" Value="Normal" TargetName="ContentSite"></Setter>
                                                <Setter Property="TextElement.FontSize" Value="13" TargetName="ContentSite"></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="Custom Field" Margin="0,0,0,0" Tag="Custom">
                            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto">
                            <!--<StackPanel VerticalAlignment="Stretch" Margin="0,-6,0,0" Orientation="Vertical">-->
                                <DataGrid Name="DatagridCustomFields" CanUserDeleteRows="False" AutoGenerateColumns="False"  ItemsSource="{Binding CustomFields}" Margin="0,2,0,0" 
                                      HorizontalAlignment="Center" CanUserAddRows="False">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" >
                                            <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
                                            <Setter Property="Height" Value="35"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                            <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns >
                                        <DataGridTemplateColumn  Width="*" Header="Visible">
                                            <DataGridTemplateColumn.HeaderStyle>
                                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Height" Value="35"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                                    <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                                </Style>
                                            </DataGridTemplateColumn.HeaderStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Name="cbVisiblecustomfield" HorizontalAlignment="Center" IsChecked="{Binding IsVisible,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  >
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn  Width="*" Header="Display Name" >
                                            <DataGridTemplateColumn.HeaderStyle>
                                                <Style TargetType="{x:Type DataGridColumnHeader}"  >
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Height" Value="35"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                                    <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                                </Style>
                                            </DataGridTemplateColumn.HeaderStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Width="150" Name="txtDisplayName" Text="{Binding DisplayName, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Path=IsVisible}">
                                                        <TextBox.Style>
                                                            <Style  TargetType="TextBox">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsEnabled" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush2}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn  Width="*" Header="Max Length">
                                            <DataGridTemplateColumn.HeaderStyle>
                                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Height" Value="35"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                                    <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                                </Style>
                                            </DataGridTemplateColumn.HeaderStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Width="150" Text="{Binding MaxLength,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" Header="Default Value">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="{x:Type DataGridColumnHeader}">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Height" Value="35"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                            <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Width="150" Name="txtDefaultValue"
                     Text="{Binding DefaultValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding Path=IsVisible}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush2}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" Header="Editable">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="{x:Type DataGridColumnHeader}">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Height" Value="35"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                            <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Name="cbEditableCustomField" HorizontalAlignment="Center"
                      IsChecked="{Binding Editable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn  Width="*" Header="Required">
                                            <DataGridTemplateColumn.HeaderStyle>
                                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Height" Value="35"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                                    <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                                </Style>
                                            </DataGridTemplateColumn.HeaderStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Name="cbRequiredcustomfield"  HorizontalAlignment="Center" IsChecked="{Binding IsRequired,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                        <!--</StackPanel>-->
                        </csc:ScrollViewerEx>
                    </TabItem>
                    <TabItem Header="Master Field" Margin="0,0,0,0" Tag="Master">
                        <!--<StackPanel VerticalAlignment="Stretch" Margin="0,-6,0,0"  Orientation="Vertical">-->
                            <DataGrid Name="DatagridMasterFields" CanUserDeleteRows="False" AutoGenerateColumns="False" ItemsSource="{Binding MastersFields}" Margin="0,2,0,0" HorizontalAlignment="Left" CanUserAddRows="False" >
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" >
                                        <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"></Setter>
                                        <Setter Property="Height" Value="35"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns >
                                    <DataGridTemplateColumn  Width="200" Header="Visible">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Height" Value="35"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                                <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Name="cbVisibleMasterfield" HorizontalAlignment="Center" IsChecked="{Binding Path=Isvisible,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn  Width="200" Header="Field Name" IsReadOnly="True">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="{x:Type DataGridColumnHeader}"  >
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Height" Value="35"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                                <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Label  HorizontalAlignment="Center"  Content="{Binding Path=FieldName,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn  Width="200" Header="Required">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Height" Value="35"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                                <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox  Name="cbRequiredmasterfield" HorizontalAlignment="Center" IsChecked="{Binding Path=IsRequired,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="*">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Height" Value="35"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                                <Setter Property="Margin" Value="0,0,0,0"></Setter>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        <!--</StackPanel>-->
                    </TabItem>
                </TabControl>
            <!--</StackPanel>-->
        </DockPanel>
        <DockPanel>
            <!--<StackPanel DockPanel.Dock="Bottom">
                <Label Content="Is Master"></Label>
                <Label Content="{Binding IsMasterSelected}"></Label>
                <Label Content="Is Custom"></Label>
                <Label Content="{Binding IsCustomSelected}"></Label>
            </StackPanel>-->
            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Save Custom Field (Enter)" Visibility="{Binding IsCustomSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Controls:ButtonHelper.PreserveTextCase="True" Name="btnCustomFieldSave" IsDefault="True" Grid.Row="0" Grid.Column="0" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="35,30,0,50" Command="{Binding SaveCustomFieldCommand}"></Button>
                <Button Content="Save Master Field (Enter)" Visibility="{Binding IsMasterSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Controls:ButtonHelper.PreserveTextCase="True" Name="btnMasterFieldSave" IsDefault="True" Grid.Row="0" Grid.Column="0" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="35,30,0,50" Command="{Binding SaveMasterFieldCommand}"></Button>
                <Button Content="Go To Setting (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="FieldSettingCancel" Grid.Row="0" Grid.Column="1" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Margin="25,30,10,50" Command="{Binding CloseDetailViewCommand}" CommandParameter="/View/SettingView/Setting_Page.Xaml"  ></Button>
            </Grid>
        </DockPanel>
    </Grid>
</Page>