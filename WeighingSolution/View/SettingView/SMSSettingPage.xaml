<simpleChildWindow:ChildWindow 
      x:Class="WeighingSolution.View.SMSSettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:simpleChildWindow="clr-namespace:MahApps.Metro.SimpleChildWindow;assembly=MahApps.Metro.SimpleChildWindow"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"     
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      xmlns:shared="clr-namespace:WeighingSolution.SharedComponents;assembly=WeighingSolution.SharedComponents"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents" xmlns:xCeedDD="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit" xmlns:viewmodel="clr-namespace:WeighingSolution.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:VmSMSSetting}"
    mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="500"
      CloseByEscape="True"  AllowMove="True" BorderBrush="{DynamicResource AccentBaseColorBrush}" BorderThickness="1" GlowBrush="{DynamicResource AccentColorBrush}"
      ShowCloseButton="True" HorizontalContentAlignment="Center" IsModal="True" VerticalContentAlignment="Center" EnableDropShadow="False"	Title="SMSSetting">
     <simpleChildWindow:ChildWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Margin="4" TextTrimming="CharacterEllipsis" Text=" SMS Setting" FontFamily="Arial" FontWeight="Bold"/>
        </DataTemplate>
    </simpleChildWindow:ChildWindow.TitleTemplate>
    <simpleChildWindow:ChildWindow.OverlayBrush>
        <SolidColorBrush Opacity="0.7" Color="{StaticResource BlackColor}" />
    </simpleChildWindow:ChildWindow.OverlayBrush>

    <simpleChildWindow:ChildWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="b2v" />
        </ResourceDictionary>
    </simpleChildWindow:ChildWindow.Resources>

    <StackPanel Background="{DynamicResource WhiteBrush}" >
        <StackPanel Name="stkSetting" Margin="5">           

            <StackPanel Name="stkJsonAdd" >

                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="rdbSMSsetting" Name="rdbAPI" IsChecked="True" Margin="10,10,0,0">API</RadioButton>
                    <RadioButton GroupName="rdbSMSsetting" Name="rdbGSMModem" Margin="50,10,0,0">GSM Modem</RadioButton>
                </StackPanel>

                <Grid Margin="0,0,0,10" x:Name="GSMGrid" Visibility="{Binding IsChecked, ElementName=rdbGSMModem,Converter={StaticResource b2v}}">
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"></ColumnDefinition>
                                <ColumnDefinition Width="1.5*"></ColumnDefinition>
                                <ColumnDefinition Width="1*"></ColumnDefinition>
                                <ColumnDefinition Width="1.5*"></ColumnDefinition>
                                <ColumnDefinition Width="1.5*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,15,0,10" Orientation="Horizontal">
                                <Label Name="lblSerialPort" Content="Serial Port" ></Label>
                                <Label Foreground="Red">*</Label>
                            </StackPanel>
                            <xCeedDD:AutoCompleteBox Grid.Row="0" Name="cmbSerialPort" Margin="30,15,10,10" VerticalAlignment="Top" Grid.Column="1"  
                                                                                Text="{Binding JsonComPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                Padding="5,5,5,5" Foreground="{DynamicResource BlackBrush}" 
                                                     ItemsSource="{Binding COMPorts}"
                                                     Background="{DynamicResource WhiteBrush}"/>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,15,0,10" Orientation="Horizontal">
                                <Label Name="lblBaudRate" Content="Baud Rate" ></Label>
                                <Label Foreground="Red">*</Label>
                            </StackPanel>
                            <ComboBox Name="cmbBaudRate" Grid.Row="1" Grid.Column="1" Margin="30,15,10,10" SelectedValue="{Binding JsonBaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" >
                                <ComboBoxItem Content="75"  Tag="75" ></ComboBoxItem>
                                <ComboBoxItem Content="110"  Tag="110" ></ComboBoxItem>
                                <ComboBoxItem Content="134"  Tag="134" ></ComboBoxItem>
                                <ComboBoxItem Content="150"  Tag="150" ></ComboBoxItem>
                                <ComboBoxItem Content="300"  Tag="300" ></ComboBoxItem>
                                <ComboBoxItem Content="600"  Tag="600" ></ComboBoxItem>
                                <ComboBoxItem Content="1200"  Tag="1200" ></ComboBoxItem>
                                <ComboBoxItem Content="1800"  Tag="1800" ></ComboBoxItem>
                                <ComboBoxItem Content="2400" Tag="2400"></ComboBoxItem>
                                <ComboBoxItem Content="4800" Tag="4800"></ComboBoxItem>
                                <ComboBoxItem Content="7200"  Tag="7200" ></ComboBoxItem>
                                <ComboBoxItem IsSelected="True" Content="9600" Tag="9600"></ComboBoxItem>
                                <ComboBoxItem Content="14400"  Tag="14400" ></ComboBoxItem>
                                <ComboBoxItem Content="19200"  Tag="19200" ></ComboBoxItem>
                                <ComboBoxItem Content="38400" Tag="38400"></ComboBoxItem>
                                <ComboBoxItem Content="57600" Tag="57600"></ComboBoxItem>
                                <ComboBoxItem Content="115200"  Tag="115200" ></ComboBoxItem>
                                <ComboBoxItem Content="128000"  Tag="128000" ></ComboBoxItem>
                                <ComboBoxItem Content="230400"  Tag="230400" ></ComboBoxItem>
                                <ComboBoxItem Content="921600"  Tag="921600" ></ComboBoxItem>
                            </ComboBox>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,15,0,10" Orientation="Horizontal">
                                <Label Name="lblParity" Content="Parity" ></Label>
                                <Label Foreground="Red">*</Label>
                            </StackPanel>
                            <ComboBox Name="cmbParity" Grid.Row="2" Grid.Column="1" Margin="30,15,10,10" SelectedValue="{Binding JsonParity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="None" IsSelected="True" Tag="None"></ComboBoxItem>
                                <ComboBoxItem Content="Odd" Tag="Odd"></ComboBoxItem>
                                <ComboBoxItem Content="Even" Tag="Even"></ComboBoxItem>
                                <ComboBoxItem Content="Mark" Tag="Mark"></ComboBoxItem>
                                <ComboBoxItem Content="Space" Tag="Space"></ComboBoxItem>
                            </ComboBox>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,15,0,10" Orientation="Horizontal">
                                <Label Name="lblDataBits" Content="Data Bits" ></Label>
                                <Label Foreground="Red">*</Label>
                            </StackPanel>
                            <ComboBox Name="cmbDataBits" Grid.Row="0" Grid.Column="3" Margin="0,15,10,10" SelectedValue="{Binding JsonDataBits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" >
                                <ComboBoxItem Content="7"  Tag="7"></ComboBoxItem>
                                <ComboBoxItem Content="8" IsSelected="True" Tag="8"></ComboBoxItem>
                            </ComboBox>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,15,0,10" Orientation="Horizontal">
                                <Label Name="lblStopBits" Content="Stop Bits" ></Label>
                                <Label Foreground="Red">*</Label>
                            </StackPanel>
                            <ComboBox Name="cmbStopBits" Grid.Row="1" Grid.Column="3" Margin="0,15,10,10" SelectedValue="{Binding JsonStopBits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" >
                                <ComboBoxItem  Content="1" IsSelected="True" Tag="One"></ComboBoxItem>
                                <ComboBoxItem Content="1.5" Tag="OnePointFive"></ComboBoxItem>
                                <ComboBoxItem Content="2" Tag="Two"></ComboBoxItem>
                            </ComboBox>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,15,0,10" Orientation="Horizontal" >
                                <Label Name="lblHandShake" Content="Handshake" ></Label>
                                <Label Foreground="Red">*</Label>
                            </StackPanel>
                            <ComboBox Name="cmbHandShake" Grid.Row="2" Grid.Column="3" Margin="0,15,10,10" SelectedValue="{Binding JsonHandShake, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" >
                                <ComboBoxItem Content="None" IsSelected="True" Tag="None"></ComboBoxItem>
                                <ComboBoxItem Content="RequestToSend" Tag="RequestToSend"></ComboBoxItem>
                                <ComboBoxItem Content="RequestToSendXOnXOff" Tag="RequestToSendXOnXOff"></ComboBoxItem>
                                <ComboBoxItem Content="XOnXOff" Tag="XOnXOff"></ComboBoxItem>
                            </ComboBox>

                            <Button Grid.Row="4" Grid.Column="1" Content="Save" HorizontalAlignment="Right" Padding="5" Margin="0,10,10,10" 
                        VerticalAlignment="Bottom"  Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource  mouseoverstyle}" 
                        Name="SMSGSMJsonSettingSave"   BorderBrush="{DynamicResource AccentColorBrush}" Height="30" 
                        Command="{Binding SaveGSMSettingCommand}" ></Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10" x:Name="APIGrid" Visibility="{Binding IsChecked,ElementName=rdbAPI,Converter={StaticResource b2v}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <StackPanel  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,15,0,10">
                        <Label Foreground="red">SMS Receiver No = {0}, Message Text = {1} </Label>
                    </StackPanel>
                    <StackPanel  Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="10,15,0,10">
                        <Label >Provider Name</Label>
                        <Label Foreground="red">*</Label>
                    </StackPanel>
                    <TextBox Name="txtProviderName" MaxLength="250"  Grid.Row="1" Grid.Column="1" Margin="0,15,10,10"  
                             Text="{Binding JsonProvider,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel  Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="10,15,0,10">
                        <Label >Api Url</Label>
                        <Label Foreground="red">*</Label>
                    </StackPanel>
                    <TextBox Name="txtApiUrl" MaxLength="250"  Grid.Row="2" Grid.Column="1" Margin="0,15,10,10"  
                             Text="{Binding JsonApiUrl,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>


                    <Button Grid.Row="3" Grid.Column="0" Content="Save" HorizontalAlignment="Right" Padding="5" Margin="0,10,10,10" 
                        VerticalAlignment="Bottom"  Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource  mouseoverstyle}" 
                        Name="SMSJsonSettingSave"  BorderBrush="{DynamicResource AccentColorBrush}" Height="30" 
                        Command="{Binding SaveAPISettingCommand}" ></Button>
                </Grid>

            </StackPanel>



            <Border Height="1" Background="{StaticResource AccentColorBrush}" HorizontalAlignment="Stretch"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,20,0,20">
                <Label>SMS To:</Label>
                <TextBox MaxLength="250" Width="600" Text="{Binding SMSTo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"></TextBox>
                <Button Name="btnTestSMS" Margin="15,0,0,0" Controls:ButtonHelper.PreserveTextCase="True"
                        Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" 
                        Command="{Binding SendTestSMS}">Send Test SMS</Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</simpleChildWindow:ChildWindow>
