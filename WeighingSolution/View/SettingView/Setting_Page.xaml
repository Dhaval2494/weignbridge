<Page
    x:Class="WeighingSolution.View.Setting_Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Setting_Page"
    d:DesignHeight="600"
    d:DesignWidth="800"
    Style="{DynamicResource MetroPage}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100">
            <StackPanel
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                DockPanel.Dock="Top">
                <DockPanel Margin="10,0,0,0">
                    <!--<Image Source="/Images/setting.png" Width="25" Height="25" Margin="0,3,0,0" ></Image>-->
                    <Rectangle
                        Width="25"
                        Height="25"
                        Margin="0,3,5,0"
                        Fill="{DynamicResource BlackBrush}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource SettingsIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                        <Run
                            FontSize="25"
                            FontWeight="Bold"
                            Text="System" />
                        Settings</TextBlock>
                </DockPanel>
                <Border
                    Height="4"
                    Margin="0,4,1,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{DynamicResource AccentColorBrush}"
                    BorderThickness="0" />
            </StackPanel>
            <csc:ScrollViewerEx VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    Margin="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                    <Grid Name="gridSettings">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox
                            Name="gbDatabaseSetting"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="Database Settings" />
                            </GroupBox.Header>
                            <Grid>
                                <Button
                                    x:Name="btnGoToDatabaseSetting"
                                    Height="120"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush2}"
                                    Click="btnGoToDatabaseSetting_Click"
                                    Style="{StaticResource btnnew}">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <Rectangle
                                            Width="50"
                                            Height="50"
                                            Margin="0,0,0,0"
                                            Fill="{DynamicResource BlackBrush}">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource DatabaseIcon}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Database Settings" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox
                            Name="gbGlobalSetting"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="Global Settings" />
                            </GroupBox.Header>
                            <Grid>
                                <Button
                                    Name="btnGoToGlobalSetting"
                                    Height="120"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush2}"
                                    Click="btnGoToGlobalSetting_Click"
                                    Style="{StaticResource btnnew}">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <Rectangle
                                            Width="50"
                                            Height="50"
                                            Margin="0,0,0,0"
                                            Fill="{DynamicResource BlackBrush}">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource GlobalSetting}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Global Settings" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox
                            Name="gbCompanySetting"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="Company Settings" />
                            </GroupBox.Header>
                            <Grid>
                                <Button
                                    Name="btnGoToCompanySetting"
                                    Height="120"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush2}"
                                    Click="btnGoToCompanySetting_Click"
                                    Style="{StaticResource btnnew}">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <Rectangle
                                            Width="50"
                                            Height="50"
                                            Margin="0,0,0,0"
                                            Fill="{DynamicResource BlackBrush}">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource CompanyIcon}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Company Settings" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox
                            Name="gbCertificateSetting"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="Certificate Setting" />
                            </GroupBox.Header>
                            <Grid>
                                <Button
                                    Name="btnGoToCertificateSetting"
                                    Height="120"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush2}"
                                    Click="BtnGoToCertificateSetting_Click"
                                    Style="{StaticResource btnnew}">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <Rectangle
                                            Width="50"
                                            Height="50"
                                            Margin="0,0,0,0"
                                            Fill="{DynamicResource BlackBrush}">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource StampCertificate}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Certificate Setting" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox
                            Name="gbFieldSetting"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="Field Setting" />
                            </GroupBox.Header>
                            <Grid>
                                <Button
                                    x:Name="BtnGoToFieldSetting"
                                    Height="120"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush2}"
                                    Click="BtnGoToFieldSetting_Click"
                                    Style="{StaticResource btnnew}">
                                    <StackPanel>
                                        <Rectangle
                                            Width="50"
                                            Height="50"
                                            Margin="0,0,0,0"
                                            Fill="{DynamicResource BlackBrush}">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource SlipIcon}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Field Setting" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox
                            Name="gbEmailSetting"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="Email Setting" />
                            </GroupBox.Header>
                            <Grid>
                                <Button
                                    x:Name="btnGoToEmailSetting"
                                    Height="120"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush2}"
                                    Click="btnGoToEmailSetting_Click"
                                    Style="{DynamicResource btnnew}">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <Rectangle
                                            Width="50"
                                            Height="50"
                                            Margin="0,0,0,0"
                                            Fill="{DynamicResource BlackBrush}">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource EmailIcon}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Email Setting" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox
                            Name="gbSMSSetting"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="SMS Setting" />
                            </GroupBox.Header>
                            <Grid>
                                <Button
                                    x:Name="btnGoToSMSSetting"
                                    Height="120"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush2}"
                                    Click="btnGoToSMSSetting_Click"
                                    Style="{DynamicResource btnnew}">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <Image
                                            Width="50"
                                            Height="50"
                                            Margin="0,0,0,0"
                                            Source="/Images/sms.png" />
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="SMS Setting" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox
                            Name="gbBarcodeTile"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="Barcode and QRcode Setting" />
                            </GroupBox.Header>
                            <Button
                                x:Name="btnGoToBarcodeSetting"
                                Height="120"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentColorBrush2}"
                                Click="btnGoToBarcodeSetting_Click"
                                Style="{StaticResource btnnew}">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Rectangle
                                        Width="50"
                                        Height="50"
                                        Margin="0,0,0,0"
                                        Fill="{DynamicResource BlackBrush}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{StaticResource BarcodeIcon}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="Barcode and QRcode Setting" />
                                </StackPanel>
                            </Button>
                        </GroupBox>

                        <GroupBox
                            Name="gbPluginSetting"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="Plugin Management" />
                            </GroupBox.Header>
                            <Grid>
                                <Button
                                    x:Name="BtnGoToPluginSetting"
                                    Height="120"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush2}"
                                    Click="BtnGoToPluginSetting_Click"
                                    Style="{StaticResource btnnew}">
                                    <StackPanel>
                                        <Rectangle
                                            Width="50"
                                            Height="50"
                                            Margin="0,0,0,0"
                                            Fill="{DynamicResource BlackBrush}">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource PluginIcon}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Plugin Management" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <!--<GroupBox Name="gbPrintSetting" Visibility="Collapsed" Background="{DynamicResource AccentColorBrush}" Margin="10"  Height="120" VerticalAlignment="Center" >
                            <GroupBox.Header>
                                <TextBlock Text="Print Setting" FontWeight="Bold"/>
                            </GroupBox.Header>
                            <Grid>
                                <Button Style="{DynamicResource btnnew}" x:Name="btnGoToPrintSetting"  HorizontalAlignment="Stretch"  Height="120"  VerticalAlignment="Center"   Margin="0,0,0,0" Click="btnGoToPrintSetting_Click" Background="{DynamicResource AccentColorBrush2}">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <Image Source="/Images/printing.png"  Width="50" Height="50" Margin="0,0,0,0" />
                                        <TextBlock Margin="5,0,0,0" Text="Print Setting" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>-->

                        <GroupBox
                            Name="gbAppTheme"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="Application Theme" />
                            </GroupBox.Header>
                            <Grid>
                                <Button
                                    x:Name="BtnGoToAppTheme"
                                    Height="120"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush2}"
                                    Click="BtnGoToAppTheme_Click"
                                    Style="{StaticResource btnnew}">
                                    <StackPanel>
                                        <Rectangle
                                            Width="50"
                                            Height="50"
                                            Margin="0,0,0,0"
                                            Fill="{DynamicResource BlackBrush}">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource AppTheamIcon}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Application Theme" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox
                            Name="gbLicenseManagement"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="License Management" />
                            </GroupBox.Header>
                            <Grid>
                                <Button
                                    x:Name="btnGoTORenewLicense"
                                    Height="120"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush2}"
                                    Click="btnGoTORenewLicense_Click"
                                    Style="{StaticResource btnnew}">
                                    <StackPanel>
                                        <Rectangle
                                            Width="50"
                                            Height="50"
                                            Margin="0,0,0,0"
                                            Fill="{DynamicResource BlackBrush}">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource LicenseIcon}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="License Management" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox
                            Name="gbReceiptManagement"
                            Height="120"
                            Margin="10"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorBrush}"
                            Visibility="Collapsed">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold" Text="Receipt Management" />
                            </GroupBox.Header>
                            <Grid>
                                <Button
                                    x:Name="BtnGoToReceipt"
                                    Height="120"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorBrush2}"
                                    Click="BtnGoToReceipt_Click"
                                    Style="{StaticResource btnnew}">
                                    <StackPanel>
                                        <Rectangle
                                            Width="50"
                                            Height="50"
                                            Margin="0,0,0,0"
                                            Fill="{DynamicResource BlackBrush}">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource MasterReportIcon}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="Receipt Management" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                        <GroupBox Visibility="Collapsed" Name="gbAPIManagement" Background="{DynamicResource AccentColorBrush}" Margin="10"  Height="120" VerticalAlignment="Center" >
                            <GroupBox.Header>
                                <TextBlock Text="API Management" FontWeight="Bold"/>
                            </GroupBox.Header>
                            <Grid>
                                <Button Style="{StaticResource btnnew}" x:Name="BtnGoToAPI"  HorizontalAlignment="Stretch"  Height="120"  VerticalAlignment="Center"   Margin="0,0,0,0" Background="{DynamicResource AccentColorBrush2}" Click="BtnGoToAPI_Click">
                                    <StackPanel>
                                        <Rectangle Width="50" Height="50" Fill="{DynamicResource BlackBrush}" Margin="0,0,0,0">
                                            <Rectangle.OpacityMask>
                                                <VisualBrush Stretch="Uniform" Visual="{StaticResource InformationIcon}" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock Margin="5,0,0,0" Text="API Management" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </GroupBox>

                    </Grid>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
    </Grid>
</Page>
