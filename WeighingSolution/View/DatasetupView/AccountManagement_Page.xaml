<Page x:Class="WeighingSolution.View.AccountManagement_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Style="{DynamicResource MetroPage}"
	Title="AccountManagement_Page"
      FocusManager.FocusedElement="{Binding ElementName=txtCompanyName}" >

    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100" >
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource UserGroupIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="Account" />
                         Management</TextBlock>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto"   VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="10,15,0,10" Grid.Row="0" Grid.Column="0">
                            <Label >Company Name</Label>
                            <Label Foreground="red">*</Label>
                        </StackPanel>
                        <TextBox Name="txtCompanyName" MaxLength="250" Grid.Column="1" Grid.Row="0" Margin="0,15,10,10" Text="{Binding Model.CompanyName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10,15,0,10" Orientation="Horizontal">
                            <Label Name="lblRole" >Role</Label>
                            <Label Foreground="red">*</Label>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1"  Margin="10,15,0,10">
                            <CheckBox Name="cbaccount" Margin="0,0,150,0" IsChecked="{Binding Model.IsAccount,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">Account</CheckBox>
                            <CheckBox Name="cbTransporter" Grid.Column="1" Margin="0,0,5,0" IsChecked="{Binding Model.IsTransporter,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >Transporter
                            </CheckBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="10,15,0,10" Orientation="Horizontal">
                            <Label Name="lblfnm">First Name</Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <TextBox Name="txtFirstName" MaxLength="250" Grid.Row="2" Grid.Column="1" Margin="0,15,10,10" Text="{Binding Model.FirstName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Grid.Row="3" Grid.Column="0" Margin="10,15,0,10">Last Name</Label>
                        <TextBox  MaxLength="250" Name="txtLastName" Grid.Row="3" Grid.Column="1"   Margin="0,15,10,10" Text="{Binding Model.LastName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Grid.Row="4" Grid.Column="0" Margin="10,15,0,10">Account Code</Label>
                        <TextBox Grid.Row="4" Grid.Column="1" Name="txtAccountCode" MaxLength="50" Margin="0,15,10,10"  Text="{Binding Model.AccountCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <!--<Label Grid.Row="5" Grid.Column="0" Margin="10,15,0,10">Notes</Label>
                        <TextBox AcceptsReturn="True" Grid.Row="5" Grid.ColumnSpan="4" Margin="0,15,10,10" Height="45" Grid.Column="1" Text="{Binding Path=Notes}" />-->
                        <Label Grid.Row="0" Grid.Column="2" Margin="10,15,0,10">Contact No</Label>
                        <csc:FilteredTextbox  FilterRegex="^([0-9\s\(\)\+\-]*)$" Grid.Row="0" Grid.Column="3" Name="txtContactNo" MaxLength="20" Margin="0,15,10,10"  Text="{Binding Model.ContactNo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="1" Grid.Column="2" Margin="10,15,0,10">Email</Label>
                        <TextBox  Name="txtEmail" MaxLength="250" Grid.Row="1" Grid.Column="3" Margin="0,15,10,10"  Text="{Binding Model.Email,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,TargetNullValue=''}" />
                        <Label Grid.Row="2" Grid.Column="2" Margin="10,15,0,10">Address</Label>
                        <TextBox Grid.Row="2"  Grid.Column="3" Name="txtAddress" MaxLength="500" Margin="0,15,10,10" Text="{Binding Model.Address,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Grid.Row="3" Grid.Column="2" Margin="10,15,0,10">City</Label>
                        <TextBox Name="txtCity" MaxLength="100" Grid.Row="3" Grid.Column="3"   Margin="0,15,10,10" Text="{Binding Model.City,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="4" Grid.Column="2" Margin="10,15,0,10">Pincode</Label>
                        <TextBox Name="txtPincode" MaxLength="20" Grid.Row="4" Grid.Column="3" Margin="0,15,10,10"  Text="{Binding Model.Pincode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Margin="10,15,0,10">Notes</Label>
                        <TextBox AcceptsReturn="True" Grid.Row="0" Grid.ColumnSpan="4" Margin="0,15,10,10" Height="45" Grid.Column="1" Text="{Binding Model.Notes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
        <DockPanel>
            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Save (Enter)" Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource  mouseoverstyle}"  IsDefault="True" Name="AccountSave" Grid.Row="0" Grid.Column="0"   BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="45,30,0,50" Command="{Binding SaveCommand}"></Button>
                <Button Content="Cancel (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="AccountManagementCancel" Grid.Row="0" Grid.Column="1" Height="30"  Style="{DynamicResource  mouseoverstyle}"   BorderBrush="{DynamicResource AccentColorBrush}" Margin="25,30,10,50" Command="{Binding CloseDetailViewCommand}"></Button>
            </Grid>
        </DockPanel>
    </Grid>

</Page>
    
