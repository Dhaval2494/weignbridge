<Page x:Class="WeighingSolution.View.TokenManagementList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      xmlns:shared="clr-namespace:WeighingSolution.SharedComponents;assembly=WeighingSolution.SharedComponents"
      xmlns:strFormat="clr-namespace:WeighingSolution.DataLayer;assembly=WeighingSolution.DataLayer"
       xmlns:userControls1="clr-namespace:WeighingSolution.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300"
      Style="{DynamicResource MetroPage}"
	  Title="TokenManagementList">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="Dictionary1.xaml"/>-->
                <shared:DesignTimeResourceDictionary DesignTimeSource="pack://application:,,,/WeighingSolution.SharedComponents;component/Styles/MetroStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converter:MultiBindingConverter x:Key="MultiBindingConverter" />
            <converter:EqualityVisibilityConverter x:Key="EqualityVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100" >
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}"  Margin="0,3,3,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource TokenIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25" VerticalAlignment="Center">
                          <Run FontWeight="Bold"  FontSize="25" Text="Token" />
                         Management</TextBlock>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,8,20,5" >
                        <TextBox  Name="txtsearch" Width="300" Margin="0,0,0,0"  BorderBrush="{DynamicResource AccentColorBrush}" Padding="5,5,5,5" ToolTip="Search"  Text="{Binding SearchString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MetroTextBox}" >
                                    <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="True"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="Controls:TextBoxHelper.HasText" Value="false" >
                                            <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="False" />
                                            <Setter Property="Controls:TextBoxHelper.Watermark"  Value="Search Record" />
                                        </Trigger>
                                        <Trigger Property="Controls:TextBoxHelper.HasText"   Value="True">
                                            <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="True" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Name="btnSearch" IsDefault="True" HorizontalAlignment="Left" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="34" Width="34"  Margin="0,0,20,0" Command="{Binding FilterData}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="search" Margin="0,2,0,0"  Height="14" Width="14" />
                            </StackPanel>
                        </Button>
                        <TextBlock Name="txtbAddToken" Visibility="Visible" Margin="0,0,20,0" FontWeight="Bold" HorizontalAlignment="Right" >
                            <Button Name="btnAddToken" Click="btnAddToken_Click" Controls:ButtonHelper.PreserveTextCase="True" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Padding="20,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="PlusCircle"  Margin="0,1,2,0"  Height="14" Width="14" />
                                    <TextBlock>ADD TOKEN</TextBlock>
                                </StackPanel>
                            </Button>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto"   VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <DataGrid Name="DatagridToken" CanUserDeleteRows="False" AutoGenerateColumns="False" ItemsSource="{Binding ViewList.View}"  Margin="0,4,0,0"  CanUserAddRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Background" Value="{DynamicResource AccentColorBrush}"/>
                                <Setter Property="Height" Value="35"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
                                <Setter Property="BorderThickness" Value="0,2,0,2"/>
                                <Setter Property="Margin" Value="0,0,0,0"></Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns >
                            <DataGridTextColumn>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Padding" Value="6,6,6,6"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Token Name" Width="*" IsReadOnly="True" Binding="{Binding Path=TokenName}" />
                            <DataGridTextColumn Header="Token Value" Width="*" IsReadOnly="True" Binding="{Binding Path=TokenValue}" />
                            <DataGridTextColumn Header="Token Type" Width="*" IsReadOnly="True" Binding="{Binding Path=TokenType}" />
                            <DataGridTextColumn Header="Vehicle" Width="*" IsReadOnly="True" Binding="{Binding Path=Vehicle_Number}" />
                            <!--<DataGridTextColumn Header="Expire Date" Width="*" IsReadOnly="True" Binding="{Binding Path=TokenExpireDate,StringFormat={x:Static strFormat:Constant.DateTimeFormat}}" />-->
                            <DataGridTextColumn Header="Token Status" Width="*" IsReadOnly="True" Binding="{Binding Path=TokenStatus}" />
                            <DataGridTemplateColumn Header="Action" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" ToolTip="Edit">
                                                        <Hyperlink  Name="EditToken" TextDecorations="none"  FontWeight="Bold"
                                                                    Command="{Binding DataContext.EditObject, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                            <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                                                                  <Rectangle.OpacityMask>
                                                                       <VisualBrush Stretch="Uniform" Visual="{StaticResource EditLinkIcon}" />
                                                                  </Rectangle.OpacityMask>
                                                            </Rectangle>
                                                             <Hyperlink.CommandParameter>
                                                                <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                                                                     <Binding Path="TokenID" />
                                                                     <Binding Source="TokenManagementPage"/>
                                                                </MultiBinding>
                                                            </Hyperlink.CommandParameter>
                                                        </Hyperlink>
                                            </TextBlock>
                                            <TextBlock VerticalAlignment="Center">
                                                        <Hyperlink TextDecorations="none"  FontWeight="Bold" CommandParameter="{Binding}" Command="{Binding DataContext.StatusChangeCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                            <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0" ToolTip="Disable" Visibility="{Binding TokenStatus, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='Free'}">
                                                                  <Rectangle.OpacityMask>
                                                                       <VisualBrush Stretch="Uniform" Visual="{StaticResource ThumbDownIcon}" />
                                                                  </Rectangle.OpacityMask>
                                                            </Rectangle>
                                                            <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0" ToolTip="Free" Visibility="{Binding Isallowtokenfree, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter={StaticResource TrueValue}}">
                                                                     <Rectangle.OpacityMask>
                                                                           <VisualBrush Stretch="Uniform" Visual="{StaticResource ThumbUpIcon}" />
                                                                     </Rectangle.OpacityMask>
                                                            </Rectangle>
                                                        </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" Visibility="{Binding HasData,Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                        <TextBlock Name="txtmsg" FontSize="20" Opacity="0.5" Margin="5,5,5,5" >No Record Exist</TextBlock>
                    </StackPanel>
                    <userControls1:PaginationElements x:Name="ucPager" Visibility="{Binding HasData,Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
        <DockPanel>

            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Go To DataSetup (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="TokenListCancel" Grid.Row="0" Grid.Column="0" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Margin="45,30,10,50" Click="TokenListCancel_Click"  ></Button>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
