<simpleChildWindow:ChildWindow 
      x:Class="WeighingSolution.CameraImagePathSetting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:simpleChildWindow="clr-namespace:MahApps.Metro.SimpleChildWindow;assembly=MahApps.Metro.SimpleChildWindow"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
      mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300"
      CloseByEscape="True"  AllowMove="True" BorderBrush="{DynamicResource AccentBaseColorBrush}" BorderThickness="1" GlowBrush="{DynamicResource AccentColorBrush}"
      ShowCloseButton="True" HorizontalContentAlignment="Center" IsModal="True" VerticalContentAlignment="Center" EnableDropShadow="False"	Title="CameraImagePathSetting">
    <simpleChildWindow:ChildWindow.Resources>
        <ResourceDictionary>
            <converter:EqualityConverter x:Key="EqualityConverter" />
            <converter:EqualityVisibilityConverter x:Key="EqualityVisibilityConverter" />
            
        </ResourceDictionary>
    </simpleChildWindow:ChildWindow.Resources>
    <simpleChildWindow:ChildWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Margin="4" TextTrimming="CharacterEllipsis" Text=" Camera Setting" FontFamily="Arial" FontWeight="Bold"/>
        </DataTemplate>
    </simpleChildWindow:ChildWindow.TitleTemplate>
    <simpleChildWindow:ChildWindow.OverlayBrush>
        <SolidColorBrush Opacity="0.7" Color="{StaticResource BlackColor}" />
    </simpleChildWindow:ChildWindow.OverlayBrush>

    <StackPanel Background="{DynamicResource WhiteBrush}" Width="800px" Orientation="Horizontal" >
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <RadioButton Name="rbLocalImgPath" GroupName="ImagepathType"  Margin="10,10,0,10" IsChecked="{Binding CameraImagePathType, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='LocalImagePath'}" Command="{Binding cmdRadioChecked}" CommandParameter="LocalImagePath">Local ImagePath</RadioButton>
                <RadioButton Name="rbNetworkImgPath" GroupName="ImagepathType"  Margin="10,10,0,10" IsChecked="{Binding CameraImagePathType, Mode=TwoWay, Converter={StaticResource EqualityConverter}, ConverterParameter='NetworkImagePath'}" Command="{Binding cmdRadioChecked}" CommandParameter="NetworkImagePath" >Network ImagePath</RadioButton>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Name="lblImagePath"   Margin="10,10,0,10"  HorizontalAlignment="Left">Image Path:</Label>
                <StackPanel Name="stkLocalImgpath" Orientation="Horizontal" Visibility="{Binding CameraImagePathType, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='LocalImagePath'}">
                    <Label Name="lblFilePath"  Margin="5,10,10,10" HorizontalAlignment="Left" Content="{Binding BrowseFile,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Label>
                    <Button Name="btnBrowseFile" Content="Browse Path" Height="30" HorizontalAlignment="Left" Controls:ButtonHelper.PreserveTextCase="True"   Margin="10,10,10,10" Command="{Binding SelectFile}"></Button>
                </StackPanel>
                <StackPanel Name="stkNetworkImgpath" Orientation="Horizontal" Visibility="{Binding CameraImagePathType, Converter={StaticResource EqualityVisibilityConverter}, ConverterParameter='NetworkImagePath'}">
                    <TextBox Name="txtFilePath" Margin="5,10,10,10" Padding="5" Width="500px" HorizontalAlignment="Left" Text="{Binding CameraImagePath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ></TextBox>
                </StackPanel>
                <Button Name="btnSavePath" Content="Save ImagePath" HorizontalAlignment="Right" Height="30" Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Margin="10,10,0,10" Command="{Binding SaveCommand}"></Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</simpleChildWindow:ChildWindow>
