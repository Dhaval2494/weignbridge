<Page x:Class="WeighingSolution.View.UserManagement_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Style="{DynamicResource MetroPage}"
	Title="UserManagement_Page" FocusManager.FocusedElement="{Binding ElementName=txtUserName }">
    <Grid Background="{DynamicResource WhiteBrush}" Name="GridAddUser" >
        <DockPanel Margin="0,0,0,100" >
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource UserIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="User" />
                         Management</TextBlock>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top"  Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto"   VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                            <ColumnDefinition Width="1.9*"></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="10,13,0,5" Orientation="Horizontal" >
                            <Label  >User Name</Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <TextBox Name="txtUserName" Grid.Row="0" Grid.Column="1" Margin="0,13,10,5" Text="{Binding Model.UserName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,TargetNullValue=''}"/>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10,10,0,10" Orientation="Horizontal">
                            <Label>Password</Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1"  Margin="0,10,10,10">
                            <PasswordBox csc:PasswordHelper.Attach="True"   csc:PasswordHelper.Password="{Binding Model.Password, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="10,10,0,10" Orientation="Horizontal">
                            <Label>Confirm Password</Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <PasswordBox csc:PasswordHelper.Attach="True"  Margin="0,10,10,10" csc:PasswordHelper.Password="{Binding Model.ConfirmPassword, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel  Grid.Row="3" Grid.Column="0" Margin="10,10,0,10" Orientation="Horizontal">
                            <Label >First Name</Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <TextBox Name="txtFirstName" Grid.Row="3" Grid.Column="1" Margin="0,10,10,10" Text="{Binding Model.FirstName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="4" Grid.Column="0" Margin="10,13,0,5">Last Name</Label>
                        <TextBox  Name="txtLastName"  Grid.Row="4" Grid.Column="1" Margin="0,13,10,5" Text="{Binding Model.LastName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Grid.Row="0" Grid.Column="2" Margin="10,10,0,10">Contact No</Label>
                        <csc:FilteredTextbox  FilterRegex="^([0-9\s\(\)\+\-]*)$" Name="txtContactNo" Grid.Row="0" Grid.Column="3"  MaxLength="20"  Margin="0,10,10,10" Text="{Binding Model.ContactNo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Grid.Row="1" Grid.Column="2" Margin="10,10,0,10">Email</Label>
                        <TextBox  Name="txtEmail" Grid.Row="1" Grid.Column="3" Margin="0,10,10,10" Text="{Binding Model.Email,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,TargetNullValue=''}" />
                        <Label Grid.Row="2" Grid.Column="2" Margin="10,10,0,10">Address</Label>
                        <TextBox  Name="txtAddress" Grid.Row="2" Margin="0,10,10,10" Grid.Column="3" Text="{Binding Model.Address,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="2" Margin="10,10,0,10">
                            <Label Name="lblTemplateName"  Content="User Role" ></Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <ComboBox Name="cmbTemplateName" Grid.Row="3" Grid.Column="3" Margin="0,10,10,10" Padding="2,4,2,4" ItemsSource="{Binding Templates}" SelectedValue="{Binding Model.TemplateID}" DisplayMemberPath="TemplateName" SelectedValuePath="TemplateID">
                        </ComboBox>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="11*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Margin="10,20,0,0">Notes</Label>
                        <TextBox Grid.Row="0" Grid.ColumnSpan="3" Grid.Column="1" Name="txtNotes" Margin="-8,10,17,0" Text="{Binding Model.Notes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="45" />
                    </Grid>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
        <DockPanel>
            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Save (Enter)" Controls:ButtonHelper.PreserveTextCase="True"  Name="UserManagementsave" IsDefault="True" Grid.Row="0" Grid.Column="0" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}"  Height="30" Margin="45,30,10,50" FontWeight="SemiBold" Command="{Binding SaveCommand}" ></Button>
                <Button Content="Cancel (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="UserManagementCancel" Grid.Row="0" Grid.Column="1" Height="30" Style="{DynamicResource  mouseoverstyle}"    BorderBrush="{DynamicResource AccentColorBrush}" Margin="25,30,10,50" Command="{Binding CloseDetailViewCommand}"></Button>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
