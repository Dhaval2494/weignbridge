<Page x:Class="WeighingSolution.View.GateManagement_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="600" d:DesignWidth="800"
	  Title="GateManagement_Page"
      FocusManager.FocusedElement="{Binding ElementName=txtGateName}">
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100">
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource GateIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="Gate" />
                         Management</TextBlock>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto"   VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,15,0,10" Orientation="Horizontal">
                            <Label>Gate Name</Label>
                            <Label Foreground="red">*</Label>
                        </StackPanel>
                        <TextBox Name="txtGateName"  Grid.Row="0" Grid.Column="1" Margin="0,15,0,10" Text="{Binding Model.GateName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Row="1" Margin="0,15,0,10" Orientation="Horizontal">
                            <Label>Gate Type</Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <ComboBox Grid.Row="1" Grid.Column="1" Name="cmbGateType"  Margin="0,15,0,10" SelectedValue="{Binding Model.GateType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullReplaceConverter}, ConverterParameter=''}"  SelectedValuePath="Tag" IsSynchronizedWithCurrentItem="True">
                            <ComboBoxItem  Content="Select GateType" Tag=""></ComboBoxItem>
                            <ComboBoxItem Content="IN" Tag="IN" ></ComboBoxItem>
                            <ComboBoxItem Content="OUT" Tag="OUT"></ComboBoxItem>
                            <ComboBoxItem Content="BOTH" Tag="BOTH"></ComboBoxItem>
                        </ComboBox>
                        <Label Grid.Row="2" Margin="0,15,0,10">Note</Label>
                        <TextBox Name="txtNotes" Grid.Row="2" Margin="0,15,0,10" Grid.Column="1" Padding="5,8,5,20" Text="{Binding Model.Notes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                        </TextBox>
                    </Grid>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
        <DockPanel>
            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Save (Enter)" Controls:ButtonHelper.PreserveTextCase="True" IsDefault="True" Name="GateManagementSave" Grid.Row="0" Grid.Column="0"    Style="{DynamicResource  mouseoverstyle}"   BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="45,30,0,50" Command="{Binding SaveCommand}"></Button>
                <Button Content="Cancel (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="GateManagementCancel" Grid.Row="0" Grid.Column="1" Height="30"     Style="{DynamicResource  mouseoverstyle}"   BorderBrush="{DynamicResource AccentColorBrush}" Margin="25,30,10,50" Command="{Binding CloseDetailViewCommand}"></Button>
            </Grid>
        </DockPanel>
    </Grid>
</Page>