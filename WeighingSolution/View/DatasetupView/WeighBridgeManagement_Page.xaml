<Page
    x:Class="WeighingSolution.View.WeighBridgeManagement_Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:usc="clr-namespace:WeighingSolution.UserControls"
    xmlns:xCeedDD="clr-namespace:System.Windows.Controls;assembly=System.Windows.Controls.Input.Toolkit"
    Title="WeighBridgeManagement_Page"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    FocusManager.FocusedElement="{Binding ElementName=txtScaleName}"
    Style="{DynamicResource MetroPage}"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100">
            <StackPanel
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                DockPanel.Dock="Top">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle
                        Width="25"
                        Height="25"
                        Margin="0,3,5,0"
                        Fill="{DynamicResource BlackBrush}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource WeighBridgeIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                        <Run
                            FontSize="25"
                            FontWeight="Bold"
                            Text="WeighBridge" />
                        Management</TextBlock>
                </DockPanel>
                <Border
                    Height="4"
                    Margin="0,4,1,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{DynamicResource AccentColorBrush}"
                    BorderThickness="0" />
            </StackPanel>
            <csc:ScrollViewerEx VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,0" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="2*" />

                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,15,0,10"
                            Orientation="Horizontal">
                            <Label Name="lblScaleName" Content="Scale Name" />
                            <Label Foreground="red">*</Label>
                        </StackPanel>
                        <TextBox
                            Name="txtScaleName"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,15,10,10"
                            Text="{Binding Model.ScaleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


                        <Grid
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,15,0,0"
                                Orientation="Horizontal">
                                <Label Name="lblIndicator" Content="Indicator" />
                                <Label Foreground="Red">*</Label>
                            </StackPanel>
                            <ComboBox
                                Name="cmbIndicator"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,15,10,10"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Indicators}"
                                SelectedValuePath="id">
                                <ComboBox.SelectedValue>
                                    <Binding
                                        Converter="{StaticResource NullReplaceConverter}"
                                        Path="Model.IndicatorID"
                                        UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ConverterParameter>
                                            <sys:Int32>0</sys:Int32>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </ComboBox.SelectedValue>
                            </ComboBox>

                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,15,0,10"
                                Orientation="Horizontal">
                                <Label Name="lblRegion" Content="Region" />
                                <Label Foreground="red">*</Label>
                            </StackPanel>
                            <TextBox
                                Name="txtRegion"
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="0,15,10,10"
                                Text="{Binding Model.Region, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        </Grid>

                        <Label
                            Name="lblMaxCapacity"
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,15,0,0"
                            Content="Max Capacity" />
                        <csc:FilteredTextbox
                            x:Name="txtMaxCapacity"
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="-50,15,10,10"
                            FilterRegex="^[0-9]+$"
                            Text="{Binding Model.MaxCapacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />



                        <Grid
                            Grid.Row="1"
                            Grid.Column="2"
                            Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,15,0,0"
                                Orientation="Horizontal">
                                <Label Name="lblUnit" Content="Unit" />
                                <Label Foreground="Red">*</Label>
                            </StackPanel>
                            <ComboBox
                                Name="cmbUnit"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,15,10,10"
                                DisplayMemberPath="UnitName"
                                ItemsSource="{Binding Units}"
                                SelectedValuePath="UnitID">
                                <ComboBox.SelectedValue>
                                    <Binding Converter="{StaticResource NullReplaceConverter}" Path="Model.UnitID">
                                        <Binding.ConverterParameter>
                                            <sys:Int32>0</sys:Int32>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </ComboBox.SelectedValue>
                            </ComboBox>
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,15,0,10"
                                Orientation="Horizontal">
                                <Label Name="lblConnectionType">Connection Type</Label>
                                <Label Foreground="Red">*</Label>
                            </StackPanel>
                            <ComboBox
                                Name="cmbConnectionType"
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="0,15,10,10"
                                SelectedValue="{Binding Model.ConnectionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem
                                    x:Name="iCOM"
                                    Content="COM"
                                    Tag="COM" />
                                <ComboBoxItem
                                    x:Name="iLAN"
                                    Content="LAN"
                                    Tag="LAN" />
                            </ComboBox>
                            <Label
                                Name="lblGetspeed"
                                Grid.Row="0"
                                Grid.Column="4"
                                Margin="0,15,0,0"
                                Content="Weight Speed" />
                            <csc:FilteredTextbox
                                x:Name="txtgetspeed"
                                Grid.Row="0"
                                Grid.Column="5"
                                Margin="0,15,10,10"
                                FilterRegex="^[0-9]+$"
                                Text="{Binding Model.WeightSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        </Grid>



                        <GroupBox
                            Name="gbComPort"
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Visibility="{Binding ElementName=iCOM, Path=IsSelected, Converter={StaticResource NegativeBooleanToVisibilityConverter}}"
                            Header="Com Port Settings"><!---->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,15,0,10"
                                            Orientation="Horizontal">
                                            <Label Name="lblSerialPort" Content="Serial Port" />
                                            <Label Foreground="Red">*</Label>
                                        </StackPanel>
                                        <xCeedDD:AutoCompleteBox
                                            Name="cmbSerialPort"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="30,15,10,10"
                                            Padding="5,5,5,5"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource WhiteBrush}"
                                            Foreground="{DynamicResource BlackBrush}"
                                            ItemsSource="{Binding COMPorts}"
                                            Text="{Binding Model.COMPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,15,0,10"
                                            Orientation="Horizontal">
                                            <Label Name="lblBaudRate" Content="Baud Rate" />
                                            <Label Foreground="Red">*</Label>
                                        </StackPanel>
                                        <ComboBox
                                            Name="cmbBaudRate"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="30,15,10,10"
                                            SelectedValue="{Binding Model.BaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Tag">
                                            <ComboBoxItem Content="75" Tag="75" />
                                            <ComboBoxItem Content="110" Tag="110" />
                                            <ComboBoxItem Content="134" Tag="134" />
                                            <ComboBoxItem Content="150" Tag="150" />
                                            <ComboBoxItem Content="300" Tag="300" />
                                            <ComboBoxItem Content="600" Tag="600" />
                                            <ComboBoxItem Content="1200" Tag="1200" />
                                            <ComboBoxItem Content="1800" Tag="1800" />
                                            <ComboBoxItem Content="2400" Tag="2400" />
                                            <ComboBoxItem Content="4800" Tag="4800" />
                                            <ComboBoxItem Content="7200" Tag="7200" />
                                            <ComboBoxItem Content="9600" Tag="9600" />
                                            <ComboBoxItem Content="14400" Tag="14400" />
                                            <ComboBoxItem Content="19200" Tag="19200" />
                                            <ComboBoxItem Content="38400" Tag="38400" />
                                            <ComboBoxItem Content="57600" Tag="57600" />
                                            <ComboBoxItem Content="115200" Tag="115200" />
                                            <ComboBoxItem Content="128000" Tag="128000" />
                                            <ComboBoxItem Content="230400" Tag="230400" />
                                            <ComboBoxItem Content="921600" Tag="921600" />
                                        </ComboBox>
                                        <StackPanel
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Margin="0,15,0,10"
                                            Orientation="Horizontal">
                                            <Label Name="lblParity" Content="Parity" />
                                            <Label Foreground="Red">*</Label>
                                        </StackPanel>
                                        <ComboBox
                                            Name="cmbParity"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="30,15,10,10"
                                            SelectedValue="{Binding Model.Parity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Tag">
                                            <ComboBoxItem
                                                Content="None"
                                                IsSelected="True"
                                                Tag="None" />
                                            <ComboBoxItem Content="Odd" Tag="Odd" />
                                            <ComboBoxItem Content="Even" Tag="Even" />
                                            <ComboBoxItem Content="Mark" Tag="Mark" />
                                            <ComboBoxItem Content="Space" Tag="Space" />
                                        </ComboBox>

                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="0,15,0,10"
                                                    Orientation="Horizontal">
                                            <Label Name="lblDRT"
                                                   Content="DRT" />
                                            <Label Foreground="Red">*</Label>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal">
                                            <CheckBox Name="cbDRT"
                                                      Margin="30,15,10,10"
                                                      IsChecked="{Binding Model.IsDRT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />                                           
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Margin="0,15,0,10"
                                            Orientation="Horizontal">
                                            <Label Name="lblDataBits" Content="Data Bits" />
                                            <Label Foreground="Red">*</Label>
                                        </StackPanel>
                                        <ComboBox
                                            Name="cmbDataBits"
                                            Grid.Row="0"
                                            Grid.Column="3"
                                            Margin="0,15,10,10"
                                            SelectedValue="{Binding Model.DataBits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Tag">
                                            <ComboBoxItem
                                                Content="7"
                                                IsSelected="True"
                                                Tag="7" />
                                            <ComboBoxItem Content="8" Tag="8" />
                                        </ComboBox>
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,15,0,10"
                                            Orientation="Horizontal">
                                            <Label Name="lblStopBits" Content="Stop Bits" />
                                            <Label Foreground="Red">*</Label>
                                        </StackPanel>
                                        <ComboBox
                                            Name="cmbStopBits"
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            Margin="0,15,10,10"
                                            SelectedValue="{Binding Model.StopBits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Tag">
                                            <ComboBoxItem
                                                Content="1"
                                                IsSelected="True"
                                                Tag="One" />
                                            <ComboBoxItem Content="1.5" Tag="OnePointFive" />
                                            <ComboBoxItem Content="2" Tag="Two" />
                                        </ComboBox>
                                        <StackPanel
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Margin="0,15,0,10"
                                            Orientation="Horizontal">
                                            <Label Name="lblHandShake" Content="Handshake" />
                                            <Label Foreground="Red">*</Label>
                                        </StackPanel>
                                        <ComboBox
                                            Name="cmbHandShake"
                                            Grid.Row="2"
                                            Grid.Column="3"
                                            Margin="0,15,10,10"
                                            SelectedValue="{Binding Model.HandShake, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Tag">
                                            <ComboBoxItem
                                                Content="None"
                                                IsSelected="True"
                                                Tag="None" />
                                            <ComboBoxItem Content="RequestToSend" Tag="RequestToSend" />
                                            <ComboBoxItem Content="RequestToSendXOnXOff" Tag="RequestToSendXOnXOff" />
                                            <ComboBoxItem Content="XOnXOff" Tag="XOnXOff" />
                                        </ComboBox>

                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="2"
                                                    Margin="0,15,0,10"
                                                    Orientation="Horizontal">
                                            <Label Name="lblRTS"
                                                   Content="RTS" />
                                            <Label Foreground="Red">*</Label>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="3"
                                                    Orientation="Horizontal">
                                            <CheckBox Name="cbRTS"
                                                      Margin="10,15,10,10"
                                                      IsChecked="{Binding Model.IsRTS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                    </Grid>
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Name="btnStartCom"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Height="30"
                                            Margin="0,10,10,10"
                                            Controls:ButtonHelper.PreserveTextCase="True"
                                            Command="{Binding startComReading}"
                                            Content="Start" />
                                        <!--  Click="btnStartCom_Click"  -->
                                        <Button
                                            Name="btnStopCom"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Height="30"
                                            Margin="0,10,10,10"
                                            Controls:ButtonHelper.PreserveTextCase="True"
                                            Command="{Binding stopComReading}"
                                            Content="Stop" />
                                        <!--  Click="btnStopCom_Click"  -->
                                        <!--<TextBox Name="txtRawData" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                                                 Text="{Binding Model.RawData}" Grid.Row="1" Grid.Column="0" MaxHeight="100" Height="100" Grid.ColumnSpan="2" Margin="0,0,10,0" AcceptsReturn="True" Padding="3">
                                        </TextBox>-->
                                        <usc:AVLTextEditor
                                            x:Name="txtRawData"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Height="100"
                                            MaxHeight="100"
                                            Margin="0,0,10,0"
                                            Padding="3"
                                            BorderBrush="{DynamicResource TextBoxBorderBrush}"
                                            BorderThickness="1"
                                            DocumentText="{Binding Model.RawData}"
                                            FontFamily="Consolas"
                                            FontSize="10pt"
                                            IsReadOnly="True"
                                            ScrollViewer.CanContentScroll="True"
                                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox
                            Name="gbEthernet"
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Header="Ethernet Settings"
                            Visibility="{Binding ElementName=iLAN, Path=IsSelected, Converter={StaticResource NegativeBooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="9*" />
                                    <ColumnDefinition Width="6*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,15,0,10"
                                            Orientation="Horizontal">
                                            <Label Name="lblIPAddress" Content="IP Address" />
                                            <Label Foreground="Red">*</Label>
                                        </StackPanel>
                                        <TextBox
                                            Name="txtIPAddress"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="30,15,10,10"
                                            Text="{Binding Model.IPAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,15,0,10"
                                            Orientation="Horizontal">
                                            <Label Name="lblPort" Content="Port" />
                                            <Label Foreground="Red">*</Label>
                                        </StackPanel>
                                        <csc:FilteredTextbox
                                            x:Name="txtPort"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="30,15,10,10"
                                            FilterRegex="^[0-9]+$"
                                            Text="{Binding Model.IPPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6*" />
                                            <ColumnDefinition Width="6*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Name="btnStartIP"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Height="30"
                                            Margin="0,10,10,10"
                                            Controls:ButtonHelper.PreserveTextCase="True"
                                            Command="{Binding startComReading}"
                                            Content="Start" />
                                        <Button
                                            Name="btnStopIP"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Height="30"
                                            Margin="0,10,10,10"
                                            Controls:ButtonHelper.PreserveTextCase="True"
                                            Command="{Binding stopComReading}"
                                            Content="Stop" />
                                        <TextBox
                                            Name="txtRawDataIP"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Height="100"
                                            MaxHeight="100"
                                            Margin="0,0,10,0"
                                            Padding="3"
                                            AcceptsReturn="True"
                                            ScrollViewer.CanContentScroll="True"
                                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            Text="{Binding Model.RawData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox
                            Name="gbWeightsetting"
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Margin="0,10,0,0"
                            Padding="10"
                            Header="Weight Settings"
                            Visibility="{Binding IsWeightSettingVisible, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <!--  Increased width so labels fit in 1 line  -->
                                    <ColumnDefinition Width="2.3*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <!--  === Five Digit Weight ===  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,10,10,10"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Please stand the vehicle that has 10,000+ weight on the weighbridge" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontSize="14"
                                        Foreground="Red"
                                        Text="*" />
                                </StackPanel>

                                <csc:FilteredTextbox
                                    x:Name="txtFiveDigitWeight"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,15,10,0"
                                    VerticalContentAlignment="Center"
                                    FilterRegex="^[0-9]+$"
                                    MaxLength="5"
                                    Text="{Binding FiveDigitWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


                                <!--  === Two Digit Weight ===  -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,10,10,10"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Please stand the person on the weighbridge" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontSize="14"
                                        Foreground="Red"
                                        Text="*" />
                                </StackPanel>

                                <csc:FilteredTextbox
                                    x:Name="txtTwoDigitWeight"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,15,10,0"
                                    VerticalContentAlignment="Center"
                                    FilterRegex="^[0-9]+$"
                                    MaxLength="2"
                                    Text="{Binding TwoDigitWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="Collapsed" />


                                <!--  === Right Side: Button + Display ===  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    Grid.ColumnSpan="2"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        Name="weightstart"
                                        Width="120"
                                        Height="35"
                                        Margin="0,0,20,0"
                                        Click="weightstart_Click"
                                        Content="Start Weight" />

                                    <TextBlock
                                        Width="150"
                                        VerticalAlignment="Center"
                                        FontFamily="Bahnschrift"
                                        FontSize="20"
