                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button
                    Name="WeightBridgeManagementSave"
                    Grid.Row="0"
                    Grid.Column="0"
                    Height="30"
                    Margin="45,30,0,50"
                    Controls:ButtonHelper.PreserveTextCase="True"
                    BorderBrush="{DynamicResource AccentColorBrush}"
                    Command="{Binding SaveCommand}"
                    Content="Save (Enter)"
                    IsDefault="True"
                    Style="{DynamicResource mouseoverstyle}" />
                <Button
                    Name="WeightBridgeManagementCancel"
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="30"
                    Margin="25,30,10,50"
                    Controls:ButtonHelper.PreserveTextCase="True"
                    BorderBrush="{DynamicResource AccentColorBrush}"
                    Command="{Binding CloseDetailViewCommand}"
                    Content="Cancel (Esc)"
                    IsCancel="True"
                    Style="{DynamicResource mouseoverstyle}" />
            </Grid>
        </DockPanel>
    </Grid>
</Page>
