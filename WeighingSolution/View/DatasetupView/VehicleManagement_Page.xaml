<Page x:Class="WeighingSolution.View.VehicleManagement_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:strFormat="clr-namespace:WeighingSolution.DataLayer;assembly=WeighingSolution.DataLayer"
      xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="600" d:DesignWidth="800"
	Title="VehicleManagement_Page"
      FocusManager.FocusedElement="{Binding ElementName=txtVehicleNo}">

    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100">
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource VehicleIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="Vehicle" />
                         Management</TextBlock>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,15,0,10" Orientation="Horizontal">
                            <Label >Vehicle No</Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <TextBox Name="txtVehicleNo" CharacterCasing="Upper" 
                                 Grid.Row="0" Grid.Column="1"  Margin="0,15,0,10" Padding="5,5,5,5"
                                 Text="{Binding Model.VehicleNumber,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                 LostFocus="txtVehicleNo_LostFocus" KeyDown="txtVehicleNo_KeyDown" />
                        <Label Grid.Row="1" Margin="0,15,0,10">Vehicle Type</Label>
                        <TextBox Name="txtVehicleType" Grid.Row="1" Grid.Column="1" Margin="0,15,0,10" Padding="5,5,5,5" Text="{Binding Model.VehicleType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Grid.Row="2" Margin="0,15,0,10">Account</Label>
                        <ComboBox Name="cmbAccountDetail" Grid.Row="2" Margin="0,15,0,10" Grid.Column="1" Padding="5,5,5,5" ItemsSource="{Binding Accounts}" DisplayMemberPath="CompanyName" SelectedValuePath="AccountID">
                            <ComboBox.SelectedValue>
                                <Binding Path="Model.AccountID" Converter="{StaticResource NullReplaceConverter}">
                                    <Binding.ConverterParameter>
                                        <sys:Int32>0</sys:Int32>
                                    </Binding.ConverterParameter>
                                </Binding>
                            </ComboBox.SelectedValue>
                        </ComboBox>
                        <Label Grid.Row="3" Margin="0,15,0,10">Tare Weight</Label>
                        <csc:FilteredTextbox x:Name="txtTareWeight" FilterRegex="^[0-9]+$|^[0-9]*[.]{0,1}[0-9]*$" Grid.Row="3" Margin="0,15,0,10" Grid.Column="1" Padding="5,5,5,5" Text="{Binding Model.TareWeight, StringFormat={x:Static strFormat:Constant.DecimalFormat}, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
                        <Label Grid.Row="4" Margin="0,15,0,10">Notes</Label>
                        <TextBox Grid.Row="4" Margin="0,15,0,10"  Grid.Column="1" Padding="5,5,5,5" AcceptsReturn="True" Text="{Binding Model.Notes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
        <DockPanel>
            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Save (Enter)" Controls:ButtonHelper.PreserveTextCase="True" Name="VehicleSave" IsDefault="True" Grid.Row="0" Grid.Column="0"    Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="45,30,0,50" Command="{Binding SaveCommand}"></Button>
                <Button Content="Cancel (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="VehicleManagementCancel"  Grid.Row="0" Grid.Column="1" Height="30"     Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Margin="25,30,10,50" Command="{Binding CloseDetailViewCommand}"></Button>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
