<Page x:Class="WeighingSolution.View.CameraManagementList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      xmlns:userControls="clr-namespace:WeighingSolution.UserControls"
      mc:Ignorable="d" Style="{DynamicResource MetroPage}" d:DesignHeight="300" d:DesignWidth="300" Title="CameraManagementList">
    <!--<Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Dictionary1.xaml"/>
                <shared:DesignTimeResourceDictionary DesignTimeSource="pack://application:,,,/WeighingSolution.SharedComponents;component/Styles/MetroStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converter:MultiBindingConverter x:Key="MultiBindingConverter" />
            <converter:BoolVisibilityConverter x:Key="PositiveBooleanToVisibilityConverter" True="Collapsed" False="Visible" />
            <converter:BoolVisibilityConverter x:Key="NegativeBooleanToVisibilityConverter" True="Visible" False="Collapsed" />
        </ResourceDictionary>
    </Page.Resources>-->
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100" >
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0" VerticalAlignment="Center">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource CustomIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25" VerticalAlignment="Center">
                          <Run FontWeight="Bold"  FontSize="25" Text="Camera" />
                         Management</TextBlock>
                    <StackPanel Orientation="Horizontal"  HorizontalAlignment="Right" Margin="0,8,20,5">
                        <TextBox  Name="txtsearch" Width="300" Margin="0,0,0,0"  BorderBrush="{DynamicResource AccentColorBrush}" Padding="5,5,5,5" ToolTip="Search" Text="{Binding SearchString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MetroTextBox}" >
                                    <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="True"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="Controls:TextBoxHelper.HasText" Value="false" >
                                            <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="False" />
                                            <Setter Property="Controls:TextBoxHelper.Watermark"  Value="Search Record" />
                                        </Trigger>
                                        <Trigger Property="Controls:TextBoxHelper.HasText"   Value="True">
                                            <Setter Property="Controls:TextBoxHelper.ClearTextButton" Value="True" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Name="btnSearch" IsDefault="True" HorizontalAlignment="Left" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="34" Width="34"  Margin="0,0,20,0" Command="{Binding FilterData}" >
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="search" Margin="0,2,0,0"  Height="14" Width="14" />
                            </StackPanel>
                        </Button>
                        <!--<TextBlock Name="txtbAddCamera" Margin="0,8,20,5" FontWeight="Bold" HorizontalAlignment="Right" >
                            <Hyperlink TextDecorations="none" Foreground="{DynamicResource AccentColorBrush}" Click="Hyperlink_Click" >+Add Camera</Hyperlink>
                        </TextBlock>-->
                        <TextBlock Name="txtbAddCamera"  Margin="0,0,20,0" FontWeight="Bold" HorizontalAlignment="Right" >
                            <Button Name="btnAddMaster" Click="Hyperlink_Click" Controls:ButtonHelper.PreserveTextCase="True" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Padding="20,0,20,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="PlusCircle"  Margin="0,1,2,0"  Height="14" Width="14" />
                                    <TextBlock>ADD CAMERA</TextBlock>
                                </StackPanel>
                            </Button>
                            <!--<Hyperlink TextDecorations="none" Foreground="{DynamicResource AccentColorBrush}" NavigateUri="/View/DatasetupView/AccountManagement_Page.xaml">+Add Account</Hyperlink>-->
                        </TextBlock>
                        <Button Name="btNCameraSetting" HorizontalAlignment="Left" BorderBrush="{DynamicResource AccentColorBrush}" Height="34" Width="34"  Margin="0,0,20,0" Click="btNCameraSetting_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType='Button'>
                                                <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" ToolTip="Click on Camera setting" Margin="0,0,0,0">
                                                    <Rectangle.OpacityMask>
                                                        <VisualBrush Stretch="Uniform" Visual="{StaticResource SettingsIcon}" />
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto"   VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0" Orientation="Vertical">
                    <DataGrid Name="DatagridCameraManagement" AutoGenerateColumns="False" ItemsSource="{Binding ViewList.View}"  Margin="0,4,0,0" HorizontalAlignment="Center" CanUserAddRows="False" ScrollViewer.CanContentScroll="True" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" PreviewKeyDown="DatagridCameraManagement_PreviewKeyDown">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Background" Value="{StaticResource AccentColorBrush}"/>
                                <Setter Property="Height" Value="35"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
                                <Setter Property="BorderThickness" Value="0,2,0,2"/>
                                <Setter Property="Margin" Value="0,0,0,0"></Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns >
                            <DataGridTextColumn>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Padding" Value="6,6,6,6"></Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Camera Name"  Width="*"   IsReadOnly="True" Binding="{Binding Path=CameraName}"  />
                            <DataGridTextColumn Header="CameraType"  Width="*"  IsReadOnly="True" Binding="{Binding Path=CameraType}" />
                            <DataGridTextColumn Header="Scale"  Width="*" IsReadOnly="True" Binding="{Binding Path=WeightBridge.ScaleName}" />
                            <DataGridTemplateColumn Header="Active/Deactive" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                                            <Setter Property="Text" Value="Active" />
                                                            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Active}" Value="False">
                                                            <Setter Property="Text" Value="Deactive" />
                                                            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="*" >
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock   VerticalAlignment="Center" ToolTip="Edit"  >
                                            <Hyperlink Name="HyperLinkEditCameraManagement"  TextDecorations="none"  FontWeight="Bold"
                                                        Command="{Binding DataContext.EditObject, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                                                      <Rectangle.OpacityMask>
                                                           <VisualBrush Stretch="Uniform" Visual="{StaticResource EditLinkIcon}" />
                                                      </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <Hyperlink.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                                                         <Binding Path="CameraID" />
                                                         <Binding Source="CameraManagement"/>
                                                    </MultiBinding>
                                                </Hyperlink.CommandParameter>
                                            </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Margin="5,0,5,0" VerticalAlignment="Center">
                                            <Hyperlink Name="Cameralink" CommandParameter="{Binding}" TextDecorations="none"
                                                Command="{Binding DataContext.ActiveDeActiveCameraCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}">
                                                <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" ToolTip="Active" Margin="0,0,0,0" Visibility="{Binding Active,Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                                                    <Rectangle.OpacityMask>
                                                        <VisualBrush Stretch="Uniform" Visual="{StaticResource ThumbUpIcon}" />
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <Rectangle Width="20" Height="20" Fill="{DynamicResource BlackBrush}" ToolTip="Deactive" Margin="0,0,0,0" Visibility="{Binding Active,Converter={StaticResource NegativeBooleanToVisibilityConverter}}">
                                                    <Rectangle.OpacityMask>
                                                        <VisualBrush Stretch="Uniform" Visual="{StaticResource ThumbDownIcon}" />
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                            </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Delete" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" ToolTip="Delete"  >
                                            <Hyperlink  CommandParameter="{Binding}" Name="HyperLinkDeleteCameraManagement" TextDecorations="none" Foreground="Black" FontWeight="Bold"
                                                        Command="{Binding DataContext.DeleteCameraCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" >
                                                  <Image Height="20" Width="20" Source="/Images/close.png"></Image>
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" Visibility="{Binding HasData,Converter={StaticResource PositiveBooleanToVisibilityConverter}}">
                        <TextBlock Name="txtmsg" FontSize="20" Opacity="0.5" Margin="5,5,5,5" >No Record Exist</TextBlock>
                    </StackPanel>
                    <userControls:PaginationElements x:Name="ucPager" Visibility="{Binding HasData,Converter={StaticResource NegativeBooleanToVisibilityConverter}}" />
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
        <DockPanel>
            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Go To Data Setup (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="CameraManagementListCancel" Grid.Row="0" Grid.Column="0" Height="30" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Margin="45,30,10,50" Click="CameraManagementListCancel_Click"  ></Button>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
