<Page x:Class="WeighingSolution.View.ProductManagement_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="600" d:DesignWidth="800"
	Title="ProductManagement_Pagexaml"
       FocusManager.FocusedElement="{Binding ElementName=txtProductName}">

    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100" >
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource ProductIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="Product" />
                         Management</TextBlock>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"   />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto"   VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,15,0,10" Orientation="Horizontal">
                            <Label >Product Name</Label>
                            <Label Foreground="Red">*</Label>
                        </StackPanel>
                        <TextBox Name ="txtProductName"  Grid.Row="0" Grid.Column="1" Margin="0,15,0,10" Text="{Binding Model.ProductName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Grid.Row="1" Margin="0,15,0,10">Product Code</Label>
                        <TextBox Name="txtProductCode" Grid.Row="1" Grid.Column="1"   Margin="0,15,0,10" Text="{Binding Model.ProductCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  />
                        <Label Grid.Row="2" Margin="0,15,0,10">Notes</Label>
                        <TextBox Name="txtProductNotes" Grid.Row="2" Margin="0,15,0,10" AcceptsReturn="True" Grid.Column="1" Padding="5,8,5,20" Text="{Binding Model.Notes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" >
                        </TextBox>
                    </Grid>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
        <DockPanel>
            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Save (Enter)" Controls:ButtonHelper.PreserveTextCase="True" IsDefault="True" Name="ProductManagementSave" Grid.Row="0" Grid.Column="0" Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="45,30,0,50" Command="{Binding SaveCommand}"></Button>
                <Button Content="Cancel (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="ProductManagementCancel" Grid.Row="0" Grid.Column="1" Height="30"     Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Margin="25,30,10,50"  Command="{Binding CloseDetailViewCommand}"></Button>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
