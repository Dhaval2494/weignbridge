<Page x:Class="WeighingSolution.View.DriverManagement_Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      mc:Ignorable="d" 
      Style="{DynamicResource MetroPage}"
      d:DesignHeight="600" d:DesignWidth="800"
	    Title="DriverManagement_Page"
      FocusManager.FocusedElement="{Binding ElementName=txtFirstName}">
    <Page.Resources>
        <converter:CustomImagePathConverter x:Key="CustomImagePathConverter" />
        <BitmapImage x:Key="DefaultImage" UriSource="/Images/default-image.png" />
    </Page.Resources>
    <Grid Background="{DynamicResource WhiteBrush}">
        <DockPanel Margin="0,0,0,100">
            <StackPanel VerticalAlignment="Top" DockPanel.Dock="Top" HorizontalAlignment="Stretch">
                <DockPanel Margin="10,0,0,0">
                    <Rectangle Width="25" Height="25" Fill="{DynamicResource BlackBrush}" Margin="0,3,5,0">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{StaticResource DriverIcon}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock FontSize="25">
                          <Run FontWeight="Bold"  FontSize="25" Text="Driver" />
                         Management</TextBlock>
                </DockPanel>
                <Border BorderThickness="0" HorizontalAlignment="Stretch" Height="4" Margin="0,4,1,0" VerticalAlignment="Top" Background="{DynamicResource AccentColorBrush}"  />
            </StackPanel>
            <csc:ScrollViewerEx VerticalScrollBarVisibility="Auto"   VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="9*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="1" >
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,15,0,10" Orientation="Horizontal">
                                    <Label >First Name</Label>
                                    <Label Foreground="Red">*</Label>
                                </StackPanel>
                                <TextBox Name="txtFirstName" Text="{Binding Model.FirstName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  Grid.Row="0" Grid.Column="1" Margin="0,15,0,10" Padding="5,5,5,5" />
                                <Label Grid.Row="1" Margin="0,15,0,10">Last Name</Label>
                                <TextBox Name="txtLastName" Text="{Binding Model.LastName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"   Margin="0,15,0,10" Padding="5,5,5,5" />
                                <Label Grid.Row="2" Margin="0,15,0,10">Account</Label>
                                <ComboBox Name="cmbAccount" Grid.Row="2" Margin="0,15,0,10" Grid.Column="1" Padding="5,8,5,8" ItemsSource="{Binding Accounts}" DisplayMemberPath="CompanyName" SelectedValuePath="AccountID">
                                    <ComboBox.SelectedValue>
                                        <Binding Path="Model.AccountID" Converter="{StaticResource NullReplaceConverter}">
                                            <Binding.ConverterParameter>
                                                <sys:Int32>0</sys:Int32>
                                            </Binding.ConverterParameter>
                                        </Binding>
                                    </ComboBox.SelectedValue>
                                </ComboBox>
                                <!--SelectedValue="{Binding Model.AccountID, Converter={StaticResource NullReplaceConverter}, ConverterParameter=0}"-->
                                <Label Grid.Row="3" Margin="0,15,0,10">IDProof Type</Label>
                                <TextBox Name="txtIDProofType" Grid.Row="3" Margin="0,15,0,10" Grid.Column="1" Padding="5,5,5,5" Text="{Binding Model.IDProofType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                                <!--<Label Grid.Row="4" Margin="0,15,0,10">ID Proof</Label>
                               <TextBox Grid.Row="4" Margin="0,15,0,10" Grid.Column="1" Padding="5,5,5,5" />-->
                                <Label Grid.Row="4" Margin="0,15,0,10">IDProof No</Label>
                                <TextBox Name="txtIDProofNo" Grid.Row="4" Margin="0,15,0,10" Grid.Column="1" Padding="5,5,5,5" Text="{Binding Model.IDProofNo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                <!--<Label Grid.Row="5" Margin="0,15,0,10">IDProof Copy</Label>
                                <CheckBox  Name="cbIDProofCopy" Grid.Row="5" Margin="0,22,0,10" Grid.Column="1" Padding="5,5,5,5" />-->
                                <Label Grid.Row="5" Margin="0,15,0,10">Notes</Label>
                                <TextBox Name="txtNotes" Grid.Row="5" Margin="0,22,0,10" Grid.Column="1" Padding="5,5,5,5" Text="{Binding Model.Notes,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="0"  HorizontalAlignment="Center">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image Name="imgUploadImage" Grid.Row="0" VerticalAlignment="Center" Source="{Binding Model.Photo,Converter={StaticResource CustomImagePathConverter}, TargetNullValue={StaticResource DefaultImage}}" Width="150"></Image>
                                <Button Name="btnUploadImage" Grid.Row="1" Controls:ButtonHelper.PreserveTextCase="True"  Content="Upload Image"     Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="0,15,0,0" 
                                        Command="{Binding SelectFile}" CommandParameter="{Binding Source='Photo'}"></Button>

                                <Image Name="imgUploadIDProof" Grid.Row="2" Margin="0,15,0,0" VerticalAlignment="Center" Source="{Binding Model.IDProofScan, Converter={StaticResource CustomImagePathConverter}, TargetNullValue={StaticResource DefaultImage}}" Width="150"></Image>
                                <Button Name="btnIDProofScan" Grid.Row="3" Controls:ButtonHelper.PreserveTextCase="True"  Content="Upload IDProof"     Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="0,15,0,0" 
                                        Command="{Binding SelectFile}" CommandParameter="{Binding Source='IDProofScan'}"></Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </csc:ScrollViewerEx>
        </DockPanel>
        <DockPanel>
            <Grid VerticalAlignment="Bottom"  DockPanel.Dock="Bottom" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Content="Save (Enter)" Controls:ButtonHelper.PreserveTextCase="True" IsDefault="True" Name="DriverManagementSave" Grid.Row="0" Grid.Column="0"     Style="{DynamicResource  mouseoverstyle}"   BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="45,30,0,50" Command="{Binding SaveCommand}"></Button>
                <Button Content="Cancel (Esc)" Controls:ButtonHelper.PreserveTextCase="True" IsCancel="True" Name="DriverManagementCancel" Grid.Row="0" Grid.Column="1" Height="30"      Style="{DynamicResource  mouseoverstyle}"  BorderBrush="{DynamicResource AccentColorBrush}" Margin="25,30,10,50" Command="{Binding CloseDetailViewCommand}"></Button>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
