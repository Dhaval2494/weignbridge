<Controls:MetroWindow  x:Class="WeighingSolution.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:converter="clr-namespace:WeighingSolution.Converters;assembly=WeighingSolution.SharedComponents"
        xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
        MinHeight="400" MinWidth="540"  Icon="/Images/logo.png" ShowIconOnTitleBar="False"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ResizeMode="NoResize"
        Title="Login - Weighing Solutions" Height="300" Width="300"  WindowStyle="SingleBorderWindow"  
        GlowBrush="Black" SizeToContent="Manual">
    <Control.Resources>
        <converter:CompanysettingImageConverter x:Key="CompanysettingImageConverter" />
        <BitmapImage x:Key="DefaultImage" UriSource="/Images/logo.png" />
    </Control.Resources>
    <Grid Background="{DynamicResource WhiteBrush}">
        <!--<Grid.Background>
            <ImageBrush ImageSource="/Images/loginbackground.png"/>
        </Grid.Background>-->
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="0.4*"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0">
            <Image Name="imgLogo" HorizontalAlignment="Center" Margin="0,20,0,0" VerticalAlignment="Top" Width="300" Source="{Binding LoginLogo,Converter={StaticResource CompanysettingImageConverter},FallbackValue={StaticResource DefaultImage}}"  />
        </StackPanel>
        <StackPanel Grid.Row="1" FocusManager.FocusedElement="{Binding ElementName=txtUserName}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"></RowDefinition>
                    <RowDefinition Height="3*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Margin="10,15,0,10">User Name</Label>
                <TextBox Name="txtUserName" Grid.Row="0" Grid.Column="1" Margin="0,15,10,10" Padding="5,5,5,5" Text="{Binding LoginUserName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                <Label Name="lblPassword" Grid.Row="1"  Grid.Column="0" Margin="10,15,0,10" Content="Password"></Label>
                <!--<PasswordBox  Name="txtPassword" Background="White" PasswordChar="*" Grid.Row="1" Grid.Column="2" Margin="0,15,10,10" Padding="5,5,5,5" />-->
                <PasswordBox csc:PasswordHelper.Attach="True" Grid.Row="1" Grid.Column="2" Margin="0,15,10,10" Padding="5,5,5,5" csc:PasswordHelper.Password="{Binding LoginPassWord,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Button Content="Login (Enter)" Name="btnLogin" IsDefault="True"  Controls:ButtonHelper.PreserveTextCase="True" Grid.Row="0"  Grid.Column="0" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="10,20,10,50"  Command="{Binding LoginCommand}"></Button>
                <Button Content="Cancel (Esc)" Name="btnCancel" IsCancel="True"  Controls:ButtonHelper.PreserveTextCase="True" Grid.Row="0"  Grid.Column="1" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="0,20,10,50" Click="btnCancel_Click"></Button>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock>Version:</TextBlock>
                    <TextBlock Name="txtAssemblyVersion"></TextBlock>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
