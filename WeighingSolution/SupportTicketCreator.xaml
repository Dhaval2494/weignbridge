<simpleChildWindow:ChildWindow 
      x:Class="WeighingSolution.SupportTicketCreator"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:csc="clr-namespace:WeighingSolution.CustomControls;assembly=WeighingSolution.SharedComponents"
      xmlns:simpleChildWindow="clr-namespace:MahApps.Metro.SimpleChildWindow;assembly=MahApps.Metro.SimpleChildWindow"
      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      CloseByEscape="True"  AllowMove="True" BorderBrush="{DynamicResource AccentBaseColorBrush}" BorderThickness="1" GlowBrush="{DynamicResource AccentColorBrush}"
      ShowCloseButton="True" HorizontalContentAlignment="Center" IsModal="True" VerticalContentAlignment="Center" EnableDropShadow="False"	Title="Create support ticket"
      mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Background="{DynamicResource WhiteBrush}" >
            <StackPanel Name="stkSetting" Margin="5">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="5*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10" Grid.Row="0" Grid.Column="0" Width="100">
                        <Label >Ticket Subject</Label>
                        <Label Foreground="red">*</Label>
                    </StackPanel>
                    <TextBox Name="txtEmailSubject" MaxLength="250" Text="{Binding TicketSubject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="350" Grid.Row="0" Grid.Column="1" Margin="0,10,10,10" Padding="2"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,10" Grid.Row="1" Grid.Column="0" Width="100">
                        <Label >Ticket Body</Label>
                        <Label Foreground="red">*</Label>
                    </StackPanel>
                    <TextBox Name="txtEmailBody" Text="{Binding TicketBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                             Height="150" Width="350" Grid.Row="1" Grid.Column="1" Margin="0,10,10,10" Padding="2"/>
                    <Label Margin="0,10,0,10" Grid.Row="2" Grid.Column="0" Width="100">Attachment</Label>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical">
                        <Button Name="btnUpload" Click="BtnUpload_Click" Width="200" Controls:ButtonHelper.PreserveTextCase="True" Content="Upload attachment" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Height="30" Margin="0,15,0,0"></Button>
                        <TextBlock TextWrapping="Wrap" Name="lblSelectedFiles" IsEnabled="False" MaxWidth="350" ></TextBlock>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{StaticResource AccentColorBrush}" HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,20,0,20">
                    <Button Name="btnSendTicket" Margin="15,0,0,0" Controls:ButtonHelper.PreserveTextCase="True" Style="{DynamicResource mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" Command="{Binding SendTicket}">Create Ticket</Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</simpleChildWindow:ChildWindow>
