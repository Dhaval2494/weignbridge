<Controls:MetroContentControl x:Class="InstallerUI.View.InstallWelcomeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="650">
    <Controls:MetroContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/FlatButton.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/Blue.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/BaseLight.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AccentedSquareButtonStyle}" x:Key="mouseoverstyle">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentColorBrush4}"></Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Controls:MetroContentControl.Resources>
    <DockPanel Background="{DynamicResource WhiteBrush}">
        <StackPanel HorizontalAlignment="Stretch">
            <Border Canvas.ZIndex="2" DockPanel.Dock="Top" Background="{DynamicResource AccentColorBrush4}" CornerRadius="5" Margin="20,10,20,10" Padding="10">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#20a0db" >Welcome !</TextBlock>
                    <TextBlock FontWeight="Medium" Margin="0,2,0,0">This setup program will install the Weighing Solutions Core Program.</TextBlock>
                    <TextBlock FontWeight="Medium" Margin="0,2,0,0">Your complete Weighbridge Management System.</TextBlock>
                </StackPanel>
            </Border>
            <StackPanel Margin="25,0,0,0">
                <StackPanel Canvas.ZIndex="3" Margin="0,20,0,0">

                    <GroupBox Header="System Prerequisites" Margin="0,10,20,10" Padding="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <CheckBox  IsChecked="{Binding IsDotNet48Installed}" Content=".NET Framework 4.8 Installed" Foreground="{Binding DotNet48Color}" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <CheckBox IsChecked="{Binding IsDotNet35Enabled}"  Content=".NET 3.5 Enabled (for SQL Server)" Foreground="{Binding DotNet35Color}" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <CheckBox IsChecked="{Binding IsFirewallEnabled}"  Content="Windows Firewall Enabled" Foreground="{Binding FirewallColor}" IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <CheckBox IsChecked="{Binding IsWindowsVersionSupported}"  Content="Windows Version ≥ 10" Foreground="{Binding WindowsVersionColor}" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CheckMessage}" Margin="0,10,0,0" FontWeight="Bold" />
                        </StackPanel>
                    </GroupBox>


                    <CheckBox IsChecked="{Binding InstallSQL, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">Install SQL Server</CheckBox>
                    <TextBlock Margin="0,5,0,0">By clicking "Install" you agree to our terms and conditions.</TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Controls:ButtonHelper.PreserveTextCase="True" Command="{Binding InstallCommand}" Content="Install" HorizontalAlignment="Left"  Width="100" Height="30" Margin="0,20,0,0" Style="{DynamicResource  mouseoverstyle}" BorderBrush="{DynamicResource AccentColorBrush}" IsEnabled="{Binding AllChecksPassed}" ></Button>
                        <Button Controls:ButtonHelper.PreserveTextCase="True" Command="{Binding CancelCommand}" Content="Cancel" HorizontalAlignment="Left"  Width="100" Height="30" Margin="10,20,0,0" Style="{DynamicResource  mouseoverstyle}" Foreground="Black" Background="{DynamicResource AccentColorBrush4}" BorderBrush="{DynamicResource AccentColorBrush4}" ></Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Height="340" Width="470" Margin="0,-97,0,0" HorizontalAlignment="Right">
                    <!--<MediaElement Height="340" HorizontalAlignment="Left" Margin="0,0,0,0" LoadedBehavior="Play"
                                    Name="mediaElement1" VerticalAlignment="Top" Width="470" Source="/InstallerUI;component/Images/loading2.gif"/>-->
                    <Image Source="/InstallerUI;component/Images/loading2.jpg" Height="340" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" Width="470" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Controls:MetroContentControl>