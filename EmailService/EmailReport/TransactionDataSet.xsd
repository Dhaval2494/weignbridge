                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT TData.ReceiptTicketID, TData.TicketID, Acc.CompanyName AS AccountName, P.ProductName, V.VehicleNumber, TDetail.GrossTime, TDetail.GrossWeight, TDetail.TareTime, TDetail.TareWeight, TDetail.NetWeight, IsGrossManual, IsTareManual,TData.Charges ,TData.TransactionType,TDetail.WeightUnit,WB.ScaleName
FROM TransactionData AS TData
INNER JOIN TransactionDetail AS TDetail ON TData.ReceiptTicketID = TDetail.ReceiptTicketID AND TDetail.GrossWeight IS NOT NULL AND TDetail.TareWeight IS NOT NULL
INNER JOIN WeightBridge WB ON WB.WeightBridgeID = TDetail .WeightBridgeID
LEFT OUTER JOIN Account AS Acc ON Acc.AccountID = TData.AccountID
LEFT OUTER JOIN Account AS Tra ON Tra.AccountID = TData.TransporterID
LEFT OUTER JOIN Product AS P ON P.ProductID = TDetail.ProductID
LEFT OUTER JOIN Driver AS D ON D.DriverID = TData.DriverID
LEFT OUTER JOIN Vehicle AS V ON V.VehicleID = TData.VehicleID
ORDER BY TData.TicketID</CommandText>
